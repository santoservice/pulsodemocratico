---
import { ordenarBarras, posPct, r2, type BarDatum } from '../../lib/charts';
import { decimal, pct } from '../../lib/format';

/**
 * Barras horizontales ordenadas de mayor a menor (ranking). Etiqueta arriba a la izquierda,
 * valor a la derecha y barra debajo: así cabe en 320 px sin cortar etiquetas largas.
 * Cada barra es un SVG decorativo; la información accesible va en la tabla `sr-only`.
 */
export interface Props {
  datos: readonly BarDatum[];
  /** pct → "27 %", media → "4,9". */
  stat?: 'pct' | 'media';
  /** Máximo de la escala (100 para porcentajes). */
  max?: number;
  /** Título accesible de la gráfica (caption de la tabla). */
  titulo: string;
  /** Resalta solo la primera barra (por defecto) o ninguna. */
  resaltarPrimera?: boolean;
  class?: string;
}

const {
  datos,
  stat = 'pct',
  max = 100,
  titulo,
  resaltarPrimera = true,
  class: className,
} = Astro.props;
const filas = ordenarBarras(datos);
const fmt = (v: number) => (stat === 'pct' ? pct(v) : decimal(v));
---

<figure class:list={['w-full', className]}>
  <ol class="flex flex-col gap-3" aria-hidden="true">
    {filas.map((d, k) => {
      const w = r2(posPct(d.valor, 0, max));
      const top = resaltarPrimera && k === 0;
      return (
        <li>
          <div class="flex items-baseline justify-between gap-3 text-sm leading-snug">
            <span class:list={[top ? 'font-semibold text-ink' : 'text-ink-muted']}>{d.label}</span>
            <span class="shrink-0 font-semibold text-ink tabular-nums">{fmt(d.valor)}</span>
          </div>
          <svg viewBox="0 0 100 10" preserveAspectRatio="none" class="mt-1 block h-2.5 w-full">
            <rect x="0" y="0" width="100" height="10" class="fill-chart-track" />
            <rect
              x="0"
              y="0"
              width={w}
              height="10"
              class={top ? 'fill-chart-accent' : 'fill-chart-muted'}
            />
          </svg>
        </li>
      );
    })}
  </ol>
  <div class="sr-only">
    <table>
      <caption>{titulo}</caption>
      <thead>
        <tr>
          <th scope="col">Opción</th>
          <th scope="col">{stat === 'pct' ? 'Porcentaje de personas encuestadas' : 'Promedio'}</th>
        </tr>
      </thead>
      <tbody>
        {filas.map((d) => (
          <tr>
            <th scope="row">{d.label}</th>
            <td>{fmt(d.valor)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
