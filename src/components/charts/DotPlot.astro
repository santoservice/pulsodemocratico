---
import { dominioAjustado, indiceExtremo, posPct, r2 } from '../../lib/charts';
import { decimal, entero, pct } from '../../lib/format';

/**
 * Grupos sociodemográficos de un cruce: una fila por grupo con su punto (y su intervalo,
 * opcional) sobre un eje común. Se resalta el grupo que más se diferencia (o el indicado).
 * Los grupos con n < 
Min` no se dibujan (regla PLAN.md §5.1).
 */
export interface GrupoDot {
  label: string;
  valor: number;
  ic?: number;
  n: number;
}

export interface Props {
  grupos: readonly GrupoDot[];
  /** Escala del indicador (para recortar el dominio). */
  lo: number;
  hi: number;
  stat: 'pct' | 'media';
  titulo: string;
  /** Índice del grupo a resaltar (en `grupos`). Por defecto, el más extremo. */
  resaltar?: number;
  nMin?: number;
  /** Dibuja el intervalo de cada grupo como una línea suave. */
  conIc?: boolean;
  class?: string;
}

const {
  grupos,
  lo,
  hi,
  stat,
  titulo,
  resaltar,
  nMin = 30,
  conIc = true,
  class: className,
} = Astro.props;

const visibles = grupos.map((g, k) => ({ ...g, k })).filter((g) => g.n >= nMin);
const destacado = resaltar ?? visibles[indiceExtremo(visibles.map((g) => g.valor))]?.k ?? -1;
const [d0, d1] = dominioAjustado(
  visibles.map((g) => ({ valor: g.valor, ic: conIc ? g.ic : 0 })),
  lo,
  hi,
);
const fmt = (v: number) => (stat === 'pct' ? pct(v) : decimal(v));
---

<figure class:list={['w-full', className]}>
  <ol class="flex flex-col gap-2.5" aria-hidden="true">
    {visibles.map((g) => {
      const on = g.k === destacado;
      const x = r2(posPct(g.valor, d0, d1));
      const x0 = r2(posPct(g.valor - (g.ic ?? 0), d0, d1));
      const x1 = r2(posPct(g.valor + (g.ic ?? 0), d0, d1));
      return (
        <li class="grid grid-cols-[6.5rem_1fr_3.25rem] items-center gap-2 sm:grid-cols-[9rem_1fr_3.5rem] sm:gap-3">
          <span
            class:list={[
              'text-xs leading-tight sm:text-sm',
              on ? 'font-bold text-ink' : 'text-ink-muted',
            ]}
          >
            {g.label}
          </span>
          <span class="relative block h-6">
            <svg
              viewBox="0 0 100 24"
              preserveAspectRatio="none"
              class="absolute inset-0 block h-full w-full"
            >
              <line
                x1="0"
                x2="100"
                y1="12"
                y2="12"
                class="stroke-chart-track"
                stroke-width="2"
                vector-effect="non-scaling-stroke"
              />
              {conIc && g.ic ? (
                <line
                  x1={x0}
                  x2={x1}
                  y1="12"
                  y2="12"
                  class={on ? 'stroke-chart-accent-soft' : 'stroke-chart-track'}
                  stroke-width="6"
                  stroke-linecap="round"
                  vector-effect="non-scaling-stroke"
                />
              ) : null}
            </svg>
            <span
              class:list={[
                'absolute top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-surface',
                on ? 'h-4 w-4 bg-chart-accent' : 'h-3 w-3 bg-chart-muted',
              ]}
              style={`left:${x}%`}
            />
          </span>
          <span
            class:list={[
              'text-right text-sm tabular-nums',
              on ? 'font-bold text-chart-accent' : 'font-medium text-ink',
            ]}
          >
            {fmt(g.valor)}
          </span>
        </li>
      );
    })}
  </ol>
  <div
    class="mt-1 ml-[calc(6.5rem+0.5rem)] mr-[calc(3.25rem+0.5rem)] flex justify-between text-[0.7rem] text-ink-muted tabular-nums sm:ml-[calc(9rem+0.75rem)] sm:mr-[calc(3.5rem+0.75rem)]"
    aria-hidden="true"
  >
    <span>{fmt(d0)}</span>
    <span>{fmt(d1)}</span>
  </div>
  <div class="sr-only">
    <table>
      <caption>{titulo}</caption>
      <thead>
        <tr>
          <th scope="col">Grupo</th>
          <th scope="col">{stat === 'pct' ? 'Porcentaje' : 'Promedio'}</th>
          <th scope="col">Personas</th>
        </tr>
      </thead>
      <tbody>
        {visibles.map((g) => (
          <tr>
            <th scope="row">{g.label}</th>
            <td>{fmt(g.valor)}</td>
            <td>{entero(g.n)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
