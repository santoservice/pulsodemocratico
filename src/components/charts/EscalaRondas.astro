---
import { posPct, r2 } from '../../lib/charts';
import { decimal, entero } from '../../lib/format';
import type { PuntoSerie } from '../../lib/tablero';

/**
 * Escala esc_lo–esc_hi con un punto por ronda: las anteriores huecas y la última llena,
 * unidas por un tramo que muestra hacia dónde se movió. Leyenda con el valor de cada ronda.
 */
export interface Props {
  serie: readonly PuntoSerie[];
  lo: number;
  hi: number;
  polos?: readonly [string, string];
  titulo: string;
}

const { serie, lo, hi, polos, titulo } = Astro.props;
const puntos = serie.map((p) => ({ ...p, x: r2(posPct(p.valor, lo, hi)) }));
const primero = puntos[0]!;
const ultimo = puntos[puntos.length - 1]!;
const desde = Math.min(primero.x, ultimo.x);
const hasta = Math.max(primero.x, ultimo.x);
---

<figure class="w-full">
  <div class="relative h-6" aria-hidden="true">
    <span class="absolute inset-x-0 top-1/2 h-2.5 -translate-y-1/2 rounded-full bg-chart-track"></span>
    <span
      class="absolute top-1/2 h-1 -translate-y-1/2 bg-chart-accent"
      style={`left:${desde}%;width:${r2(hasta - desde)}%`}
    ></span>
    {
      puntos.map((p, k) => (
        <span
          class:list={[
            'absolute top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border-2',
            k === puntos.length - 1
              ? 'h-5 w-5 border-surface bg-chart-accent shadow-[0_0_0_1px_var(--color-chart-accent)]'
              : 'h-3.5 w-3.5 border-chart-muted bg-surface',
          ]}
          style={`left:${p.x}%`}
        />
      ))
    }
  </div>
  <div class="mt-2 flex justify-between gap-4 text-xs leading-snug text-ink-muted" aria-hidden="true">
    <span><span class="font-semibold text-ink">{entero(lo)}</span>{polos && <> · {polos[0]}</>}</span>
    <span class="text-right">{polos && <>{polos[1]} · </>}<span class="font-semibold text-ink">{entero(hi)}</span></span>
  </div>
  <figcaption class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-muted">
    <span class="sr-only">{titulo}:</span>
    {
      puntos.map((p, k) => (
        <span class="inline-flex items-center gap-1.5">
          <span
            class:list={[
              'h-2.5 w-2.5 rounded-full border',
              k === puntos.length - 1 ? 'border-chart-accent bg-chart-accent' : 'border-chart-muted bg-surface',
            ]}
            aria-hidden="true"
          />
          {p.label}: <strong class="font-semibold text-ink tabular-nums">{decimal(p.valor)}</strong>
        </span>
      ))
    }
  </figcaption>
</figure>
