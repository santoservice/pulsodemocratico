---
import { r2, segmentosApilados } from '../../lib/charts';
import { pct } from '../../lib/format';

/**
 * Barra apilada al 100 % (composición izquierda · centro · derecha). Una fila por ronda,
 * así se ve cómo cambia la composición. Los segmentos usan tokens chart-cat-1..3.
 */
export interface SegmentoDato {
  key: string;
  label: string;
  valor: number;
}

export interface FilaApilada {
  label: string;
  segmentos: readonly SegmentoDato[];
}

export interface Props {
  filas: readonly FilaApilada[];
  titulo: string;
  id: string;
  class?: string;
}

const { filas, titulo, id, class: className } = Astro.props;

const FILL = ['fill-chart-cat-1', 'fill-chart-cat-2', 'fill-chart-cat-3'];
const BG = ['bg-chart-cat-1', 'bg-chart-cat-2', 'bg-chart-cat-3'];
const TXT = ['text-on-accent', 'text-chart-ink', 'text-on-accent'];
const leyenda = filas[0]?.segmentos ?? [];
---

<figure class:list={['w-full', className]}>
  <ul class="mb-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink" aria-hidden="true">
    {leyenda.map((s, k) => (
      <li class="flex items-center gap-1.5">
        <span class:list={['inline-block h-2.5 w-2.5 rounded-sm', BG[k % 3]]} />
        {s.label}
      </li>
    ))}
  </ul>
  <div class="sr-only" id={id}>
    <table>
      <caption>{titulo}</caption>
      <thead>
        <tr>
          <th scope="col">Ronda</th>
          {leyenda.map((s) => (
            <th scope="col">{s.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {filas.map((f) => (
          <tr>
            <th scope="row">{f.label}</th>
            {f.segmentos.map((s) => (
              <td>{pct(s.valor)}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ol class="flex flex-col gap-2" aria-hidden="true">
    {filas.map((f) => {
      const segs = segmentosApilados(f.segmentos);
      return (
        <li class="grid grid-cols-[4.5rem_1fr] items-center gap-2 sm:grid-cols-[5.5rem_1fr]">
          <span class="text-xs leading-tight text-ink-muted">{f.label}</span>
          <div class="relative h-8">
            <svg
              viewBox="0 0 100 10"
              preserveAspectRatio="none"
              class="absolute inset-0 block h-full w-full"
            >
              {segs.map((s, k) => (
                <rect x={r2(s.x0)} y="0" width={r2(s.ancho)} height="10" class={FILL[k % 3]} />
              ))}
              {segs.slice(1).map((s) => (
                <line
                  x1={r2(s.x0)}
                  x2={r2(s.x0)}
                  y1="0"
                  y2="10"
                  class="stroke-chart-grid"
                  stroke-width="2"
                  vector-effect="non-scaling-stroke"
                />
              ))}
            </svg>
            {segs.map((s, k) => (
              <span
                class:list={[
                  'absolute inset-y-0 flex items-center justify-center text-xs font-semibold tabular-nums',
                  TXT[k % 3],
                ]}
                style={`left:${r2(s.x0)}%;width:${r2(s.ancho)}%`}
              >
                {s.ancho >= 12 ? pct(s.dato.valor) : ''}
              </span>
            ))}
          </div>
        </li>
      );
    })}
  </ol>
</figure>
