---
import { ordenarBarras, posPct, r2 } from '../../lib/charts';
import { decimal } from '../../lib/format';

/**
 * Termómetros 0–10 (simpatía hacia líderes). Una fila por líder, ordenadas de mayor a menor.
 * Marcas cada punto; la barra se resalta si el valor llega a la mitad de la escala.
 */
export interface FilaTermometro {
  key: string;
  label: string;
  valor: number;
  /** Ronda del dato (se muestra si difiere de `rondaComun`). */
  ronda?: string;
}

export interface Props {
  filas: readonly FilaTermometro[];
  titulo: string;
  lo?: number;
  hi?: number;
  polos?: readonly [string, string];
  /** Ronda de la mayoría de filas: solo se anotan las que difieren. */
  rondaComun?: string;
  class?: string;
}

const {
  filas,
  titulo,
  lo = 0,
  hi = 10,
  polos = ['Le desagrada mucho', 'Le agrada mucho'],
  rondaComun,
  class: className,
} = Astro.props;
const orden = ordenarBarras(filas);
const ticks = Array.from({ length: hi - lo - 1 }, (_, k) => r2(posPct(lo + k + 1, lo, hi)));
const mitad = (lo + hi) / 2;
---

<figure class:list={['w-full', className]}>
  <ol class="flex flex-col gap-3" aria-hidden="true">
    {orden.map((f) => {
      const w = r2(posPct(f.valor, lo, hi));
      return (
        <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-3 sm:grid-cols-[10rem_1fr_2.5rem] sm:items-center">
          <span class="text-sm leading-snug font-medium text-ink">
            {f.label}
            {f.ronda && f.ronda !== rondaComun && (
              <span class="block text-xs font-normal text-ink-muted">{f.ronda}</span>
            )}
          </span>
          <span class="text-right text-base font-bold text-ink tabular-nums sm:order-last">
            {decimal(f.valor)}
          </span>
          <svg
            viewBox="0 0 100 12"
            preserveAspectRatio="none"
            class="col-span-2 mt-1 block h-3 w-full sm:col-span-1 sm:mt-0"
          >
            <rect x="0" y="0" width="100" height="12" class="fill-chart-track" />
            <rect
              x="0"
              y="0"
              width={w}
              height="12"
              class={f.valor >= mitad ? 'fill-chart-accent' : 'fill-chart-muted'}
            />
            {ticks.map((x) => (
              <line
                x1={x}
                x2={x}
                y1="0"
                y2="12"
                class="stroke-chart-grid"
                stroke-width="1"
                vector-effect="non-scaling-stroke"
              />
            ))}
          </svg>
        </li>
      );
    })}
  </ol>
  <figcaption
    class="mt-3 flex justify-between gap-4 text-xs text-ink-muted sm:ml-[10.75rem] sm:mr-[3.25rem]"
    aria-hidden="true"
  >
    <span>
      <span class="font-semibold text-ink">{lo}</span> · {polos[0]}
    </span>
    <span class="text-right">
      {polos[1]} · <span class="font-semibold text-ink">{hi}</span>
    </span>
  </figcaption>
  <div class="sr-only">
    <table>
      <caption>{`${titulo} (escala de ${lo} a ${hi})`}</caption>
      <thead>
        <tr>
          <th scope="col">Líder</th>
          <th scope="col">Promedio</th>
          <th scope="col">Ronda</th>
        </tr>
      </thead>
      <tbody>
        {orden.map((f) => (
          <tr>
            <th scope="row">{f.label}</th>
            <td>{decimal(f.valor)}</td>
            <td>{f.ronda ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
