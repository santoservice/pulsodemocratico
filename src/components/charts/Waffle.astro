---
import { waffleCells, waffleSize } from '../../lib/charts';
import { entero } from '../../lib/format';

/**
 * Pictograma de 100 cuadros: "X de cada 100". SVG estático (sin JS).
 * El texto visible va fuera del SVG para que no se escale con la gráfica.
 */
export interface Props {
  /** Valor 0–100 (se redondea igual que `format.pct`). */
  valor: number;
  /** Prefijo único para ids de <title>/<desc>. */
  id: string;
  /** Qué representa ("se ubican en la izquierda"). Se usa en el texto accesible. */
  descripcion?: string;
  /** Muestra la leyenda "X de cada 100" bajo la gráfica. */
  leyenda?: boolean;
  class?: string;
}

const { valor, id, descripcion, leyenda = true, class: className } = Astro.props;
const cells = waffleCells(valor);
const { w, h } = waffleSize();
const n = entero(valor);
const texto = `${n} de cada 100 personas encuestadas${descripcion ? ` ${descripcion}` : ''}`;
---

<figure class:list={['w-full max-w-44', className]}>
  <svg
    viewBox={`0 0 ${w} ${h}`}
    role="img"
    aria-labelledby={`${id}-t ${id}-d`}
    class="block h-auto w-full"
  >
    <title id={`${id}-t`}>{`${n} de cada 100`}</title>
    <desc id={`${id}-d`}>{texto}</desc>
    {cells.map((c) => (
      <rect
        x={c.x}
        y={c.y}
        width="10"
        height="10"
        rx="2"
        class={c.lleno ? 'fill-chart-accent' : 'fill-chart-track'}
      />
    ))}
  </svg>
  {leyenda && (
    <figcaption class="mt-2 flex items-center gap-2 text-xs text-ink-muted" aria-hidden="true">
      <span class="inline-block h-2.5 w-2.5 rounded-sm bg-chart-accent" />
      {n} de cada 100
    </figcaption>
  )}
</figure>
