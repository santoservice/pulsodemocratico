---
import Placeholder from '../ui/Placeholder.astro';
import { instituciones, nav, sitio } from '../../data/sitio';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border-strong bg-surface">
  <div class="container-page py-12">
    <p class="mb-6 text-center text-xs font-semibold tracking-[0.2em] text-ink-muted uppercase">
      Una iniciativa de
    </p>
    <!-- TODO (cliente): logos oficiales de las instituciones participantes -->
    <ul class="mx-auto grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4">
      {instituciones.map((i) => (
        <li class="flex flex-col items-center gap-2">
          <Placeholder class="aspect-[3/2] w-full max-w-36" size="sm" label="Logo" />
          <span class="text-center text-xs text-ink-muted">{i.nombre}</span>
        </li>
      ))}
    </ul>

    <nav aria-label="Pie de página" class="mt-10">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-ink-muted underline-offset-4 hover:text-ink hover:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="mt-8 text-center text-xs text-ink-muted">
      © {year}
      {sitio.nombre} · Encuesta panel CNEP Colombia 2026. Muestra no probabilística: los resultados
      describen a las personas encuestadas.
    </p>
  </div>
</footer>
