---
import InstitutionLogos from '../ui/InstitutionLogos.astro';
import { creditos } from '../../data/sitio';
---

<!-- Siempre en tema claro: los logos de las instituciones (azules) no se leen sobre el fondo oscuro. -->
<footer data-theme="light" class="mt-16 border-t border-brand bg-page">
  <div class="container-page py-12">
    <p
      id="footer-instituciones"
      class="mb-6 text-center text-xs font-semibold tracking-[0.2em] text-brand uppercase"
    >
      Una iniciativa de
    </p>
    <InstitutionLogos size="sm" labelledby="footer-instituciones" />

    <p class="mx-auto mt-10 max-w-3xl border-t border-border pt-8 text-center text-xs leading-relaxed text-ink-muted">
      {creditos}
    </p>
  </div>
</footer>
