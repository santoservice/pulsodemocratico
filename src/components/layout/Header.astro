---
import { Icon } from 'astro-icon/components';
import MobileMenu from '../islands/MobileMenu';
import { isActive, isCurrent, nav, sitio } from '../../data/sitio';
import { ruta } from '../../lib/rutas';

const path = Astro.url.pathname;
// En Inicio el nombre del sitio se oculta mientras se ve el título grande del hero.
const enInicio = isCurrent(path, ruta('/'));
// Como en el hero: la segunda palabra con el color de resaltado (Grana; dorado en tema oscuro).
const [nombre1, ...resto] = sitio.nombre.split(' ');
const nombre2 = resto.join(' ');
---

<!--
  Fijo arriba. La línea inferior aparece al hacer scroll (data-scroll); en Inicio el nombre
  aparece cuando el título del hero sale de pantalla (data-nombre).
-->
<header
  class="group/header sticky top-0 z-40 border-t-4 border-b border-t-brand dark:border-t-navy border-b-transparent bg-page transition-colors duration-300 data-[scroll]:border-b-border"
  data-header
  data-nombre={enInicio ? 'oculto' : undefined}
>
  <div class="container-page flex h-14 items-center justify-between gap-6 md:h-16">
    <!-- TODO (cliente): sin logo; va el texto "Pulso Democrático" -->
    <a
      href={ruta('/')}
      class="text-lg font-bold tracking-tight text-brand transition-[opacity,translate] duration-300 group-data-[nombre=oculto]/header:pointer-events-none group-data-[nombre=oculto]/header:-translate-y-1 group-data-[nombre=oculto]/header:opacity-0 md:text-xl"
    >
      {nombre1} <span class="text-grana">{nombre2}</span>
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-1 lg:gap-4">
        {nav.map((item) => {
          const active = isActive(path, item.href);
          // Activo: "píldora" blanca con texto azul; al pasar el mouse, un blanco tenue.
          const pildora = active
            ? 'bg-white font-semibold text-brand shadow-sm dark:text-negro'
            : 'text-ink hover:bg-white/60 dark:hover:bg-surface-muted/60';
          const linkClass = [
            'inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-[0.95rem] transition-colors',
            item.children ? '' : pildora,
          ].join(' ');
          if (!item.children) {
            return (
              <li>
                <a
                  href={item.href}
                  class={linkClass}
                  aria-current={isCurrent(path, item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          }
          return (
            <li class="nav-dropdown group relative" data-dropdown>
              <div class:list={['flex items-center rounded-md pr-1 transition-colors', pildora]}>
                <a
                  href={item.href}
                  class={linkClass}
                  aria-current={isCurrent(path, item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  class="-ml-2 inline-flex h-8 w-6 items-center justify-center"
                  aria-expanded="false"
                  aria-controls="submenu-resultados"
                  data-dropdown-toggle
                >
                  <span class="sr-only">Mostrar temas de {item.label}</span>
                  <Icon name="lucide:chevron-down" class="h-4 w-4" aria-hidden="true" />
                </button>
              </div>
              <ul
                id="submenu-resultados"
                class="invisible absolute top-full left-0 mt-1 w-60 rounded-xl before:absolute before:inset-x-0 before:-top-2 before:h-2 before:content-[''] border border-border bg-surface py-1 opacity-0 shadow-lg transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 group-data-[hover]:visible group-data-[hover]:opacity-100 group-data-[open]:visible group-data-[open]:opacity-100 group-data-[closed]:invisible! group-data-[closed]:opacity-0!"
              >
                {item.children.map((child) => (
                  <li class="border-b border-surface-sunken last:border-b-0">
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2.5 text-sm text-ink hover:bg-surface-muted focus-visible:bg-surface-muted',
                        isCurrent(path, child.href) && 'font-semibold',
                      ]}
                      aria-current={isCurrent(path, child.href) ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
      </ul>
    </nav>

    <MobileMenu client:media="(max-width: 767px)" items={nav} currentPath={path} />
  </div>
</header>

<script>
  // Línea inferior al hacer scroll y, en Inicio, nombre del sitio tras pasar el título del hero.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const marcarScroll = () => header.toggleAttribute('data-scroll', window.scrollY > 4);
    marcarScroll();
    window.addEventListener('scroll', marcarScroll, { passive: true });

    const titulo = document.getElementById('titulo-principal');
    if (titulo && header.dataset.nombre) {
      new IntersectionObserver(
        ([e]) => {
          if (e) header.dataset.nombre = e.isIntersecting ? 'oculto' : 'visible';
        },
        // El título cuenta como "visible" solo por debajo del header fijo.
        { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
      ).observe(titulo);
    }
  }

  // Mejora progresiva del desplegable de escritorio: el CSS (:hover / :focus-within)
  // ya lo abre; este script sincroniza aria-expanded, permite abrir con el botón y
  // cerrar con Escape.
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    if (!toggle) return;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      root.toggleAttribute('data-open', open);
      // data-closed fuerza el cierre aunque el foco siga dentro (tras Escape).
      root.toggleAttribute('data-closed', !open);
    };
    const reset = () => {
      root.removeAttribute('data-open');
      root.removeAttribute('data-closed');
      toggle.setAttribute('aria-expanded', 'false');
    };
    // Con el mouse encima el menú ya está abierto (hover): el primer clic lo deja fijo
    // (data-open) y el siguiente lo cierra.
    toggle.addEventListener('click', () => set(!root.hasAttribute('data-open')));
    // Hover por JS: group-hover de Tailwind solo aplica con (hover: hover), y algunos equipos
    // con pantalla táctil no lo reportan aunque usen mouse.
    root.addEventListener('mouseenter', () => {
      root.removeAttribute('data-closed');
      root.setAttribute('data-hover', '');
      toggle.setAttribute('aria-expanded', 'true');
    });
    root.addEventListener('mouseleave', () => {
      root.removeAttribute('data-hover');
      if (!root.contains(document.activeElement)) reset();
    });
    root.addEventListener('focusin', () => {
      if (!root.hasAttribute('data-closed')) toggle.setAttribute('aria-expanded', 'true');
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) reset();
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        set(false);
        toggle.focus();
      }
    });
  });
</script>
