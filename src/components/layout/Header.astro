---
import { Icon } from 'astro-icon/components';
import MobileMenu from '../islands/MobileMenu';
import { isActive, isCurrent, nav, sitio } from '../../data/sitio';
import { ruta } from '../../lib/rutas';

const path = Astro.url.pathname;
---

<!--
  Fijo arriba, sin fondo sólido: un velo azul con blur que se difumina hacia abajo (maqueta
  aprobada). Los bordes van transparentes para conservar el alto de 69px del que dependen
  otros sticky. El nombre del sitio se ve siempre, también en Inicio.
-->
<header
  class="cabecera group/header sticky top-0 z-40 border-t-4 border-b border-transparent"
  data-header
>
  <div class="container-page flex h-14 items-center justify-between gap-6 md:h-16 md:pl-0">
    <!-- TODO (cliente): sin logo; va el texto "Pulso Democrático" -->
    <a
      href={ruta('/')}
      class="relative z-10 text-lg font-bold tracking-tight text-brand transition-[opacity,translate,color] duration-300 group-data-[menu-open]/header:text-[#F3F5FA] md:text-xl"
    >
      {sitio.nombre}
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => {
          const active = isActive(path, item.href);
          // Activo: texto más claro con rayita azul debajo; al pasar el mouse, rayita crema.
          const pildora = [
            'relative after:pointer-events-none after:absolute after:inset-x-3 after:bottom-0.5 after:h-[3px] after:rounded-full after:transition-opacity',
            active
              ? 'text-brand-strong after:bg-accent dark:after:bg-[#5e8be0]'
              : 'text-ink after:bg-cream after:opacity-0 hover:text-brand-strong hover:after:opacity-100',
          ].join(' ');
          const linkClass = [
            'inline-flex items-center gap-1 rounded-md px-3 py-1.5 text-[0.95rem] font-semibold transition-colors',
            item.children ? '' : pildora,
          ].join(' ');
          if (!item.children) {
            return (
              <li>
                <a
                  href={item.href}
                  class={linkClass}
                  aria-current={isCurrent(path, item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          }
          return (
            <li class="nav-dropdown group relative" data-dropdown>
              <div class:list={['flex items-center rounded-md pr-1 transition-colors', pildora]}>
                <a
                  href={item.href}
                  class={linkClass}
                  aria-current={isCurrent(path, item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  class="-ml-2 inline-flex h-8 w-6 items-center justify-center"
                  aria-expanded="false"
                  aria-controls="submenu-resultados"
                  data-dropdown-toggle
                >
                  <span class="sr-only">Mostrar temas de {item.label}</span>
                  <Icon name="lucide:chevron-down" class="h-4 w-4" aria-hidden="true" />
                </button>
              </div>
              <ul
                id="submenu-resultados"
                class="invisible absolute top-full left-0 mt-1 w-60 rounded-xl before:absolute before:inset-x-0 before:-top-2 before:h-2 before:content-[''] border border-border bg-surface py-1 opacity-0 shadow-lg transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 group-data-[hover]:visible group-data-[hover]:opacity-100 group-data-[open]:visible group-data-[open]:opacity-100 group-data-[closed]:invisible! group-data-[closed]:opacity-0!"
              >
                {item.children.map((child) => (
                  <li class="border-b border-surface-sunken last:border-b-0">
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2.5 text-sm text-ink hover:bg-surface-muted focus-visible:bg-surface-muted',
                        isCurrent(path, child.href) && 'font-semibold',
                      ]}
                      aria-current={isCurrent(path, child.href) ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
      </ul>
    </nav>

    <MobileMenu client:media="(max-width: 767px)" items={nav} currentPath={path} />
  </div>
</header>

<style>
  /* Velo de la maqueta: azul translúcido + blur, se desvanece por debajo del header. */
  .cabecera::before {
    content: '';
    position: absolute;
    inset: -4px 0 -14px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(0 16 46 / 0.45), rgb(0 16 46 / 0.25) 70%, rgb(0 16 46 / 0));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    mask-image: linear-gradient(to bottom, #000 0%, #000 55%, rgb(0 0 0 / 0.6) 75%, rgb(0 0 0 / 0.2) 90%, transparent 100%);
    transition: opacity 0.3s ease;
  }
  /* Menú móvil abierto: el velo se quita (como en la maqueta); el menú pone su propio fondo. */
  .cabecera[data-menu-open]::before {
    opacity: 0;
  }
  :global([data-theme='light']) .cabecera::before {
    background: linear-gradient(to bottom, rgb(247 239 217 / 0.85), rgb(247 239 217 / 0.6) 70%, rgb(247 239 217 / 0));
  }
</style>

<script>
  // Mejora progresiva del desplegable de escritorio: el CSS (:hover / :focus-within)
  // ya lo abre; este script sincroniza aria-expanded, permite abrir con el botón y
  // cerrar con Escape.
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    if (!toggle) return;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      root.toggleAttribute('data-open', open);
      // data-closed fuerza el cierre aunque el foco siga dentro (tras Escape).
      root.toggleAttribute('data-closed', !open);
    };
    const reset = () => {
      root.removeAttribute('data-open');
      root.removeAttribute('data-closed');
      toggle.setAttribute('aria-expanded', 'false');
    };
    // Con el mouse encima el menú ya está abierto (hover): el primer clic lo deja fijo
    // (data-open) y el siguiente lo cierra.
    toggle.addEventListener('click', () => set(!root.hasAttribute('data-open')));
    // Hover por JS: group-hover de Tailwind solo aplica con (hover: hover), y algunos equipos
    // con pantalla táctil no lo reportan aunque usen mouse.
    root.addEventListener('mouseenter', () => {
      root.removeAttribute('data-closed');
      root.setAttribute('data-hover', '');
      toggle.setAttribute('aria-expanded', 'true');
    });
    root.addEventListener('mouseleave', () => {
      root.removeAttribute('data-hover');
      if (!root.contains(document.activeElement)) reset();
    });
    root.addEventListener('focusin', () => {
      if (!root.hasAttribute('data-closed')) toggle.setAttribute('aria-expanded', 'true');
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) reset();
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        set(false);
        toggle.focus();
      }
    });
  });
</script>
