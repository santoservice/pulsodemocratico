---
import FindingCard from './FindingCard.astro';

/**
 * Grilla de hallazgos: 2 columnas en escritorio, 1 en móvil.
 * Con `items` pinta FindingCards; si no, usa el slot (para tarjetas con gráfica propia).
 * TODO Fase 3: items desde tablero.json (indicadores del tema / destacados).
 */
export interface FindingItem {
  titulo?: string;
  resumen?: string;
  indicador?: string;
  tema?: string;
  chartLabel?: string;
}

export interface Props {
  items?: FindingItem[];
  /** Nº de tarjetas placeholder si no hay items ni slot. */
  placeholders?: number;
  label?: string;
}

const { items, placeholders = 8, label = 'Hallazgos' } = Astro.props;
const hasSlot = Astro.slots.has('default');
const list: FindingItem[] =
  items ?? (hasSlot ? [] : Array.from({ length: placeholders }, () => ({})));
const chartLabels = [
  'Gráfico',
  'Barras',
  'Dona',
  'Mapa / Gráfico',
  'Barras apiladas',
  'Rondas 1–3',
  'Escala 0–10',
  'Mapa de calor',
];
---

<ul aria-label={label} class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
  {list.map((item, i) => (
    <li>
      <FindingCard
        numero={i + 1}
        {...item}
        chartLabel={item.chartLabel ?? chartLabels[i % chartLabels.length]}
      />
    </li>
  ))}
  <slot />
</ul>
