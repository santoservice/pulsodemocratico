---
import FindingCard from './FindingCard.astro';
import IndicatorChart from './IndicatorChart.astro';
import { getTemaByDataKey, temaHref } from '../../data/temas';
import type { Tarjeta } from '../../lib/tablero';
import { resumenTarjeta, titularTarjeta } from '../../lib/textos';

/**
 * Grilla de hallazgos: 2 columnas en escritorio, 1 en móvil.
 * Con `tarjetas` pinta FindingCard + IndicatorChart; además acepta tarjetas propias por slot
 * (p. ej. Jóvenes), que deben ir dentro de <li>.
 */
export interface Props {
  tarjetas?: readonly Tarjeta[];
  /** Añade el enlace "Más sobre <tema>" (en /resultados). */
  conTema?: boolean;
  /** Muestra la pendiente entre rondas en cada tarjeta. */
  mostrarCambio?: boolean;
  label: string;
  /** Número de la primera tarjeta. */
  desde?: number;
}

const { tarjetas = [], conTema = false, mostrarCambio = true, label, desde = 1 } = Astro.props;
---

<ul aria-label={label} class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
  {tarjetas.map((t, i) => {
    const tema = conTema ? getTemaByDataKey(t.tema) : undefined;
    return (
      <li>
        <FindingCard
          numero={desde + i}
          titulo={t.titulo}
          titular={titularTarjeta(t)}
          resumen={resumenTarjeta(t)}
          indicador={t.indicadores[0]?.key}
          tarjeta={t.id}
          tema={tema ? { titulo: tema.titulo, href: temaHref(tema.slug) } : undefined}
        >
          <IndicatorChart tarjeta={t} mostrarCambio={mostrarCambio} />
        </FindingCard>
      </li>
    );
  })}
  <slot />
</ul>
