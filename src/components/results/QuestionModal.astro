---
import { Image } from 'astro:assets';
import { instituciones } from '../../data/sitio';

/**
 * Modal de detalle (PLAN.md §4.2, §6). Un solo <dialog> nativo por página: los detalles
 * (DetalleVisor, en el slot) ya están en el HTML (ocultos, para SEO) y un script mínimo los
 * mueve al diálogo al abrirlos desde un botón `[data-tarjeta]` de TarjetaVisor.
 *
 * - `?pregunta=<clave>` en la URL al abrir (replaceState); se abre al cargar si viene en la URL.
 * - Esc cierra (nativo); el foco queda atrapado (showModal) y vuelve al botón al cerrar.
 * - Bloquea el scroll del fondo; ocupa toda la pantalla (barra fija con título y cerrar).
 * - Pie con los logos de las instituciones y los créditos (pedido del cliente).
 */

// Orden de sitio.ts: CNEP, Wisconsin, La Sabana, Externado, Complutense.
const logos = instituciones.flatMap((i) =>
  i.logo ? [{ nombre: i.nombre, src: i.logo, escala: i.escala ?? 1 }] : [],
);
---

<div hidden data-detalles>
  <!-- Artículos con id="detalle-<tarjeta>" (DetalleVisor). -->
  <slot />
</div>

<!--
  Pantalla completa sobre la página (no una ventana pequeña): barra fija con tema, título y
  cerrar; debajo, el mosaico del detalle y el pie con los logos (en tema claro).
-->
<dialog
  id="modal-pregunta"
  class="modal-pregunta fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto overscroll-contain border-0 bg-page p-0 text-ink backdrop:bg-navy/80"
>
  <div class="flex min-h-full flex-col">
    <div class="sticky top-0 z-10 border-b border-border bg-page/95 backdrop-blur">
      <div class="container-page flex items-center justify-between gap-4 py-3 md:py-4">
        <div class="min-w-0">
          <p
            data-modal-eyebrow
            class="truncate text-sm font-bold text-ink-muted lowercase first-letter:uppercase md:text-base"
          ></p>
          <p
            data-modal-titulo
            aria-hidden="true"
            class="mt-1 line-clamp-2 text-xl leading-tight font-bold text-brand md:text-3xl"
          ></p>
        </div>
        <button
          type="button"
          data-modal-cerrar
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-cream text-navy shadow-md transition-transform hover:scale-105 md:h-12 md:w-12"
        >
          <span class="sr-only">Cerrar</span>
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </div>
    <div data-modal-cuerpo class="container-page flex-1 py-6 md:py-8"></div>
    <!-- Tema claro: los logos (azules) no se leen sobre el fondo oscuro. -->
    <footer data-theme="light" class="mt-8 border-t border-border bg-page py-6">
      <p id="modal-pregunta-logos" class="sr-only">
        Instituciones participantes
      </p>
      <!-- Centrados; si no caben en una fila (celular), pasan a la siguiente. -->
      <ul
        aria-labelledby="modal-pregunta-logos"
        class="container-page flex flex-wrap items-center justify-center gap-x-8 gap-y-6 md:gap-x-10"
      >
        {logos.map((l) => (
          <li class="shrink-0">
            <Image
              src={l.src}
              alt={l.nombre}
              height={Math.round(40 * l.escala)}
              loading="lazy"
              style={`height:${2.5 * l.escala}rem`}
              class="w-auto object-contain"
            />
          </li>
        ))}
      </ul>
      <p class="container-page mt-4 text-center text-xs leading-relaxed text-ink-muted">
        © 2026 Pulso Democrático. Encuesta Colombia 2026, Comparative National Elections Project
        (CNEP).
      </p>
    </footer>
  </div>
</dialog>

<!--
  Plantilla de la imagen descargable de una gráfica (botones [data-descargar] del detalle):
  tema y título arriba, la gráfica en medio y una franja crema con los logos abajo.
  Siempre en tema claro (isla data-theme="light"), aunque el sitio se vea en oscuro.
-->
<template data-descarga-plantilla>
  <div data-theme="light" class="bg-white text-ink" style="--color-ink: #001844; --color-ink-muted: #001844; --color-brand: #001844">
    <div class="px-8 pt-7 pb-5">
      <p data-d-eyebrow class="text-base font-bold text-ink-muted"></p>
      <p data-d-titulo class="mt-1 text-2xl leading-tight font-bold text-brand"></p>
    </div>
    <!-- Las tarjetas de la imagen (bg-surface) van en gris claro #f3f3f3, no en el crema del tema. -->
    <div data-d-cuerpo class="px-8 pb-8" style="--color-surface: #f3f3f3"></div>
    <div data-theme="light" class="bg-white px-8 py-5" style="--color-ink: #001844; --color-ink-muted: #001844; --color-brand: #001844">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        {logos.map((l) => (
          <li class="shrink-0">
            <Image
              src={l.src}
              alt={l.nombre}
              height={Math.round(40 * l.escala)}
              loading="eager"
              style={`height:${2 * l.escala}rem`}
              class="w-auto object-contain"
            />
          </li>
        ))}
      </ul>
      <p class="mt-4 text-center text-xs leading-relaxed text-ink-muted">
        Pulso Democrático · pulsodemocratico.co · Encuesta Colombia 2026, Comparative National
        Elections Project (CNEP)
      </p>
    </div>
  </div>
</template>

<style is:global>
  /* Imagen descargable: bordes de tarjetas y líneas de tablas en blanco (las líneas de las gráficas,
     que son SVG con stroke-border, no se tocan). */
  [data-d-cuerpo] .border-border {
    border-color: #fff;
  }
</style>

<style>
  .modal-pregunta[open] {
    animation: modal-entra 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @keyframes modal-entra {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }
</style>

<script>
  // Parámetro de URL del modal.
  const PARAM_PREGUNTA = 'pregunta';

  const dialog = document.getElementById('modal-pregunta') as HTMLDialogElement | null;
  const almacen = document.querySelector<HTMLElement>('[data-detalles]');

  if (dialog && almacen) {
    const cuerpo = dialog.querySelector<HTMLElement>('[data-modal-cuerpo]')!;
    const eyebrow = dialog.querySelector<HTMLElement>('[data-modal-eyebrow]')!;
    const tituloBarra = dialog.querySelector<HTMLElement>('[data-modal-titulo]')!;
    let actual: HTMLElement | null = null;
    let origen: HTMLElement | null = null;

    const setParam = (clave: string | null) => {
      const url = new URL(window.location.href);
      if (clave) url.searchParams.set(PARAM_PREGUNTA, clave);
      else url.searchParams.delete(PARAM_PREGUNTA);
      history.replaceState(history.state, '', url);
    };

    const devolver = () => {
      if (actual) almacen.append(actual);
      actual = null;
    };

    const abrir = (art: HTMLElement, disparador: HTMLElement | null) => {
      devolver();
      cuerpo.append(art);
      actual = art;
      eyebrow.textContent = art.dataset.eyebrow ?? '';
      const lbl = art.getAttribute('aria-labelledby');
      if (lbl) dialog.setAttribute('aria-labelledby', lbl);
      // Título visible en la barra fija (el h2 del detalle queda solo para lectores de pantalla).
      tituloBarra.textContent = (lbl && document.getElementById(lbl)?.textContent) || '';
      origen = disparador;
      if (!dialog.open) dialog.showModal();
      dialog.scrollTop = 0;
      document.documentElement.style.overflow = 'hidden';
      setParam(art.dataset.pregunta ?? null);
    };

    // Limpieza idempotente. Se llama al cerrar por nuestros controles y también en el evento
    // `close` (que el navegador encola y puede retrasar, p. ej. en pestañas en segundo plano).
    const limpiar = () => {
      if (!actual) return;
      devolver();
      document.documentElement.style.overflow = '';
      setParam(null);
      origen?.focus();
      origen = null;
    };
    const cerrar = () => {
      if (dialog.open) dialog.close();
      limpiar();
    };

    dialog.addEventListener('close', limpiar);
    // Esc: cerramos nosotros para limpiar en el acto.
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      cerrar();
    });
    // Clic en el fondo (fuera del contenido) cierra.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) cerrar();
    });
    dialog.querySelector('[data-modal-cerrar]')?.addEventListener('click', cerrar);

    const detallePorTarjeta = (id: string) =>
      document.getElementById(`detalle-${id}`) as HTMLElement | null;

    document.addEventListener('click', (e) => {
      const b = (e.target as Element | null)?.closest<HTMLElement>('button[data-tarjeta]');
      if (!b?.dataset.tarjeta) return;
      const art = detallePorTarjeta(b.dataset.tarjeta);
      if (art) abrir(art, b);
    });

    // Descargar una gráfica (o un conjunto) como PNG, con título arriba y logos abajo.
    const plantilla = document.querySelector<HTMLTemplateElement>('[data-descarga-plantilla]');
    const descargar = async (bloque: HTMLElement, boton: HTMLButtonElement) => {
      if (!plantilla) return;
      boton.disabled = true;
      // Fuera de pantalla: el contenedor exterior se mueve, el lienzo se captura tal cual.
      const fuera = document.createElement('div');
      fuera.style.cssText = 'position:fixed;left:-20000px;top:0;pointer-events:none';
      try {
        const { domToPng } = await import('modern-screenshot');
        const lienzo = (plantilla.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
        // En celular la imagen sale con el diseño de escritorio: las variantes `lg:` no se aplican
        // (el viewport es chico), así que se emulan sobre la copia más abajo y el lienzo se ensancha.
        const movil = !window.matchMedia('(min-width: 64rem)').matches;
        const completo = bloque.dataset.descarga?.endsWith('-completo');
        const ancho = movil ? (completo ? 1100 : 504) : Math.max(bloque.offsetWidth, 560);
        lienzo.style.width = `${ancho + 64}px`;
        // Tema y título: los del bloque (tarjetas fuera del modal) o los de la barra del modal.
        // Con la primera en mayúscula y el resto en minúscula, en el texto mismo: modern-screenshot
        // no dibuja ::first-letter.
        const tema = (bloque.dataset.tema ?? eyebrow.textContent ?? '').toLocaleLowerCase('es');
        lienzo.querySelector('[data-d-eyebrow]')!.textContent =
          tema.charAt(0).toLocaleUpperCase('es') + tema.slice(1);
        lienzo.querySelector('[data-d-titulo]')!.textContent =
          bloque.dataset.titulo ?? tituloBarra.textContent;
        const copia = bloque.cloneNode(true) as HTMLElement;
        copia.querySelectorAll('[data-descargar], [data-descargar-csv]').forEach((b) => b.remove());
        // En la imagen "todo", el «¿Cómo se midió?» va abierto.
        copia.querySelectorAll('details').forEach((d) => (d.open = true));
        // Íconos de astro-icon repetidos (<use href="#ai:…">): modern-screenshot no acepta ese id.
        copia.querySelectorAll('use[href^="#ai:"]').forEach((u) => u.closest('svg')?.remove());
        if (movil) {
          // Gráfica ancha en vez de la de celular.
          copia.querySelectorAll<HTMLElement>('.lg\\:hidden').forEach((e) => (e.style.display = 'none'));
          copia
            .querySelectorAll<HTMLElement>('.max-lg\\:hidden')
            .forEach((e) => e.style.setProperty('display', 'block', 'important'));
          // Columnas y filas completas de la cuadrícula del detalle (`lg:grid-cols-[..]`, `lg:col-span-2`).
          [copia, ...copia.querySelectorAll<HTMLElement>('*')].forEach((e) => {
            const col = [...e.classList].find((c) => c.startsWith('lg:grid-cols-['));
            if (col) e.style.gridTemplateColumns = col.slice(14, -1).replaceAll('_', ' ');
            if (e.classList.contains('lg:col-span-2')) e.style.gridColumn = 'span 2';
          });
        }
        copia.style.margin = '0';
        lienzo.querySelector('[data-d-cuerpo]')!.append(copia);
        fuera.append(lienzo);
        document.body.append(fuera);
        await Promise.all(
          Array.from(lienzo.querySelectorAll('img'), (img) => img.decode().catch(() => {})),
        );
        const png = await domToPng(lienzo, { scale: 2 });
        const a = document.createElement('a');
        a.href = png;
        a.download = `pulso-democratico-${bloque.dataset.descarga}.png`;
        a.click();
      } catch (err) {
        console.error('No se pudo descargar la gráfica', err);
      } finally {
        fuera.remove();
        boton.disabled = false;
      }
    };
    // En el documento (no solo en el modal): las tarjetas del visor también descargan.
    // `data-objetivo` = id del bloque a capturar; si no, el [data-descarga] que contiene al botón.
    document.addEventListener('click', (e) => {
      const b = (e.target as Element | null)?.closest<HTMLButtonElement>('button[data-descargar]');
      if (!b) return;
      const bloque = b.dataset.objetivo
        ? document.getElementById(b.dataset.objetivo)
        : b.parentElement?.closest<HTMLElement>('[data-descarga]');
      if (bloque) void descargar(bloque, b);
    });

    // Datos como CSV (se abre en Excel): las tablas de "Los datos del gráfico" del detalle.
    const csv = (art: HTMLElement) => {
      const celda = (t: string) => `"${t.replace(/\s+/g, ' ').trim().replace(/"/g, '""')}"`;
      const lineas: string[] = [celda(art.querySelector('h2')?.textContent ?? '')];
      art.querySelectorAll<HTMLElement>('[data-tabla-visor]').forEach((t) => {
        lineas.push('');
        const titulo = t.querySelector('[data-tabla-titulo]')?.textContent;
        if (titulo) lineas.push(celda(titulo));
        t.querySelectorAll('tr').forEach((tr) => {
          const fila = Array.from(tr.children, (c) => {
            const v = c.querySelector('[data-v]')?.textContent ?? c.textContent ?? '';
            const sub = c.querySelector('[data-sub]')?.textContent;
            return celda(sub ? `${v} (${sub})` : v);
          });
          lineas.push(fila.join(';'));
        });
        const nota = t.querySelector('[data-tabla-nota]')?.textContent;
        if (nota) lineas.push(celda(nota));
      });
      // BOM: Excel reconoce las tildes; ";" es el separador de Excel en español.
      return '﻿' + lineas.join('\r\n');
    };
    document.addEventListener('click', (e) => {
      const b = (e.target as Element | null)?.closest<HTMLButtonElement>('button[data-descargar-csv]');
      const art = b?.dataset.objetivo ? document.getElementById(b.dataset.objetivo) : null;
      if (!b || !art) return;
      const url = URL.createObjectURL(new Blob([csv(art)], { type: 'text/csv;charset=utf-8' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = `pulso-democratico-${art.dataset.pregunta ?? 'datos'}-datos.csv`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });

    // Enlace directo: ?pregunta=<clave>
    const clave = new URLSearchParams(window.location.search).get(PARAM_PREGUNTA);
    if (clave) {
      const art = Array.from(almacen.querySelectorAll<HTMLElement>('[data-pregunta]')).find(
        (a) => a.dataset.pregunta === clave,
      );
      if (art) {
        const boton = document.querySelector<HTMLElement>(
          `button[data-tarjeta="${CSS.escape(art.dataset.tarjeta ?? '')}"]`,
        );
        abrir(art, boton);
      }
    }
  }
</script>
