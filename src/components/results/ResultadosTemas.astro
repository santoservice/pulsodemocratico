---
/**
 * «Resultados de la encuesta» en /resultados: selector de temas y, debajo, el tema elegido
 * (ilustración, pregunta y sus hallazgos del visor, sin el principal).
 *
 * Pestañas ARIA (tablist/tab/tabpanel) con flechas, Inicio y Fin. Sin JS no hay selector:
 * se ven todos los temas uno tras otro. `#<slug>` en la URL abre ese tema y baja hasta el
 * selector: así enlazan el menú, el inicio y el quiz (`temaHref`).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TarjetaVisor from '../visor/TarjetaVisor.astro';
import { temas, type TemaSlug } from '../../data/temas';
import { titulo } from '../../lib/format';
import { otrosHallazgosTema } from '../../lib/visor/temas';
import polarizacion from '../../assets/images/polarizacion.webp';
import populismo from '../../assets/images/populismo.webp';
import desinformacion from '../../assets/images/desinformacion.webp';
import ia from '../../assets/images/inteligencia-artificial.webp';
import consumo from '../../assets/images/consumo-mediatico.webp';
import juvenil from '../../assets/images/comportamiento-juvenil.webp';

/**
 * Ilustración de cada tema y de qué lado va: del lado donde la composición deja el espacio
 * libre hacia el texto (polarización y consumo cargan su peso a la izquierda).
 */
type Ilustracion = { src: ImageMetadata; alt: string; lado: 'izq' | 'der' };
const ilustraciones: Record<TemaSlug, Ilustracion> = {
  polarizacion: {
    src: polarizacion,
    alt: 'Collage: una silueta azul, estatuas de próceres y un hombre que carga una lámina de zinc, separados por un rayo rojo.',
    lado: 'izq',
  },
  populismo: {
    src: populismo,
    alt: 'Collage: un hombre con gorra, una mujer mayor con bolso, un campesino con sombrero y aves azules.',
    lado: 'der',
  },
  desinformacion: {
    src: desinformacion,
    alt: 'Collage: una mano mueve con hilos a un títere mientras una mujer mira su computador.',
    lado: 'der',
  },
  'inteligencia-artificial': {
    src: ia,
    alt: 'Collage: una mano sostiene un celular del que sale un perro con capa de superhéroe, sobre un estallido rojo con líneas de código.',
    lado: 'izq',
  },
  'consumo-mediatico': {
    src: consumo,
    alt: 'Collage: un televisor con un ojo en la pantalla, un vigilante que toma una foto con el celular, un hombre que lee el periódico y una mano con el control remoto.',
    lado: 'izq',
  },
  'comportamiento-juvenil': {
    src: juvenil,
    alt: 'Collage: una joven con sombrero que toca un tambor y otra joven en primer plano.',
    lado: 'der',
  },
};

// Temas cuyas gráficas se leen mejor anchas: dos columnas en vez de tres (en Polarización,
// las de polarización ideológica y percibida quedan una al lado de la otra).
const dosColumnas: TemaSlug[] = [
  'polarizacion',
  'populismo',
  'desinformacion',
  'inteligencia-artificial',
  'consumo-mediatico',
  'comportamiento-juvenil',
];

// Orden propio de algunos temas (ids del visor): en dos columnas, las gráficas de alto parecido
// van en la misma fila.
const orden: Partial<Record<TemaSlug, string[]>> = {
  polarizacion: ['pex', 'wsk', 'pol', 'pll'],
  desinformacion: ['dti', 'dco', 'dia', 'dpr', 'dve'],
  'consumo-mediatico': ['cma', 'cpu', 'cre', 'cod', 'cch'],
};

// Hallazgos con gráficas largas: van al final y ocupan las dos columnas (ids del visor).
const anchos = new Set([
  'pit', // Populismo: ¿con qué ideas populistas están de acuerdo?
  'dve', // Desinformación: ¿a qué recurren para verificar una noticia?
  'cch', // Consumo: ¿reciben o comparten política por chats y redes?
  'jco', // Jóvenes: ¿comparten más sus opiniones políticas en plataformas digitales?
]);

// La pregunta del inicio del texto del tema va como título; el resto, como bajada.
const items = temas.map((t) => {
  const corte = t.intro.indexOf('?') + 1;
  return {
    tema: t,
    pregunta: t.intro.slice(0, corte),
    bajada: t.intro.slice(corte).trim(),
    hallazgos: otrosHallazgosTema(t.slug).toSorted((a, b) => {
      const o = orden[t.slug];
      if (o) return o.indexOf(a.id) - o.indexOf(b.id);
      return Number(anchos.has(a.id)) - Number(anchos.has(b.id));
    }),
    img: ilustraciones[t.slug],
  };
});
---

<div data-temas-resultados class="mt-7 scroll-mt-3">
  <!-- En escritorio el selector se pega bajo el header al bajar, como tarjeta de vidrio (data-pegado). -->
  <div
    role="tablist"
    aria-label="Temas de resultados"
    hidden
    class="selector-temas sticky top-[61px] z-20 md:top-[69px] md:grid md:grid-cols-3 lg:grid-cols-[repeat(6,minmax(max-content,1fr))]"
  >
    {/* Celular: el carrusel es esta caja interior, así el texto se corta en el borde del relleno
        (a 8 px del borde del selector) y no pegado al borde. Desde md desaparece (contents). */}
    <div data-carrusel class="carrusel-temas relative flex gap-2 overflow-x-auto md:contents">
    {items.map(({ tema }, i) => (
      <button
        type="button"
        role="tab"
        id={`pestana-${tema.slug}`}
        aria-controls={`panel-${tema.slug}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-tema={tema.slug}
        class="flex min-h-11 shrink-0 items-center justify-center rounded-full px-5 py-1.5 text-center text-sm leading-tight font-bold whitespace-nowrap text-ink transition-colors md:px-3 hover:bg-[#5e8be0] hover:text-(--color-tarjeta-visor) aria-selected:bg-cream aria-selected:text-navy"
      >
        {titulo(tema.titulo)}
      </button>
    ))}
    </div>
  </div>

  {items.map(({ tema, pregunta, bajada, hallazgos, img }) => (
    <section
      id={`panel-${tema.slug}`}
      role="tabpanel"
      aria-labelledby={`pestana-${tema.slug}`}
      data-panel={tema.slug}
      class="mt-6 scroll-mt-32 md:scroll-mt-24"
    >
      <div
        class:list={[
          'grid items-end gap-6 md:gap-10',
          img &&
            (img.lado === 'der'
              ? 'md:grid-cols-[1fr_minmax(0,13rem)] lg:grid-cols-[1fr_minmax(0,14rem)]'
              : 'md:grid-cols-[minmax(0,13rem)_1fr] lg:grid-cols-[minmax(0,14rem)_1fr]'),
        ]}
      >
        {img && (
          <Image
            src={img.src}
            alt={img.alt}
            widths={[240, 360, 480]}
            sizes="(min-width: 1024px) 14rem, (min-width: 768px) 13rem, 11rem"
            class:list={['h-auto w-44 max-md:mx-auto md:w-full', img.lado === 'der' && 'md:order-2']}
          />
        )}
        <div class:list={['pb-2', img?.lado === 'der' && 'md:order-1']}>
          <p class="text-xs font-bold tracking-[0.18em] text-ink-muted uppercase max-md:hidden">{tema.titulo}</p>
          <h3 class="mt-2 font-display text-2xl leading-[1.1] font-bold tracking-tight text-brand md:text-3xl lg:text-4xl">
            {pregunta}
          </h3>
          {bajada && <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">{bajada}</p>}
          {'nota' in tema && tema.nota && (
            <p class="mt-3 max-w-2xl font-semibold text-ink">{tema.nota}</p>
          )}
        </div>
      </div>

      <ul
        aria-label={`Hallazgos sobre ${tema.titulo}`}
        class:list={[
          // Las tarjetas aparecen una tras otra al asomarse con el scroll (Aparecer).
          'aparece-hijos mt-6 grid gap-5 sm:grid-cols-2',
          !dosColumnas.includes(tema.slug) && 'lg:grid-cols-3',
        ]}
      >
        {hallazgos.map((h) => (
          <li class:list={['min-w-0', anchos.has(h.id) && 'sm:col-span-2']}>
            <!-- Ancho de la gráfica desde lg: media fila (468 px) o la fila entera (1024 px). -->
            <TarjetaVisor hallazgo={h} as="h4" encabezado anchoLg={anchos.has(h.id) ? 1024 : 468} />
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-temas-resultados]');
  const lista = raiz?.querySelector<HTMLElement>('[role="tablist"]');
  if (raiz && lista) {
    const pestanas = Array.from(lista.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const paneles = Array.from(raiz.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const encabezado = document.querySelector<HTMLElement>('[data-header]');
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Celular: el selector es un carrusel horizontal; al elegir un tema se desliza (animación
    // propia, ease-out) para dejarlo al inicio. En escritorio no hay desborde y no hace nada.
    const carrusel = lista.querySelector<HTMLElement>('[data-carrusel]')!;
    let cuadro = 0;
    const deslizar = (i: number, animar: boolean) => {
      cancelAnimationFrame(cuadro);
      const max = carrusel.scrollWidth - carrusel.clientWidth;
      if (max <= 0) return;
      const fin = Math.min(Math.max(pestanas[i]!.offsetLeft, 0), max);
      const ini = carrusel.scrollLeft;
      if (!animar || Math.abs(fin - ini) < 1) {
        carrusel.scrollLeft = fin;
        return;
      }
      const t0 = performance.now();
      const paso = (ahora: number) => {
        const p = Math.min((ahora - t0) / 450, 1);
        carrusel.scrollLeft = ini + (fin - ini) * (1 - Math.pow(1 - p, 3));
        if (p < 1) cuadro = requestAnimationFrame(paso);
      };
      cuadro = requestAnimationFrame(paso);
    };
    let primera = true;

    const elegir = (i: number, enfocar = false) => {
      pestanas.forEach((p, k) => {
        const activa = k === i;
        p.setAttribute('aria-selected', String(activa));
        p.tabIndex = activa ? 0 : -1;
        paneles[k]!.hidden = !activa;
      });
      deslizar(i, !primera && !reducido.matches);
      primera = false;
      if (enfocar) pestanas[i]!.focus({ preventScroll: true });
    };

    // La ilustración de un tema se pide al pasar el mouse, enfocar o tocar su pestaña:
    // así la página pesa menos al abrir y no aparece tarde al cambiar de tema.
    const precargar = (e: Event) => {
      const el = (e.target as Element).closest<HTMLElement>('[data-tema]');
      const slug = el?.dataset.tema;
      raiz.querySelectorAll<HTMLImageElement>(`[data-panel="${slug}"] img[loading="lazy"]`).forEach((img) => (img.loading = 'eager'));
    };
    for (const tipo of ['pointerover', 'focusin', 'touchstart']) {
      raiz.addEventListener(tipo, precargar, { passive: true });
    }

    lista.hidden = false;
    const porHash = (hash: string) => pestanas.findIndex((p) => `#${p.dataset.tema}` === hash);
    // Abre el tema del hash y baja hasta el selector.
    const irA = (i: number) => {
      elegir(i);
      raiz.scrollIntoView({ block: 'start' });
    };
    const inicial = porHash(location.hash);
    elegir(Math.max(inicial, 0));
    if (inicial >= 0) requestAnimationFrame(() => raiz.scrollIntoView({ block: 'start' }));
    // Con el selector pegado arriba, al cambiar de tema se vuelve al inicio del tema (si no,
    // se quedaría a mitad del anterior).
    const subirSiPegado = () => {
      if (lista.hasAttribute('data-pegado')) raiz.scrollIntoView({ block: 'start' });
    };
    // Enlaces a /resultados#<slug> desde esta misma página (menú, desplegable): se atienden
    // aquí para que también bajen cuando el hash ya es el actual.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
      if (!a || a.pathname !== location.pathname) return;
      const i = porHash(a.hash);
      if (i < 0) return;
      e.preventDefault();
      if (a.hash !== location.hash) history.pushState(null, '', a.hash);
      requestAnimationFrame(() => irA(i));
    });
    // Atrás / adelante del navegador o un hash escrito en la barra de direcciones.
    addEventListener('popstate', () => {
      const i = porHash(location.hash);
      if (i >= 0) irA(i);
    });

    lista.addEventListener('click', (e) => {
      const p = (e.target as Element).closest<HTMLButtonElement>('[role="tab"]');
      if (!p) return;
      elegir(pestanas.indexOf(p));
      history.replaceState(history.state, '', `#${p.dataset.tema}`);
      subirSiPegado();
    });
    lista.addEventListener('keydown', (e) => {
      const i = pestanas.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const n = pestanas.length;
      const destino =
        e.key === 'ArrowRight' || e.key === 'ArrowDown'
          ? (i + 1) % n
          : e.key === 'ArrowLeft' || e.key === 'ArrowUp'
            ? (i - 1 + n) % n
            : e.key === 'Home'
              ? 0
              : e.key === 'End'
                ? n - 1
                : -1;
      if (destino < 0) return;
      e.preventDefault();
      elegir(destino, true);
      history.replaceState(history.state, '', `#${pestanas[destino]!.dataset.tema}`);
      subirSiPegado();
    });

    // El selector está pegado cuando llegó al header (sticky) y aún quedan temas.
    const ubicar = () => {
      const tope = encabezado?.getBoundingClientRect().bottom ?? 0;
      const r = raiz.getBoundingClientRect();
      const pegado = lista.getBoundingClientRect().top <= tope + 1 && r.top < tope;
      lista.toggleAttribute('data-pegado', pegado);
    };
    addEventListener('scroll', ubicar, { passive: true });
    addEventListener('resize', ubicar);
    ubicar();
  }
</script>

<style>
  /*
   * Selector de temas (escritorio): una tarjeta del mismo ancho que el contenido, con esquinas
   * muy redondeadas, como la maqueta. Siempre tiene fondo; al quedar pegado bajo el header
   * también gana sombra. El fondo es el vidrio azul noche de la lista de temas de Explora
   * (ExploraTemas.astro, .explora-lista). En celular no cambia.
   */
  .selector-temas {
    transition: box-shadow 0.2s;
    background: rgba(19, 28, 48, 0.97);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border-radius: 2.5rem;
    padding: 12px;
    gap: 8px;
  }
  /* Celular: carrusel horizontal sin barra de scroll. */
  .carrusel-temas {
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .carrusel-temas::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 48rem) {
    .selector-temas {
      padding: 12px;
      gap: 12px;
    }
  }
  .selector-temas[data-pegado] {
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.3);
  }
</style>
