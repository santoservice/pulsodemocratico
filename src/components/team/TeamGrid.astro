---
import { Icon } from 'astro-icon/components';
import TeamAvatar from './TeamAvatar.astro';
import TeamContacts from './TeamContacts.astro';
import { equipo } from '../../data/equipo';

/**
 * Equipo de trabajo: tarjetas (foto, nombre, institución, ORCID, correo). Toda la tarjeta
 * abre un <dialog> nativo con el perfil completo, como panel lateral derecho sobre un fondo
 * difuminado (maqueta). El botón del nombre se estira sobre la tarjeta; ORCID y correos quedan
 * encima y siguen siendo enlaces propios.
 */
export interface Props {
  /** id del título de la sección (para nombrar la lista). */
  labelledby?: string;
}

const { labelledby } = Astro.props;
---

<ul aria-labelledby={labelledby} class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {equipo.map((p) => (
    <li class="group relative flex cursor-pointer gap-5 rounded-2xl bg-(--glass-fill) p-5 transition duration-200 ease-out hover:-translate-y-1 hover:shadow-lg active:translate-y-0 active:scale-[0.98] active:shadow-sm motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:active:scale-100">
      <!-- Foto y, debajo, «Ver perfil»: así no queda un hueco vacío abajo en las tarjetas con menos texto. -->
      <div class="flex shrink-0 flex-col items-center gap-4">
        <div class="transition-transform duration-200 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100">
          <TeamAvatar persona={p} />
        </div>
        <!-- Aspecto de botón primario (crema); el clic lo recibe el botón del nombre, que cubre la tarjeta. -->
        <p
          class="inline-flex items-center gap-1.5 rounded-full bg-cream px-4 py-1.5 text-sm font-bold text-navy shadow-sm transition-colors group-hover:bg-white"
          aria-hidden="true"
        >
          Ver perfil
          <Icon
            name="lucide:arrow-right"
            class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
          />
        </p>
      </div>
      <div class="flex min-w-0 flex-1 flex-col">
        <h3 class="text-lg leading-snug font-bold text-white">
          <button
            type="button"
            class="text-left after:absolute after:inset-0 after:content-[''] focus-visible:outline-none focus-visible:after:outline-3 focus-visible:after:outline-offset-2 focus-visible:after:outline-focus"
            aria-haspopup="dialog"
            data-dialog-open={`perfil-${p.slug}`}
          >
            {p.nombre}
            <span class="sr-only">: ver perfil completo</span>
          </button>
        </h3>
        <p class="mt-1 text-sm leading-snug text-white">{p.institucion}</p>
        <TeamContacts
          persona={p}
          class="mt-3 [&_a]:text-white [&_a]:decoration-white/40 [&_svg]:text-white [&_span[data-correo]]:text-white"
        />
      </div>
    </li>
  ))}
</ul>

{equipo.map((p) => (
  <dialog
    id={`perfil-${p.slug}`}
    aria-labelledby={`perfil-${p.slug}-titulo`}
    data-perfil
    class="perfil-panel"
  >
    <div class="flex h-full flex-col gap-3 overflow-y-auto p-3 md:p-4">
      <div class="flex items-center justify-between gap-4 rounded-2xl bg-(--glass-fill) p-5">
        <div class="min-w-0">
          <p class="text-xs font-bold tracking-[0.18em] text-white uppercase">Equipo de trabajo</p>
          <h2
            id={`perfil-${p.slug}-titulo`}
            class="mt-1 text-2xl leading-tight font-bold text-[#F7EFD9]"
          >
            {p.nombre}
          </h2>
        </div>
        <button
          type="button"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-cream text-navy shadow-md transition-transform hover:scale-105"
          data-dialog-close
        >
          <Icon name="lucide:x" class="h-5 w-5" aria-hidden="true" />
          <span class="sr-only">Cerrar</span>
        </button>
      </div>

      <div class="flex items-center gap-5 rounded-2xl bg-(--glass-fill) p-5">
        <TeamAvatar persona={p} size="lg" />
        <div class="min-w-0">
          <p class="text-xs font-bold tracking-[0.18em] text-[#D9E1EF] uppercase">Institución</p>
          <p class="mt-1 text-lg leading-snug font-bold text-white">{p.institucion}</p>
        </div>
      </div>

      <div class="rounded-2xl bg-(--glass-fill) p-5">
        <p class="text-xs font-bold tracking-[0.18em] text-[#D9E1EF] uppercase">Contacto</p>
        <TeamContacts persona={p} completo class="mt-3 text-white" />
      </div>

      <div class="rounded-2xl bg-(--glass-fill) p-5">
        <p class="text-xs font-bold tracking-[0.18em] text-[#D9E1EF] uppercase">Perfil</p>
        <p class="mt-3 leading-relaxed text-white">{p.perfil}</p>
      </div>
    </div>
  </dialog>
))}

<style>
  /* Panel lateral derecho: entra desde la derecha y el fondo se difumina (como la maqueta). */
  .perfil-panel {
    margin: 0 0 0 auto;
    inset: 0 0 0 auto;
    width: min(520px, 100%);
    max-width: 100%;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    /* Sin color propio: solo se ve el fondo difuminado detrás (sin línea ni sombra en el borde). */
    background: transparent;
    color: var(--color-ink);
    transform: translateX(100%);
    transition:
      transform 480ms cubic-bezier(0.23, 1, 0.32, 1),
      overlay 480ms allow-discrete,
      display 480ms allow-discrete;
  }
  .perfil-panel[open] {
    transform: none;
  }
  @starting-style {
    .perfil-panel[open] {
      transform: translateX(100%);
    }
  }
  /* El blur va en el fondo de toda la pantalla (no en el panel): así no se corta en el borde del panel. */
  .perfil-panel::backdrop {
    background: rgb(0 16 46 / 0.35);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
    backdrop-filter: blur(22px) saturate(1.3);
    transition:
      background-color 480ms,
      overlay 480ms allow-discrete,
      display 480ms allow-discrete;
  }
  @starting-style {
    .perfil-panel[open]::backdrop {
      background-color: rgb(0 16 46 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .perfil-panel,
    .perfil-panel::backdrop {
      transition: none;
    }
  }
</style>

<script>
  // Correos: arma el mailto en el navegador (el HTML no trae la dirección completa).
  document.querySelectorAll<HTMLElement>('[data-correo]').forEach((el) => {
    const correo = `${el.dataset.u}@${el.dataset.d}`;
    const a = document.createElement('a');
    a.href = `mailto:${correo}`;
    a.textContent = correo;
    a.className = 'text-accent underline-offset-4 hover:underline';
    el.replaceWith(a);
  });

  // Copiar correo (perfil): avisa «Copiado» un momento en el mismo botón.
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((btn) => {
    const texto = btn.querySelector<HTMLElement>('[data-copiar-texto]');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(`${btn.dataset.u}@${btn.dataset.d}`);
        if (texto) texto.textContent = 'Copiado';
      } catch {
        if (texto) texto.textContent = 'No se pudo copiar';
      }
      window.setTimeout(() => texto && (texto.textContent = 'Copiar'), 1800);
    });
  });

  // Perfil en <dialog> nativo: showModal() atrapa el foco y Esc lo cierra; al cerrar, el foco
  // vuelve al botón que lo abrió.
  document.querySelectorAll<HTMLButtonElement>('[data-dialog-open]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.dialogOpen ?? '');
    if (!(dialog instanceof HTMLDialogElement)) return;
    btn.addEventListener('click', () => {
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-dialog-close]')?.focus();
    });
    dialog.addEventListener('close', () => btn.focus());
  });

  document.querySelectorAll<HTMLDialogElement>('dialog[data-perfil]').forEach((dialog) => {
    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
    // Clic en el fondo difuminado (fuera del panel) cierra.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
