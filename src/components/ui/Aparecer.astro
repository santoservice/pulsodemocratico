---
/**
 * Entrada escalonada de la página (como `rise()` de la maqueta): los bloques marcados suben un poco
 * y aparecen uno tras otro, de arriba hacia abajo. Los que están en pantalla entran al abrir la
 * página; los de más abajo, al asomarse con el scroll (basta un 5 % visible). Solo entran: al volver
 * hacia arriba no se ocultan.
 * Marcas: clase `aparece` (el elemento) o `aparece-hijos` (cada hijo directo).
 * - `data-desde="izq|der|arriba|abajo"` en el elemento: llega desde ese lado (por defecto, sube).
 * - `aparece-rapido` en el elemento o un ancestro: entrada más corta y más seguida.
 * - `data-disperso` con `--ox`, `--oy` (desplazamiento) y `--or` (giro): llega de lejos, girado,
 *   más chico y borroso, y frena al llegar (como los logos de «Una iniciativa de»).
 * Sin JS o con movimiento reducido todo se ve de una vez.
 */
---

<script>
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = [...document.querySelectorAll<HTMLElement>('.aparece, .aparece-hijos > *')];
  if (!reducido && els.length && 'IntersectionObserver' in window) {
    els.forEach((el) => el.classList.add('aparece-oculto'));
    const io = new IntersectionObserver(
      (entradas) => {
        // Los que entran juntos van en orden de arriba hacia abajo (y de izquierda a derecha).
        entradas
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top || a.boundingClientRect.left - b.boundingClientRect.left)
          .forEach((e, i) => {
            const el = e.target as HTMLElement;
            io.unobserve(el);
            const paso = el.closest('.aparece-rapido') ? 60 : el.hasAttribute('data-disperso') ? 110 : 80;
            el.style.transitionDelay = `${i * paso}ms`;
            el.classList.add('aparece-visto');
            el.addEventListener('transitionend', () => (el.style.transitionDelay = ''), { once: true });
          });
      },
      { threshold: 0.05 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  .aparece-oculto {
    opacity: 0;
    transform: translateY(24px);
  }
  .aparece-oculto[data-desde='izq'] {
    transform: translateX(-64px);
  }
  .aparece-oculto[data-desde='der'] {
    transform: translateX(64px);
  }
  .aparece-oculto[data-desde='arriba'] {
    transform: translateY(-48px);
  }
  .aparece-oculto[data-desde='abajo'] {
    transform: translateY(48px);
  }
  .aparece-oculto[data-disperso] {
    transform: translate(var(--ox, 0), var(--oy, 0)) rotate(var(--or, 0deg)) scale(0.9);
    filter: blur(6px);
  }
  .aparece-oculto.aparece-visto {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .aparece-rapido .aparece-oculto.aparece-visto,
  .aparece-rapido.aparece-oculto.aparece-visto {
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .aparece-oculto[data-disperso].aparece-visto {
    filter: none;
    transition:
      opacity 0.8s ease-out,
      filter 0.9s ease-out,
      transform 1.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>
