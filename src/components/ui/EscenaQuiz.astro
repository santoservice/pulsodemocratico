---
/**
 * Sección del quiz (Inicio). En escritorio es una escena que se queda fija mientras se hace
 * scroll: primero solo el título grande y «Tú» al lado; al seguir bajando, el título se achica,
 * «Tú» se mueve debajo del texto y la tarjeta del quiz se abre a la derecha como un círculo que
 * crece desde el botón «Hacer test». Luego la sección sigue su scroll normal. En celular, sin JS o
 * con movimiento reducido: todo visible y apilado, sin botón.
 */
import { Icon } from 'astro-icon/components';
import Quiz from '../islands/Quiz';
import { quiz } from '../../data/quiz';
import { PROMEDIO_ENCUESTADOS } from '../../lib/quiz';
import { titulo } from '../../lib/format';

// En escritorio el título va en dos líneas fijas («¿Dónde te ubicas» / «frente al resto del país?»).
const tituloQuiz = titulo(quiz.titulo);
const corte = tituloQuiz.search(/ frente /i);
const lineas = corte > 0 ? [tituloQuiz.slice(0, corte), tituloQuiz.slice(corte + 1)] : [tituloQuiz];
---

<section
  aria-labelledby="quiz-titulo"
  class="quiz-escena"
  data-quiz-escena
>
  <div class="quiz-escenario">
    <div
      class="container-page relative grid gap-8 py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-center lg:gap-16"
      data-quiz-grilla
    >
      <div class="quiz-intro relative" data-quiz-intro>
        <div class="quiz-texto w-fit" data-quiz-texto>
          <h2 id="quiz-titulo" class="text-3xl leading-tight font-bold text-brand dark:text-white lg:text-[clamp(2rem,2.9vw,2.4rem)] lg:leading-[1.1]">
            {lineas.map((l) => <span class="lg:block lg:whitespace-nowrap">{l} </span>)}
          </h2>
          <p class="mt-4 max-w-md text-lg leading-relaxed text-ink lg:max-w-none">
            <span class="lg:block lg:whitespace-nowrap">
              Responde {quiz.preguntas.length} preguntas de la encuesta y compara tus
            </span>{' '}
            <span class="lg:block lg:whitespace-nowrap">respuestas con el {PROMEDIO_ENCUESTADOS}.</span>
          </p>
        </div>
        <p class="quiz-desvanece mt-4 flex items-center gap-2 text-sm text-ink-muted">
          <Icon name="lucide:info" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Toma 2 minutos. Tus respuestas no se guardan.
        </p>

        <figure class="mt-8 hidden w-fit lg:block" aria-hidden="true">
          <div class="quiz-tu flex w-24 flex-col items-center" data-quiz-tu>
            <span class="rounded-full bg-tu px-3 py-1 text-sm font-bold text-on-tu shadow-md">Tú</span>
            <!-- Persona tipo pictograma: cabeza y cuerpo con brazos y piernas separados por ranuras. -->
            <svg viewBox="0 0 100 140" class="mt-2 h-auto w-full">
              <ellipse cx="50" cy="133" rx="30" ry="4" class="fill-brand/15"></ellipse>
              <circle cx="50" cy="15" r="11" class="fill-tu"></circle>
              <path d="M38 30H62A14 14 0 0 1 76 44V75A4 4 0 0 1 68 75V48H65.5V127A7 7 0 0 1 51.5 127V88H48.5V127A7 7 0 0 1 34.5 127V48H32V75A4 4 0 0 1 24 75V44A14 14 0 0 1 38 30Z" class="fill-tu"></path>
            </svg>
          </div>
          <figcaption class="quiz-desvanece mt-3 max-w-60 text-sm leading-snug text-ink-muted">
            Este eres tú: te ubicaremos entre las personas encuestadas.
          </figcaption>
        </figure>
      </div>

      {/* Solo escritorio (escena fija): aparece difuminado desde abajo al acercarse y, al pulsarlo, lleva
          el scroll hasta la tarjeta, que se abre como un círculo desde este botón. */}
      <button
        type="button"
        data-quiz-ir
        class="quiz-ir rounded-full bg-[#5e8be0] px-6 py-2.5 text-base font-semibold text-(--color-tarjeta-visor) shadow-lg transition-colors hover:bg-white"
      >
        Hacer test
        <Icon name="lucide:arrow-right" class="h-4 w-4 shrink-0" aria-hidden="true" />
      </button>

      {/* Isla React (PLAN.md §6): el HTML de la 1.ª pregunta se pre-renderiza; el JS carga al llegar aquí. */}
      <div class="quiz-tarjeta">
        <Quiz client:visible preguntas={quiz.preguntas} />
        <noscript>
          <p class="mt-3 text-sm text-ink-muted">Activa JavaScript para responder el cuestionario.</p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * --p: avance del título y de «Tú» (0 = escena inicial, 1 = posición final).
   * --q: entrada de la tarjeta y de los textos secundarios. Por defecto 1 (todo en su sitio).
   * --dx/--dy/--ax/--ay: desplazamientos iniciales medidos por el script.
   */
  .quiz-escena {
    --p: 1;
    --q: 1;
  }

  @media (min-width: 64rem) {
    .quiz-escena[data-pin] {
      /* Alto de la pantalla + recorrido en el que la escena queda fija (= RECORRIDO del script). */
      height: calc(100vh + 190vh);
    }
    .quiz-escena[data-pin] .quiz-escenario {
      position: sticky;
      top: 4.3rem;
      display: flex;
      height: calc(100vh - 4.3rem);
      align-items: center;
    }
    .quiz-escena[data-pin] .quiz-escenario > div {
      width: 100%;
      /* Menos aire arriba/abajo: la tarjeta (con su resultado) debe caber en la pantalla. */
      padding-block: 1rem;
    }
    .quiz-intro {
      translate: calc(var(--dx, 0px) * (1 - var(--p))) calc(var(--dy, 0px) * (1 - var(--p)));
    }
    .quiz-texto {
      transform-origin: left center;
      scale: calc(1 + 0.35 * (1 - var(--p)));
    }
    /* «Tú» va de la derecha a la izquierda en curva: baja un poco más (--tuc) y sube a su sitio. */
    .quiz-tu {
      scale: calc(1 + 0.4 * (1 - var(--p)));
      translate: calc(var(--ax, 0px) * (1 - var(--tux, 1)))
        calc(var(--ay, 0px) * (1 - var(--tuy, 1)) + var(--tuc, 0px));
    }
    .quiz-desvanece {
      opacity: var(--q);
    }
    /* La tarjeta se abre como un círculo que crece desde el botón (--cx/--cy, en px de la tarjeta;
       --cr = radio, lo calcula el script con --q). Al terminar se quita la máscara. */
    .quiz-escena[data-circulo] .quiz-tarjeta {
      clip-path: circle(var(--cr, 0px) at var(--cx, 0px) var(--cy, 0px));
    }
    .quiz-escena[data-oculta] .quiz-tarjeta {
      visibility: hidden;
    }

    /* Botón «Hacer test», alineado a la izquierda del texto (--bx y --by los mide el script). --bi (0–1) lo
       es su opacidad (siempre 1 hasta que asoma el círculo); --bs (0–1) lo sube desde abajo hasta su sitio.
       Solo se puede pulsar cuando ya se ve (data-listo), antes de que la escena termine de llegar. */
    .quiz-escena[data-pin] .quiz-ir {
      position: absolute;
      left: var(--bx, 50%);
      top: var(--by, 60%);
      z-index: 5;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      opacity: var(--bi, 0);
      translate: 0 calc((1 - var(--bs, 1)) * 2.5rem);
      visibility: hidden;
      pointer-events: none;
    }
    .quiz-escena[data-pin] .quiz-ir[data-visible] {
      visibility: visible;
    }
    .quiz-escena[data-pin] .quiz-ir[data-listo] {
      pointer-events: auto;
    }
  }
  .quiz-ir {
    display: none;
  }
</style>

<script>
  // Debe coincidir con los `scale` iniciales del CSS.
  const ESCALA_TEXTO = 1.35;
  const ESCALA_TU = 1.4;
  const SEPARACION = 72;
  const TOPE = 69; // alto del header fijo (4 + 64 + 1 px)
  const CURVA = 48; // px que «Tú» baja de más a mitad de camino
  const SUAVIZADO = 0.14; // fracción del camino que se recorre por cuadro
  // Tramos del recorrido fijo, en vh de scroll (deben sumar el alto extra del CSS: 190vh).
  // Tras la entrada de la tarjeta queda un tramo quieto para no saltarse el quiz por accidente.
  const RECORRIDO = 190;
  const PAUSA = 40; // escena inicial quieta
  const TRANSICION = 96; // título y «Tú» a su sitio
  const ENTRA_TARJETA = 44; // el círculo de la tarjeta empieza a abrirse
  const DURA_TARJETA = 92; // y termina con la transición (44 + 92 = 136)
  // Botón «Hacer test»: siempre visible; sube a su sitio hasta 20 vh después de fijarse la escena y se va entre 44 y 56, justo cuando empieza a abrirse el círculo.
  const BOTON_LLEGA = 20;
  const BOTON_SALE_INI = ENTRA_TARJETA; // se queda hasta que el círculo asoma
  const BOTON_SALE_FIN = 56;
  const BOTON_LISTO = 0.3; // opacidad desde la que ya se puede pulsar
  const META_CLIC = 140; // al pulsarlo se baja hasta aquí (tarjeta ya entera)

  const escena = document.querySelector<HTMLElement>('[data-quiz-escena]');
  const grilla = escena?.querySelector<HTMLElement>('[data-quiz-grilla]');
  const intro = escena?.querySelector<HTMLElement>('[data-quiz-intro]');
  const texto = escena?.querySelector<HTMLElement>('[data-quiz-texto]');
  const tu = escena?.querySelector<HTMLElement>('[data-quiz-tu]');
  const ir = escena?.querySelector<HTMLButtonElement>('[data-quiz-ir]');
  const tarjeta = escena?.querySelector<HTMLElement>('.quiz-tarjeta');
  const escritorio = window.matchMedia('(min-width: 64rem)');
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (escena && grilla && intro && texto && tu && ir && tarjeta) {
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const suave = (v: number) => v * v * (3 - 2 * v);
    const fijar = (k: string, v: number) => escena.style.setProperty(k, `${v}px`);
    // Centro del botón: desde el borde de la escena (desfase) y dentro de la tarjeta (cx, cy).
    let desfase = 0;
    let cx = 0;
    let cy = 0;

    // Posición inicial: título (agrandado) y «Tú» lado a lado, centrados en la escena.
    // Se mide con offset* (sin los transforms, relativo a la columna) en el layout final.
    const medir = () => {
      const g = getComputedStyle(grilla);
      const ancho = grilla.clientWidth - parseFloat(g.paddingLeft) - parseFloat(g.paddingRight);
      const anchoTexto = texto.offsetWidth * ESCALA_TEXTO;
      const anchoTu = tu.offsetWidth * ESCALA_TU;
      const centroTexto = texto.offsetTop + texto.offsetHeight / 2;
      fijar('--ax', anchoTexto + SEPARACION + (anchoTu - tu.offsetWidth) / 2 - tu.offsetLeft);
      fijar('--ay', centroTexto - (tu.offsetTop + tu.offsetHeight / 2));
      const dx = Math.max(0, (ancho - (anchoTexto + SEPARACION + anchoTu)) / 2);
      fijar('--dx', dx);
      fijar('--dy', grilla.clientHeight / 2 - (intro.offsetTop + centroTexto));
      // Botón: centrado, justo debajo del título y «Tú» (que en la escena inicial quedan centrados).
      const alto = Math.max(texto.offsetHeight * ESCALA_TEXTO, tu.offsetHeight * ESCALA_TU);
      const por = grilla.clientHeight / 2 + alto / 2 + 40;
      const centroY = por + ir.offsetHeight / 2;
      fijar('--by', por);
      // Alineado a la izquierda del texto (título y párrafo): su borde izquierdo es el del texto.
      const px = intro.offsetLeft + dx + texto.offsetLeft;
      fijar('--bx', px);
      desfase = grilla.offsetTop + centroY;
      cx = px + ir.offsetWidth / 2 - tarjeta.offsetLeft;
      cy = centroY - tarjeta.offsetTop;
      fijar('--cx', cx);
      fijar('--cy', cy);
    };

    // Radio que cubre toda la tarjeta desde el centro del botón (con su alto actual).
    const radioMax = () => {
      const w = tarjeta.offsetWidth;
      const h = tarjeta.offsetHeight;
      return Math.max(Math.hypot(cx, cy), Math.hypot(w - cx, cy), Math.hypot(cx, h - cy), Math.hypot(w - cx, h - cy)) + 2;
    };

    const objetivo = () => {
      const recorrido = escena.offsetHeight - (window.innerHeight - TOPE);
      return clamp((TOPE - escena.getBoundingClientRect().top) / recorrido);
    };

    const pintar = (t: number) => {
      // Pausa en la escena inicial, transición, entrada de la tarjeta y luego quieta y lista
      // (≈ 54vh de scroll antes de que la escena se suelte).
      const vh = t * RECORRIDO;
      const avance = clamp((vh - PAUSA) / TRANSICION);
      const p = suave(avance);
      const q = suave(clamp((vh - ENTRA_TARJETA) / DURA_TARJETA));
      escena.style.setProperty('--p', String(p));
      // «Tú»: el alto se adelanta un poco al lado, y en la mitad del camino baja CURVA px de más.
      escena.style.setProperty('--tuy', String(suave(clamp(avance / 0.85))));
      escena.style.setProperty('--tux', String(p));
      fijar('--tuc', CURVA * Math.sin(Math.PI * avance));
      escena.style.setProperty('--q', String(q));
      escena.toggleAttribute('data-oculta', q < 0.002);
      // Tarjeta: círculo que crece desde el botón; al terminar se quita la máscara.
      escena.toggleAttribute('data-circulo', q < 0.999);
      if (q < 0.999) fijar('--cr', q * radioMax());

      // Botón: aparece con el scroll (aun antes de fijarse la escena) y se va al empezar la transición.
      const alturaVentana = window.innerHeight;
      const s = TOPE - escena.getBoundingClientRect().top; // px desde que la escena se fija
      const desde = -(0.97 * alturaVentana - TOPE - desfase); // el botón asoma por abajo
      const hasta = (BOTON_LLEGA / 100) * alturaVentana;
      const llega = suave(clamp((s - desde) / (hasta - desde)));
      const sale = suave(clamp((vh - BOTON_SALE_INI) / (BOTON_SALE_FIN - BOTON_SALE_INI)));
      // Siempre visible (opaco); con el scroll sube un poco hasta su sitio (--bs) y se va con el círculo.
      const bi = 1 - sale;
      escena.style.setProperty('--bi', String(bi));
      escena.style.setProperty('--bs', String(llega));
      ir.toggleAttribute('data-visible', bi > 0.02);
      ir.toggleAttribute('data-listo', bi >= BOTON_LISTO);
    };

    // El dibujo sigue al scroll con suavizado (no salta con cada golpe de la rueda del mouse).
    let actual = 0;
    let animando = false;
    const paso = () => {
      const meta = objetivo();
      actual += (meta - actual) * SUAVIZADO;
      if (Math.abs(meta - actual) < 0.0005) actual = meta;
      pintar(actual);
      animando = actual !== meta;
      if (animando) requestAnimationFrame(paso);
    };
    const programar = () => {
      if (animando) return;
      animando = true;
      requestAnimationFrame(paso);
    };
    const actualizar = () => {
      actual = objetivo();
      pintar(actual);
    };

    const configurar = () => {
      const activa = escritorio.matches && !reducido.matches;
      escena.toggleAttribute('data-pin', activa);
      if (!activa) {
        for (const k of ['--p', '--q', '--dx', '--dy', '--ax', '--ay', '--tux', '--tuy', '--tuc', '--by', '--bx', '--cx', '--cy', '--cr', '--bi', '--bs'])
          escena.style.removeProperty(k);
        escena.removeAttribute('data-oculta');
        escena.removeAttribute('data-circulo');
        window.removeEventListener('scroll', programar);
        return;
      }
      escena.style.setProperty('--p', '1');
      medir();
      actualizar();
      window.addEventListener('scroll', programar, { passive: true });
    };

    // «Hacer test»: baja el scroll (animación propia, el smooth nativo se entrecorta) hasta que la
    // tarjeta ya está entera; de paso se reproduce toda la escena. Un gesto del usuario la corta.
    // - Arranca rápido (ease-out): con una curva lenta al inicio parecía que el botón no respondía.
    // - La rueda no corta en los primeros 600 ms: la inercia del trackpad de un scroll anterior
    //   (p. ej. subir) llegaba como «rueda» y cancelaba la animación apenas empezaba.
    // - Un clic nuevo reemplaza la animación en curso en vez de ignorarse.
    // - Con el mouse se activa al pulsar (pointerdown): mientras la página aún se mueve, el botón se
    //   desplaza bajo el cursor y el clic (pulsar + soltar sobre el mismo elemento) se perdía.
    const GRACIA_RUEDA = 600;
    let detener = () => {};
    const bajar = () => {
      detener();
      const recorrido = escena.offsetHeight - (window.innerHeight - TOPE);
      const inicioDoc = escena.getBoundingClientRect().top + window.scrollY - TOPE;
      const destino = inicioDoc + recorrido * (META_CLIC / RECORRIDO);
      const ini = window.scrollY;
      const dist = destino - ini;
      const enfocar = () => tarjeta.querySelector<HTMLElement>('h3')?.focus({ preventScroll: true });
      if (Math.abs(dist) < 4) return enfocar();
      const dur = Math.min(1300, Math.max(700, Math.abs(dist) * 0.9));
      const t0 = performance.now();
      let activa = true;
      const eventos = ['wheel', 'touchstart', 'keydown'] as const;
      const cortar = (e: Event) => {
        if (e.type === 'wheel' && performance.now() - t0 < GRACIA_RUEDA) return;
        detener();
      };
      detener = () => {
        activa = false;
        eventos.forEach((e) => window.removeEventListener(e, cortar));
      };
      eventos.forEach((e) => window.addEventListener(e, cortar, { passive: true }));
      const paso = (ahora: number) => {
        if (!activa) return;
        const p = Math.min((ahora - t0) / dur, 1);
        window.scrollTo({ top: ini + dist * (1 - Math.pow(1 - p, 3)), behavior: 'instant' });
        if (p < 1) return void requestAnimationFrame(paso);
        detener();
        enfocar();
      };
      requestAnimationFrame(paso);
    };
    ir.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || e.pointerType === 'touch') return;
      bajar();
    });
    // Teclado (Enter/Espacio, detail 0) y táctil; el clic de mouse ya se atendió en pointerdown.
    ir.addEventListener('click', (e) => {
      if (e.detail > 0 && (e as PointerEvent).pointerType !== 'touch') return;
      bajar();
    });

    configurar();
    // La tipografía y las imágenes de arriba cambian los anchos medidos: se mide otra vez al cargar.
    void document.fonts?.ready.then(configurar);
    window.addEventListener('load', configurar);
    window.addEventListener('resize', configurar);
    reducido.addEventListener('change', configurar);
  }
</script>
