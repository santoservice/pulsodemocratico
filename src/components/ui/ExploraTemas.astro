---
/**
 * "Explora los temas principales" (Inicio). En escritorio: título y menú de temas fijos a la
 * izquierda y las tarjetas, una debajo de otra, a la derecha; al hacer scroll, el tema cuya tarjeta
 * está en el centro de la pantalla se marca en el menú. En celular y tablet: una barra fija con el
 * tema que se ve (el nombre sube y entra el siguiente al hacer scroll) que despliega la lista de temas.
 * Gráfica de cada tema: su hallazgo principal del visor (src/lib/visor/principales.ts).
 */
import { Icon } from 'astro-icon/components';
import GraficaVisor from '../visor/GraficaVisor.astro';
import LinkButton from './LinkButton.astro';
import { temas, temaHref, type TemaSlug } from '../../data/temas';
import { titulo } from '../../lib/format';
import { principalPorTema } from '../../lib/visor/principales';

// Un tema por tarjeta, con su hallazgo principal del visor (el mismo de /resultados).
const items = temas.flatMap((tema) => {
  const h = principalPorTema(tema.slug);
  return h ? [{ tema, h }] : [];
});

// Gráficas altas: un poco más angostas (y, la de filas, más juntas) para que la tarjeta quepa
// en pantallas bajas. El SVG escala con el ancho, así que también baja de alto.
const compacta: Partial<Record<TemaSlug, string>> = {
  polarizacion: '[&>div]:max-w-[22rem]',
  'consumo-mediatico': '[&>div]:max-w-[22rem]',
  'comportamiento-juvenil': '[&>div]:max-w-[22rem] [&_[role=img]]:gap-1.5',
};
---

<section aria-labelledby="temas-titulo" class="explora" data-explora>
  <div
    class="container-page py-12 md:py-16 lg:grid lg:grid-cols-[19rem_minmax(0,1fr)] lg:gap-16"
    data-explora-grilla
  >
    <!-- En escritorio, título y menú van juntos en la columna izquierda y quedan fijos. -->
    <div class="lg:sticky lg:top-[calc(4.3rem+1.5rem)] lg:self-start" data-explora-columna>
      <!-- Intro (escritorio): el título entra grande y borroso al centro, se aclara y pasa a la izquierda. -->
      <div class="explora-titulo w-fit" data-explora-titulo>
        <h2 id="temas-titulo" class="text-3xl font-bold text-brand md:text-4xl lg:text-[2.6rem] lg:leading-[1.05]">
          <!-- Dos líneas fijas en escritorio (la segunda invade un poco el espacio entre columnas). -->
          <span class="lg:block">{titulo('Explora los')}</span>{' '}
          <span class="lg:block lg:whitespace-nowrap">temas principales</span>
        </h2>
        <p class="mt-3 text-ink-muted lg:max-w-[19rem]">Seis conversaciones clave para entender la percepción política.</p>
      </div>

      <nav aria-label="Temas" class="explora-nav mt-8 hidden lg:block">
        <ol class="flex flex-col gap-1">
          {
            items.map(({ tema }, i) => (
              <li class="explora-tab" style={`--i:${i}`}>
                <a
                  href={`#explora-${tema.slug}`}
                  data-explora-link={tema.slug}
                  class="group flex items-center justify-between gap-3 rounded-full px-6 py-4 text-lg font-semibold text-ink transition-[background-color,box-shadow,color] duration-300 hover:bg-white/60 data-[activo]:bg-white data-[activo]:text-brand data-[activo]:shadow-md data-[activo]:ring-4 data-[activo]:ring-white/60 dark:hover:bg-surface/60 dark:data-[activo]:bg-surface-sunken dark:data-[activo]:ring-surface-muted"
                >
                  {titulo(tema.titulo)}
                  <Icon
                    name={tema.icono}
                    aria-hidden="true"
                    class="h-6 w-6 shrink-0 text-serie-2 opacity-0 transition-opacity duration-300 group-data-[activo]:opacity-100"
                  />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>

    <!--
      Celular y tablet: barra pegada bajo el header mientras pasan las tarjetas (sticky dentro de la
      grilla). Dice el tema que se ve y, al tocarla, despliega la lista de temas.
    -->
    <div class="explora-franja sticky top-[69px] z-20 -mx-4 mt-8 px-4 md:-mx-8 md:px-8 lg:hidden" data-explora-barra>
      <button
        type="button"
        aria-expanded="false"
        aria-controls="explora-lista"
        data-explora-boton
        class="flex w-full items-center gap-3 py-3 text-left"
      >
        <span class="sr-only">Tema que estás viendo:</span>
        <!-- Nombres apilados: el actual al centro, los anteriores arriba y los siguientes abajo. -->
        <span class="relative block h-7 min-w-0 flex-1 overflow-hidden">
          {items.map(({ tema }, i) => (
            <span
              data-explora-nombre={tema.slug}
              data-pos={i === 0 ? 'actual' : 'abajo'}
              aria-hidden={i === 0 ? undefined : 'true'}
              class="explora-nombre absolute inset-0 truncate text-lg leading-7 font-bold text-cream"
            >
              {titulo(tema.titulo)}
            </span>
          ))}
        </span>
        <span class="sr-only">. Cambiar de tema</span>
        <span class="flex shrink-0 items-center text-ink" aria-hidden="true">
          <Icon name="lucide:chevron-down" data-explora-flecha class="h-5 w-5 transition-transform duration-200" />
        </span>
      </button>
      <ul id="explora-lista" hidden class="explora-lista mb-3 rounded-3xl px-4 py-2">
        {items.map(({ tema }) => (
          <li class="border-b border-white/10 last:border-b-0">
            <a
              href={`#explora-${tema.slug}`}
              data-explora-opcion={tema.slug}
              class="flex items-center gap-3 px-2 py-3.5 text-ink aria-[current=true]:font-bold aria-[current=true]:text-cream"
            >
              <span class="flex-1">{titulo(tema.titulo)}</span>
              <Icon name={tema.icono} class="h-5 w-5 shrink-0 text-serie-2" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Escritorio: mucho aire entre tarjetas para ver una a la vez, y la primera más abajo. -->
    <div class="explora-tarjetas mt-6 flex flex-col gap-8 lg:mt-0 lg:gap-[20vh] lg:pt-[18vh] lg:pb-[12vh]">
        {
          items.map(({ tema, h }) => (
            <article
              id={`explora-${tema.slug}`}
              data-explora-tarjeta={tema.slug}
              aria-labelledby={`explora-${tema.slug}-t`}
              class="explora-tarjeta scroll-mt-40 rounded-2xl lg:scroll-mt-28 border border-border bg-surface p-5 md:p-8"
            >
              <p class="text-xs font-bold tracking-[0.18em] text-serie-2 uppercase">{tema.titulo}</p>
              <h3 id={`explora-${tema.slug}-t`} class="mt-3 text-xl leading-snug font-bold text-brand md:text-2xl">
                {h.titulo}
              </h3>

              <!--
                Gráfica del hallazgo principal del tema (la misma de /resultados), en un panel propio
                (.explora-media) sin panel propio, con tonos claros como la maqueta; los rótulos se
                recortan con el color de la tarjeta (ver estilos). Sin frase destacada: solo gráfica, dato y pregunta.
              -->
              <div
                id={`explora-${tema.slug}-grafica`}
                class:list={['explora-media mt-6', compacta[tema.slug]]}
                data-descarga={`${h.id}-grafica`}
                data-titulo={h.titulo}
                data-tema={h.etiqueta}
              >
                <GraficaVisor hallazgo={h} uid={`e-${h.id}`} />
              </div>

              <div class="mt-6 flex flex-wrap items-center justify-end gap-3">
                <button
                  type="button"
                  data-tarjeta={`visor-${h.id}`}
                  aria-haspopup="dialog"
                  class="inline-flex items-center gap-2 rounded-full border border-border-strong px-5 py-2.5 font-semibold text-ink transition-colors hover:border-cream hover:bg-cream hover:text-navy"
                >
                  Ver detalle<span class="sr-only">: {h.titulo}</span>
                </button>
                <LinkButton href={temaHref(tema.slug)} icon="lucide:arrow-right" variant="primary">
                  Ver resultados<span class="sr-only"> de {tema.titulo}</span>
                </LinkButton>
              </div>
            </article>
          ))
        }
    </div>
  </div>
</section>

<style>
  /*
   * Intro en escritorio (data-intro, lo pone el script): --b = borroso (1 → 0), --m = paso a la
   * izquierda (0 = centrado y grande, 1 = en su sitio). --ex/--ey: desplazamiento medido.
   * Las tarjetas bajan para dejar el recorrido de la intro con la columna ya fija.
   */
  .explora {
    --b: 0;
    --m: 1;
  }
  @media (min-width: 64rem) {
    .explora[data-intro] .explora-titulo {
      transform-origin: left top;
      translate: calc(var(--ex, 0px) * (1 - var(--m))) calc(var(--ey, 0px) * (1 - var(--m)));
      scale: calc(1 + 0.6 * (1 - var(--m)));
      filter: blur(calc(var(--b) * 12px));
      opacity: calc(1 - 0.85 * var(--b));
      will-change: translate, scale, filter;
    }
    /* Menú: cada tema entra desde la izquierda y desvanecido, escalonado (el siguiente arranca
       0,1 de --m después) y a medida que baja el scroll, como el stagger de la maqueta. */
    .explora[data-intro] .explora-tab {
      --t: clamp(0, calc((var(--m) - var(--i) * 0.1) / 0.5), 1);
      opacity: var(--t);
      translate: calc((1 - var(--t)) * -3.75rem) 0;
    }
    .explora[data-intro] .explora-tarjetas {
      padding-top: 110vh;
    }
  }

  /*
   * Tarjeta como la maqueta (tema oscuro): vidrio azul noche sin borde y gráfica sin panel propio,
   * con marcas en blanco/azul claro. --color-surface imita el tono de la tarjeta para que los
   * contornos de rótulos y puntos de las gráficas lo igualen.
   */
  :global(:root[data-theme='dark']) .explora-tarjeta {
    background-color: rgb(19 28 48 / 0.75);
    border-color: transparent;
    --color-ink: #fafafa;
  }
  :global(:root[data-theme='dark']) .explora-media {
    --color-surface: #101a31; /* tono aproximado de la tarjeta (vidrio sobre la página) */
    --color-chart-accent: #d9e1ef;
    --color-chart-muted: #93aac9;
    --color-serie-1: #d9e1ef;
    --color-ink: #d9e1ef;
    --color-ink-muted: #b4c3da;
  }

  /* Barra de temas del celular, pegada al header: franja del color de la página con blur (como la
     maqueta) y lista de vidrio azul noche como las tarjetas. Sin bordes. */
  .explora-franja {
    background-color: color-mix(in srgb, var(--color-page) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .explora-lista {
    background-color: var(--color-surface);
  }
  :global(:root[data-theme='dark']) .explora-lista {
    background-color: rgb(19 28 48 / 0.95);
  }
  /* Nombre del tema: el que sale sube y el siguiente entra desde abajo (al revés si se sube). */
  .explora-nombre {
    transition:
      translate 0.45s cubic-bezier(0.23, 1, 0.32, 1),
      opacity 0.3s ease;
  }
  .explora-nombre[data-pos='arriba'] {
    translate: 0 -100%;
    opacity: 0;
  }
  .explora-nombre[data-pos='abajo'] {
    translate: 0 100%;
    opacity: 0;
  }

  /* Aparición suave de cada tarjeta al entrar en pantalla (solo con JS y sin movimiento reducido). */
  :global([data-explora-anim]) .explora-tarjeta {
    opacity: 0;
    translate: 0 2.5rem;
    transition:
      opacity 0.6s ease-out,
      translate 0.6s ease-out;
  }
  :global([data-explora-anim]) .explora-tarjeta[data-visible] {
    opacity: 1;
    translate: 0 0;
  }
</style>

<script>
  // ---- Intro del título (escritorio, sin movimiento reducido) ----
  // El título entra grande y borroso, centrado en la pantalla; se aclara al llegar arriba,
  // queda quieto un momento y luego pasa a su sitio a la izquierda (aparece el menú).
  {
    const ESCALA = 1.6; // = 1 + 0.6 del CSS
    const TOPE_FIJO = 93; // top del sticky: 4.3rem + 1.5rem
    const HEADER = 69;
    const SUAVIZADO = 0.14;
    const seccion = document.querySelector<HTMLElement>('[data-explora]');
    const grilla = seccion?.querySelector<HTMLElement>('[data-explora-grilla]');
    const columna = seccion?.querySelector<HTMLElement>('[data-explora-columna]');
    const bloque = seccion?.querySelector<HTMLElement>('[data-explora-titulo]');
    const escritorio = window.matchMedia('(min-width: 64rem)');
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (seccion && grilla && columna && bloque) {
      const clamp = (v: number) => Math.min(1, Math.max(0, v));
      const suave = (v: number) => v * v * (3 - 2 * v);
      let inicioDoc = 0; // top (en el documento) de la columna sin fijar
      let actual = window.scrollY;
      let animando = false;
      let activa = false;

      const medir = () => {
        const g = getComputedStyle(grilla);
        const r = grilla.getBoundingClientRect();
        inicioDoc = r.top + window.scrollY + parseFloat(g.paddingTop);
        const padL = parseFloat(g.paddingLeft);
        const centroX = r.left + padL + (grilla.clientWidth - padL - parseFloat(g.paddingRight)) / 2;
        const izq = columna.getBoundingClientRect().left;
        seccion.style.setProperty('--ex', `${centroX - izq - (bloque.offsetWidth * ESCALA) / 2}px`);
        const centroY = (HEADER + window.innerHeight) / 2;
        seccion.style.setProperty('--ey', `${centroY - TOPE_FIJO - (bloque.offsetHeight * ESCALA) / 2}px`);
      };

      const pintar = (y: number) => {
        const vh = window.innerHeight;
        const n = inicioDoc - y; // top de la columna en pantalla si no estuviera fija
        const pasado = TOPE_FIJO - n; // cuánto se ha bajado con la columna ya fija
        const b = 1 - clamp((vh * 0.95 - n) / (vh * 0.95 - TOPE_FIJO));
        // Pausa de 0,15 pantallas con el título aclarado; luego pasa a la izquierda en 0,35.
        const m = suave(clamp((pasado - vh * 0.15) / (vh * 0.35)));
        seccion.style.setProperty('--b', String(b));
        seccion.style.setProperty('--m', String(m));
      };

      const paso = () => {
        const meta = window.scrollY;
        actual += (meta - actual) * SUAVIZADO;
        if (Math.abs(meta - actual) < 0.5) actual = meta;
        pintar(actual);
        animando = actual !== meta;
        if (animando) requestAnimationFrame(paso);
      };
      const programar = () => {
        if (animando) return;
        animando = true;
        requestAnimationFrame(paso);
      };

      const configurar = () => {
        const debe = escritorio.matches && !reducido.matches;
        if (debe !== activa) {
          activa = debe;
          seccion.toggleAttribute('data-intro', activa);
          if (activa) window.addEventListener('scroll', programar, { passive: true });
          else window.removeEventListener('scroll', programar);
        }
        if (!activa) {
          for (const k of ['--b', '--m', '--ex', '--ey']) seccion.style.removeProperty(k);
          return;
        }
        // Se mide en la posición final (sin transformaciones).
        seccion.style.setProperty('--m', '1');
        seccion.style.setProperty('--b', '0');
        medir();
        actual = window.scrollY;
        pintar(actual);
      };

      configurar();
      window.addEventListener('resize', configurar);
      reducido.addEventListener('change', configurar);
      // Las imágenes/fuentes de arriba pueden mover la sección después de la carga.
      window.addEventListener('load', configurar);
    }
  }

  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-explora-tarjeta]')];
  const links = [...document.querySelectorAll<HTMLElement>('[data-explora-link]')];

  if (tarjetas.length && 'IntersectionObserver' in window) {
    const nombres = [...document.querySelectorAll<HTMLElement>('[data-explora-nombre]')];
    const opciones = [...document.querySelectorAll<HTMLElement>('[data-explora-opcion]')];
    const activar = (slug: string) => {
      links.forEach((a) => a.toggleAttribute('data-activo', a.dataset.exploraLink === slug));
      // Barra del celular: los nombres antes del actual quedan arriba y los siguientes abajo.
      const k = nombres.findIndex((n) => n.dataset.exploraNombre === slug);
      nombres.forEach((n, i) => {
        n.dataset.pos = i < k ? 'arriba' : i > k ? 'abajo' : 'actual';
        n.toggleAttribute('aria-hidden', i !== k);
      });
      opciones.forEach((o) => o.setAttribute('aria-current', String(o.dataset.exploraOpcion === slug)));
    };

    // Tema activo: la última tarjeta que ya llegó a la mitad de la pantalla.
    let pendiente = false;
    const actualizar = () => {
      pendiente = false;
      const mitad = window.innerHeight / 2;
      let activa = tarjetas[0]!;
      for (const t of tarjetas) if (t.getBoundingClientRect().top <= mitad) activa = t;
      activar(activa.dataset.exploraTarjeta!);
    };
    const programar = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(actualizar);
    };

    actualizar();
    window.addEventListener('scroll', programar, { passive: true });

    // Lista desplegable de la barra del celular; al elegir un tema, el enlace baja a su tarjeta.
    const barra = document.querySelector<HTMLElement>('[data-explora-barra]');
    const boton = barra?.querySelector<HTMLButtonElement>('[data-explora-boton]');
    const lista = document.getElementById('explora-lista');
    const flecha = barra?.querySelector<SVGElement>('[data-explora-flecha]');
    if (barra && boton && lista) {
      const abrir = (si: boolean) => {
        lista.hidden = !si;
        boton.setAttribute('aria-expanded', String(si));
        if (flecha) flecha.style.rotate = si ? '180deg' : '';
      };
      boton.addEventListener('click', () => abrir(lista.hidden));
      lista.addEventListener('click', () => abrir(false));
      document.addEventListener('click', (e) => {
        if (!lista.hidden && !barra.contains(e.target as Node)) abrir(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lista.hidden) {
          abrir(false);
          boton.focus();
        }
      });
    }
    window.addEventListener('resize', programar);

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.toggleAttribute('data-explora-anim', true);
      const aparicion = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            e.target.toggleAttribute('data-visible', true);
            aparicion.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      tarjetas.forEach((t) => aparicion.observe(t));
    }
  }
</script>