---
/**
 * "Explora los temas principales" (Inicio). En escritorio: menú de temas fijo a la
 * izquierda y una tarjeta por tema a la derecha; al hacer scroll, el tema cuya tarjeta
 * está en el centro de la pantalla se marca en el menú. En celular: solo las tarjetas.
 * Datos y gráficas de cada tema: src/data/explora.ts.
 */
import { Icon } from 'astro-icon/components';
import BarChart from '../charts/BarChart.astro';
import Columnas from '../charts/Columnas.astro';
import EscalaRondas from '../charts/EscalaRondas.astro';
import SlopeChart from '../charts/SlopeChart.astro';
import Waffle from '../charts/Waffle.astro';
import LinkButton from './LinkButton.astro';
import { explora, type ItemExplora } from '../../data/explora';
import { getTemaBySlug, temaHref } from '../../data/temas';
import { decimal, entero, pct, titulo } from '../../lib/format';
import { getIndicador, getUltimoValor, type Indicador } from '../../lib/tablero';

function indicador(key: string): Indicador {
  const ind = getIndicador(key);
  if (!ind) throw new Error(`src/data/explora.ts: no existe el indicador "${key}" en tablero.json`);
  return ind;
}

function cifra(item: ItemExplora) {
  const ind = indicador(item.dato.indicador);
  const g = item.dato.grupo;
  const valor = g
    ? ind.cruces[g.socio]?.grupos.find((x) => x.code === g.code)?.valor
    : getUltimoValor(ind).valor;
  if (valor === undefined) {
    throw new Error(`src/data/explora.ts: "${ind.key}" no tiene el grupo ${g?.socio}=${g?.code}`);
  }
  return ind.stat === 'pct'
    ? { valor: pct(valor), escala: null }
    : { valor: decimal(valor), escala: `/${entero(ind.esc_hi)}` };
}

const items = explora.map((item) => {
  const tema = getTemaBySlug(item.tema)!;
  const gr = item.grafica;
  return {
    item,
    tema,
    // La pregunta de la tarjeta es la primera frase de la introducción del tema.
    pregunta: tema.intro.split('?')[0] + '?',
    cifra: cifra(item),
    rondas: gr.tipo === 'rondas' ? indicador(gr.indicador) : null,
    evolucion: gr.tipo === 'evolucion' ? indicador(gr.indicador) : null,
    proporcion:
      gr.tipo === 'proporcion'
        ? {
            valor: getUltimoValor(indicador(gr.indicador)).valor,
            detalle: gr.detalle && {
              titulo: gr.detalle.titulo,
              items: Object.entries(gr.detalle.items).map(([key, label]) => ({
                label,
                valor: getUltimoValor(indicador(key)).valor,
              })),
            },
          }
        : null,
    barras:
      gr.tipo === 'barras'
        ? Object.entries(gr.barras).map(([key, label]) => ({
            key,
            label,
            valor: getUltimoValor(indicador(key)).valor,
          }))
        : null,
    columnas:
      gr.tipo === 'grupos'
        ? (indicador(gr.indicador).cruces[gr.socio]?.grupos ?? []).map((g) => ({
            key: String(g.code),
            label: g.cat,
            valor: g.valor,
          }))
        : null,
    tituloGrafica: gr.tipo === 'rondas' ? 'Cómo cambió durante la campaña' : gr.titulo,
  };
});
---

<section
  aria-labelledby="temas-titulo"
  class="bg-surface/50 [--explora-titulo:6.5rem] [--explora-tope:5.25rem]"
>
  <div class="container-page py-12 md:py-16">
    <!-- En escritorio el título queda fijo bajo el header mientras se recorren las tarjetas. -->
    <div class="explora-titulo lg:sticky lg:top-[var(--explora-tope)] lg:z-20 lg:flex lg:h-[var(--explora-titulo)] lg:flex-col lg:justify-center">
      <h2 id="temas-titulo" class="text-3xl font-bold text-brand md:text-4xl">
        {titulo('Explora los temas principales')}
      </h2>
      <p class="mt-2 text-ink-muted">Seis conversaciones clave para entender la percepción política.</p>
    </div>

    <div class="mt-10 lg:grid lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12">
      <nav aria-label="Temas" class="hidden lg:block">
        <ol class="sticky top-[calc(var(--explora-tope)+var(--explora-titulo)+2.5rem)] flex flex-col gap-1">
          {
            items.map(({ tema }) => (
              <li>
                <a
                  href={`#explora-${tema.slug}`}
                  data-explora-link={tema.slug}
                  class="group flex items-center justify-between gap-3 rounded-lg px-5 py-4 text-lg font-semibold text-ink transition-[background-color,box-shadow,color] duration-300 hover:bg-white/60 data-[activo]:bg-white data-[activo]:text-brand data-[activo]:shadow-md data-[activo]:ring-4 data-[activo]:ring-white/60"
                >
                  {titulo(tema.titulo)}
                  <Icon
                    name={tema.icono}
                    aria-hidden="true"
                    class="h-6 w-6 shrink-0 text-grana opacity-0 transition-opacity duration-300 group-data-[activo]:opacity-100"
                  />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="flex flex-col gap-8 lg:gap-[30vh] lg:pt-10 lg:pb-[10vh]" data-explora-pila>
        {
          items.map(({ item, tema, pregunta, cifra, rondas, evolucion, proporcion, barras, columnas, tituloGrafica }) => (
            <article
              id={`explora-${tema.slug}`}
              data-explora-tarjeta={tema.slug}
              aria-labelledby={`explora-${tema.slug}-t`}
              class="explora-tarjeta scroll-mt-32 border border-border bg-surface p-5 md:p-8 lg:sticky lg:top-[calc(var(--explora-tope)+var(--explora-titulo)+2.5rem)] lg:shadow-[0_-12px_32px_-20px_rgb(0_0_0/0.25)]"
            >
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="text-xs font-bold tracking-[0.18em] text-grana uppercase">
                    {tema.titulo}
                  </p>
                  <h3
                    id={`explora-${tema.slug}-t`}
                    class="mt-3 text-xl leading-snug font-bold text-brand md:text-2xl"
                  >
                    {pregunta}
                  </h3>
                </div>
                <p class="shrink-0 bg-surface-muted px-5 py-4 sm:w-52">
                  <span class="block text-4xl leading-none font-bold text-grana tabular-nums">
                    {cifra.valor}
                    {cifra.escala && <span class="text-base font-semibold">{cifra.escala}</span>}
                  </span>
                  <span class="mt-2 block text-sm leading-snug text-ink">{item.dato.texto}</span>
                </p>
              </div>

              <div class="mt-6 bg-surface-muted p-5 md:p-6">
                <p class="mb-4 text-sm font-semibold text-ink">{tituloGrafica}</p>
                {rondas && (
                  <EscalaRondas
                    serie={rondas.serie}
                    lo={rondas.esc_lo}
                    hi={rondas.esc_hi}
                    polos={rondas.polos}
                    titulo={tituloGrafica}
                  />
                )}
                {evolucion && (
                  <SlopeChart
                    serie={evolucion.serie}
                    lo={evolucion.esc_lo}
                    hi={evolucion.esc_hi}
                    stat={evolucion.stat}
                    id={`explora-${tema.slug}-g`}
                    titulo={tituloGrafica}
                  />
                )}
                {proporcion && (
                  <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10">
                    <Waffle
                      valor={proporcion.valor}
                      id={`explora-${tema.slug}-g`}
                      descripcion={item.dato.texto.toLowerCase()}
                      class="max-w-40 shrink-0"
                    />
                    {proporcion.detalle && (
                      <div class="flex-1">
                        <p class="text-xs font-bold tracking-[0.14em] text-ink-muted uppercase">
                          {proporcion.detalle.titulo}
                        </p>
                        <ul class="mt-3 flex flex-col divide-y divide-border">
                          {proporcion.detalle.items.map((d) => (
                            <li class="flex items-baseline justify-between gap-4 py-2 text-sm">
                              <span class="text-ink">{d.label}</span>
                              <strong class="shrink-0 font-semibold text-ink tabular-nums">{pct(d.valor)}</strong>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                )}
                {barras && <BarChart datos={barras} titulo={tituloGrafica} />}
                {columnas && <Columnas datos={columnas} titulo={tituloGrafica} />}
              </div>

              <div class="mt-6 flex justify-end">
                <LinkButton href={temaHref(tema.slug)} icon="lucide:arrow-right">
                  Ver resultados<span class="sr-only"> de {tema.titulo}</span>
                </LinkButton>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Título fijo (escritorio): fondo opaco del mismo tono que la sección (surface al 50 % sobre
   * page) extendido a todo el ancho de la ventana, y un desvanecido debajo para que las
   * tarjetas se escondan suave al pasar por debajo.
   */
  @media (min-width: 64rem) {
    .explora-titulo {
      --fondo: color-mix(in srgb, var(--color-surface) 50%, var(--color-page));
      background: var(--fondo);
      box-shadow: 0 0 0 100vmax var(--fondo);
      clip-path: inset(0 -100vmax -1.5rem);
    }
    .explora-titulo::after {
      content: '';
      position: absolute;
      inset: 100% -100vmax auto;
      height: 1.5rem;
      background: linear-gradient(var(--fondo), transparent);
      pointer-events: none;
    }
  }

  /* Aparición suave de cada tarjeta al entrar en pantalla (solo con JS y sin movimiento reducido). */
  :global([data-explora-anim]) .explora-tarjeta {
    opacity: 0;
    translate: 0 2.5rem;
    transition:
      opacity 0.6s ease-out,
      translate 0.6s ease-out;
  }
  :global([data-explora-anim]) .explora-tarjeta[data-visible] {
    opacity: 1;
    translate: 0 0;
  }

  /* Pila (escritorio): la tarjeta que ya quedó tapada por la siguiente se desvanece. */
  .explora-tarjeta {
    transition: opacity 0.35s ease-out;
  }
  :global([data-explora-anim]) .explora-tarjeta[data-visible][data-tapada],
  .explora-tarjeta[data-tapada] {
    opacity: 0;
  }
</style>

<script>
  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-explora-tarjeta]')];
  const links = [...document.querySelectorAll<HTMLElement>('[data-explora-link]')];

  const pila = document.querySelector<HTMLElement>('[data-explora-pila]');
  const escritorio = window.matchMedia('(min-width: 64rem)');

  if (tarjetas.length && pila && 'IntersectionObserver' in window) {
    const activar = (slug: string) =>
      links.forEach((a) => a.toggleAttribute('data-activo', a.dataset.exploraLink === slug));

    // En escritorio las tarjetas son sticky y se apilan. Cada una se pega a `topeBase`, salvo
    // que no quepa en la pantalla: entonces se pega más arriba para que se vea hasta su botón.
    let topeBase = 0;
    const ajustarTopes = () => {
      tarjetas.forEach((t) => (t.style.top = ''));
      if (!escritorio.matches) return;
      topeBase = parseFloat(getComputedStyle(tarjetas[0]!).top);
      for (const t of tarjetas) {
        const tope = Math.min(topeBase, window.innerHeight - t.offsetHeight - 24);
        if (tope < topeBase) t.style.top = `${tope}px`;
      }
    };

    // Tema activo: la última tarjeta que ya llegó a la mitad de la pantalla. La anterior a
    // una tarjeta ya pegada queda tapada y se desvanece.
    let pendiente = false;
    const actualizar = () => {
      pendiente = false;
      const mitad = window.innerHeight / 2;
      let activa = tarjetas[0]!;
      tarjetas.forEach((t, k) => {
        const arriba = t.getBoundingClientRect().top;
        if (arriba <= mitad) activa = t;
        const siguiente = tarjetas[k + 1];
        const tapada =
          escritorio.matches &&
          !!siguiente &&
          siguiente.getBoundingClientRect().top <= parseFloat(getComputedStyle(siguiente).top) + 8;
        t.toggleAttribute('data-tapada', tapada);
      });
      activar(activa.dataset.exploraTarjeta!);
    };
    const programar = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(actualizar);
    };

    // Clic en el menú: lleva a la posición en la que esa tarjeta acaba de pegarse (con sticky,
    // el ancla nativa no sirve porque las tarjetas anteriores siguen en el mismo lugar).
    links.forEach((a) =>
      a.addEventListener('click', (ev) => {
        const k = tarjetas.findIndex((t) => t.dataset.exploraTarjeta === a.dataset.exploraLink);
        if (k < 0 || !escritorio.matches) return;
        ev.preventDefault();
        const estilo = getComputedStyle(pila);
        let y = pila.getBoundingClientRect().top + window.scrollY + parseFloat(estilo.paddingTop);
        for (let i = 0; i < k; i++) y += tarjetas[i]!.offsetHeight + parseFloat(estilo.rowGap);
        const tope = parseFloat(getComputedStyle(tarjetas[k]!).top);
        window.scrollTo({ top: y - tope + 1, behavior: 'smooth' });
        history.replaceState(null, '', a.getAttribute('href'));
      }),
    );

    ajustarTopes();
    actualizar();
    window.addEventListener('scroll', programar, { passive: true });
    window.addEventListener('resize', () => {
      ajustarTopes();
      programar();
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.toggleAttribute('data-explora-anim', true);
      const aparicion = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            e.target.toggleAttribute('data-visible', true);
            aparicion.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      tarjetas.forEach((t) => aparicion.observe(t));
    }
  }
</script>
