---
/**
 * Línea de tiempo del panel: tarjetas de las rondas y vueltas presidenciales (círculo)
 * ensartadas en una misma línea. Horizontal desde md; vertical en celular.
 * La línea avanza con el scroll y cada hito aparece cuando la línea lo alcanza.
 */
import { rondas, vueltas } from '../../data/ficha-tecnica';
import { entero } from '../../lib/format';

type Item =
  | { tipo: 'ronda'; ronda: (typeof rondas)[number] }
  | { tipo: 'vuelta'; vuelta: (typeof vueltas)[number] };

const items: Item[] = rondas.flatMap((ronda, i) => {
  const vuelta = vueltas[i];
  return vuelta
    ? [
        { tipo: 'ronda', ronda },
        { tipo: 'vuelta', vuelta },
      ]
    : [{ tipo: 'ronda', ronda }];
});
---

<ol
  class="linea-panel relative mt-8 flex flex-col gap-6 md:grid md:grid-cols-[minmax(0,1fr)_5.5rem_minmax(0,1fr)_5.5rem_minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_7rem_minmax(0,1fr)_7rem_minmax(0,1fr)] md:gap-0"
  data-linea-panel
>
  <li aria-hidden="true" class="linea absolute">
    <span class="punta absolute border-brand"></span>
  </li>
  {
    items.map((item, i) =>
      item.tipo === 'ronda' ? (
        <li class="hito relative z-10 flex" style={`--i:${i}`}>
          <article class="tarjeta group w-full rounded-2xl border border-border bg-surface p-5 transition-colors duration-300 hover:border-brand hover:bg-brand md:p-4 lg:p-6 dark:hover:border-cream dark:hover:bg-cream">
            <h3 class="text-right text-sm font-medium text-ink group-hover:text-white dark:group-hover:text-navy">
              Ronda {item.ronda.n}
            </h3>
            <p class="mt-2 text-brand group-hover:text-white dark:group-hover:text-navy">
              <span
                class="block text-4xl leading-none font-semibold tabular-nums lg:text-5xl"
                data-contador={item.ronda.personas}
              >
                {entero(item.ronda.personas)}
              </span>
              <span class="mt-1 block text-xl">participantes</span>
            </p>
            <hr class="my-4 border-brand/40 group-hover:border-white/50 dark:group-hover:border-navy/30" />
            <p class="text-xl text-brand group-hover:text-white dark:group-hover:text-navy">
              {entero(item.ronda.preguntas)} preguntas
            </p>
            <p class="mt-6 text-sm text-ink-muted group-hover:text-white/70 dark:group-hover:text-navy/75">
              Fecha de aplicación
              <span class="block">{item.ronda.fechas}</span>
            </p>
          </article>
        </li>
      ) : (
        <li class="hito relative z-10 flex h-10 items-center justify-center md:self-center" style={`--i:${i}`}>
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-cream text-navy"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
              <rect x="4" y="10" width="16" height="10" rx="2" />
              <path d="M8 10V5h8v5M9 14h6" />
            </svg>
          </span>
          <p class="absolute top-1/2 left-1/2 ml-6 w-max -translate-y-1/2 text-sm leading-tight md:top-full md:ml-0 md:-translate-x-1/2 md:translate-y-1 md:text-center">
            <span class="font-semibold text-grana">{item.vuelta.nombre}</span>
            <span class="block text-ink-muted">{item.vuelta.fecha}</span>
          </p>
        </li>
      ),
    )
  }
</ol>

<style>
  /* Línea: pasa por la mitad de las tarjetas (detrás de ellas); vertical en celular,
     horizontal desde md. Sobresale al final para que se vea la punta. */
  .linea {
    top: 0;
    bottom: -1.5rem;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    transform-origin: top;
    background: var(--color-brand);
  }
  .punta {
    left: 50%;
    bottom: -2px;
    width: 0.6rem;
    height: 0.6rem;
    border-right-width: 2px;
    border-bottom-width: 2px;
    transform: translateX(-50%) rotate(45deg);
  }
  @media (min-width: 48rem) {
    .linea {
      top: 50%;
      bottom: auto;
      left: 0;
      right: -1.5rem;
      width: auto;
      height: 2px;
      transform: translateY(-50%);
      transform-origin: left;
    }
    .punta {
      left: auto;
      right: -2px;
      bottom: auto;
      top: 50%;
      transform: translateY(-50%) rotate(-45deg);
    }
  }

  /*
   * Animación ligada al scroll (solo con JS y sin movimiento reducido): --p = avance de la
   * línea (0–1); --v = aparición de cada hito, que llega cuando la línea lo alcanza.
   * Al subir, todo se recoge en sentido inverso.
   */
  .linea-panel[data-anim] .linea {
    scale: 1 var(--p, 0);
  }
  .linea-panel[data-anim] .hito {
    opacity: var(--v, 0);
    translate: 0 calc((1 - var(--v, 0)) * 0.75rem);
  }
  @media (min-width: 48rem) {
    .linea-panel[data-anim] .linea {
      scale: var(--p, 0) 1;
    }
  }
</style>

<script>
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const horizontal = window.matchMedia('(min-width: 48rem)');
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const formato = new Intl.NumberFormat('es-CO');

  // Cifra que sube rápido de 0 a su valor cuando aparece la tarjeta.
  const contar = (el: HTMLElement) => {
    const meta = Number(el.dataset.contador);
    const inicio = performance.now();
    const paso = (t: number) => {
      const k = clamp((t - inicio) / 900);
      el.textContent = formato.format(Math.round(meta * (1 - (1 - k) ** 3)));
      if (k < 1 && el.dataset.contando) requestAnimationFrame(paso);
    };
    el.dataset.contando = '1';
    requestAnimationFrame(paso);
  };

  document.querySelectorAll<HTMLElement>('[data-linea-panel]').forEach((ol) => {
    if (reducido) return;
    ol.dataset.anim = '';
    const hitos = [...ol.querySelectorAll<HTMLElement>('.hito')];

    const actualizar = () => {
      const r = ol.getBoundingClientRect();
      const vh = window.innerHeight;
      let p: number;
      // Inicio de cada hito sobre la línea, como fracción (0–1) de su largo.
      let inicios: number[];
      if (horizontal.matches) {
        // Empieza cuando la línea entra por abajo; completa cuando las tarjetas están a la vista.
        p = clamp((vh * 0.9 - r.top) / (vh * 0.55));
        inicios = hitos.map((h) => h.offsetLeft / ol.offsetWidth);
      } else {
        // Vertical: la línea llega hasta el 75 % de la pantalla.
        p = clamp((vh * 0.75 - r.top) / r.height);
        inicios = hitos.map((h) => h.offsetTop / ol.offsetHeight);
      }
      ol.style.setProperty('--p', String(p));
      hitos.forEach((h, k) => {
        const v = clamp((p - inicios[k]!) / 0.12);
        h.style.setProperty('--v', String(v));
        const cifra = h.querySelector<HTMLElement>('[data-contador]');
        if (!cifra) return;
        if (v > 0.3 && !cifra.dataset.contando) contar(cifra);
        else if (v === 0 && cifra.dataset.contando) {
          delete cifra.dataset.contando;
          cifra.textContent = '0';
        }
      });
    };

    let pendiente = false;
    const programar = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        actualizar();
      });
    };
    actualizar();
    window.addEventListener('scroll', programar, { passive: true });
    window.addEventListener('resize', programar);
  });
</script>
