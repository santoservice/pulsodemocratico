---
/**
 * Línea de tiempo del panel: tarjetas de las rondas y vueltas presidenciales (rombo)
 * ensartadas en una misma línea. Horizontal desde md; vertical en celular.
 * Al entrar en pantalla la línea se dibuja y cada hito aparece cuando la línea lo alcanza.
 */
import { rondas, vueltas } from '../../data/ficha-tecnica';
import { entero } from '../../lib/format';

type Item =
  | { tipo: 'ronda'; ronda: (typeof rondas)[number] }
  | { tipo: 'vuelta'; vuelta: (typeof vueltas)[number] };

const items: Item[] = rondas.flatMap((ronda, i) => {
  const vuelta = vueltas[i];
  return vuelta
    ? [
        { tipo: 'ronda', ronda },
        { tipo: 'vuelta', vuelta },
      ]
    : [{ tipo: 'ronda', ronda }];
});
---

<ol
  class="linea-panel relative mt-8 flex flex-col gap-6 md:grid md:grid-cols-[minmax(0,1fr)_5.5rem_minmax(0,1fr)_5.5rem_minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_7rem_minmax(0,1fr)_7rem_minmax(0,1fr)] md:gap-0"
  data-linea-panel
>
  <li aria-hidden="true" class="linea absolute">
    <span class="punta absolute border-brand"></span>
  </li>
  {
    items.map((item, i) =>
      item.tipo === 'ronda' ? (
        <li class="hito relative z-10 flex" style={`--i:${i}`}>
          <article class="tarjeta group w-full border border-border bg-surface p-5 transition-colors duration-300 hover:border-brand hover:bg-brand md:p-4 lg:p-6">
            <h3 class="text-right text-sm font-medium text-ink group-hover:text-white">
              Ronda {item.ronda.n}
            </h3>
            <p class="mt-2 text-brand group-hover:text-white">
              <span class="block text-4xl leading-none font-semibold tabular-nums lg:text-5xl">
                {entero(item.ronda.personas)}
              </span>
              <span class="mt-1 block text-xl">participantes</span>
            </p>
            <hr class="my-4 border-brand/40 group-hover:border-white/50" />
            <p class="text-xl text-brand group-hover:text-white">
              {entero(item.ronda.preguntas)} preguntas
            </p>
            <p class="mt-6 text-sm text-ink-muted group-hover:text-white/70">
              Fecha de aplicación
              <span class="block">{item.ronda.fechas}</span>
            </p>
          </article>
        </li>
      ) : (
        <li class="hito relative z-10 flex h-10 items-center justify-center md:self-center" style={`--i:${i}`}>
          <span class="h-4 w-4 rotate-45 bg-grana ring-4 ring-page" aria-hidden="true" />
          <p class="absolute top-1/2 left-1/2 ml-6 w-max -translate-y-1/2 text-sm leading-tight md:top-full md:ml-0 md:-translate-x-1/2 md:translate-y-1 md:text-center">
            <span class="font-semibold text-grana">{item.vuelta.nombre}</span>
            <span class="block text-ink-muted">{item.vuelta.fecha}</span>
          </p>
        </li>
      ),
    )
  }
</ol>

<style>
  /* Línea: pasa por la mitad de las tarjetas (detrás de ellas); vertical en celular,
     horizontal desde md. Sobresale al final para que se vea la punta. */
  .linea {
    top: 0;
    bottom: -1.5rem;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    transform-origin: top;
    background: var(--color-brand);
  }
  .punta {
    left: 50%;
    bottom: -2px;
    width: 0.6rem;
    height: 0.6rem;
    border-right-width: 2px;
    border-bottom-width: 2px;
    transform: translateX(-50%) rotate(45deg);
  }
  @media (min-width: 48rem) {
    .linea {
      top: 50%;
      bottom: auto;
      left: 0;
      right: -1.5rem;
      width: auto;
      height: 2px;
      transform: translateY(-50%);
      transform-origin: left;
    }
    .punta {
      left: auto;
      right: -2px;
      bottom: auto;
      top: 50%;
      transform: translateY(-50%) rotate(-45deg);
    }
  }

  /* Animación (solo con JS y sin movimiento reducido): estado inicial... */
  .linea-panel[data-anim='listo'] .linea {
    scale: 1 0;
  }
  .linea-panel[data-anim='listo'] .hito {
    opacity: 0;
    translate: 0 0.75rem;
  }
  @media (min-width: 48rem) {
    .linea-panel[data-anim='listo'] .linea {
      scale: 0 1;
    }
  }
  /* ...y al entrar en pantalla: la línea se dibuja y los hitos aparecen en orden. */
  .linea-panel[data-anim='on'] .linea {
    scale: 1 1;
    transition: scale 1.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .linea-panel[data-anim='on'] .hito {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.5s ease-out,
      translate 0.5s ease-out;
    transition-delay: calc(var(--i) * 300ms + 150ms);
  }
</style>

<script>
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-linea-panel]').forEach((ol) => {
    if (reducido || !('IntersectionObserver' in window)) return;
    ol.dataset.anim = 'listo';
    const io = new IntersectionObserver(
      ([entrada]) => {
        if (!entrada?.isIntersecting) return;
        ol.dataset.anim = 'on';
        io.disconnect();
      },
      { threshold: 0.3 },
    );
    io.observe(ol);
  });
</script>
