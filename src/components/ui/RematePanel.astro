---
/**
 * Remate de la línea del panel: cuántas personas respondieron las tres rondas, alineado a la
 * izquierda en una tarjeta de vidrio. El slot son los textos de explicación, que van dentro de
 * la misma tarjeta, debajo de la cifra.
 */
import { PANEL_COMPLETO, rondas } from '../../data/ficha-tecnica';
import { entero } from '../../lib/format';

const de100 = Math.round((PANEL_COMPLETO / rondas[0].personas) * 100);
---

<!-- Dos columnas desde md: a la izquierda la cifra y su frase; a la derecha, la explicación (slot). -->
<div class="grid gap-6 rounded-2xl bg-(--glass-fill) p-5 text-white md:grid-cols-2 md:items-center md:gap-10 md:p-8">
  <div>
    <p class="text-6xl leading-none font-semibold tabular-nums md:text-7xl">
      {entero(PANEL_COMPLETO)}
    </p>
    <!-- Las dos frases con el mismo estilo de letra, seguidas. -->
    <p class="mt-1 text-xl leading-snug md:text-2xl">
      personas respondieron las tres rondas. {de100} de cada 100 que empezaron en la ronda 1
      siguieron hasta el final.
    </p>
  </div>
  <div class="aparece-hijos space-y-3 leading-relaxed text-[#D9E1EF]">
    <slot />
  </div>
</div>
