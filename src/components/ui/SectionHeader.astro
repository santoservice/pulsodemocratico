---
/** Encabezado de sección: antetítulo ("COLOMBIA 2026"), título h1/h2 y bajada. */
export interface Props {
  title: string;
  eyebrow?: string | false;
  lead?: string;
  as?: 'h1' | 'h2';
  class?: string;
  /** id del título (para aria-labelledby). */
  id?: string;
}

const {
  title,
  eyebrow = 'Colombia 2026',
  lead,
  as: Tag = 'h1',
  class: className,
  id,
} = Astro.props;
const titleClass =
  Tag === 'h1'
    ? 'font-display text-4xl leading-tight font-bold tracking-tight sm:text-5xl md:text-6xl'
    : 'font-display text-2xl leading-tight font-bold tracking-tight md:text-3xl';
---

<div class:list={['max-w-3xl', className]}>
  {eyebrow && (
    <p class="mb-3 text-xs font-medium tracking-[0.25em] text-ink-muted uppercase">{eyebrow}</p>
  )}
  <Tag id={id} class={titleClass}>
    {title}
  </Tag>
  {lead && <p class="mt-4 text-lg leading-relaxed text-ink-muted">{lead}</p>}
  <slot />
</div>
