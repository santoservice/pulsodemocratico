---
import { titulo } from '../../lib/format';

/**
 * Encabezado de sección: antetítulo opcional, título h1/h2 y bajada.
 * El título se escribe con `titulo()` (regla del cliente: mayúscula inicial en cada palabra).
 */
export interface Props {
  title: string;
  eyebrow?: string | false;
  lead?: string;
  as?: 'h1' | 'h2';
  class?: string;
  /** id del título (para aria-labelledby). */
  id?: string;
  /** Título con el tamaño de h1 aunque sea h2 (p. ej. segunda sección grande de una página). */
  grande?: boolean;
}

const {
  title,
  eyebrow = false,
  lead,
  as: Tag = 'h1',
  class: className,
  id,
  grande = Tag === 'h1',
} = Astro.props;
const titleClass =
  grande
    ? 'font-display text-4xl leading-tight font-bold tracking-tight text-brand sm:text-5xl md:text-6xl'
    : 'font-display text-2xl leading-tight font-bold tracking-tight text-brand md:text-3xl';
---

<div class:list={['max-w-3xl', className]}>
  {eyebrow && (
    <p class="mb-3 text-xs font-semibold tracking-[0.25em] text-accent uppercase">{eyebrow}</p>
  )}
  <Tag id={id} class={titleClass}>
    {titulo(title)}
  </Tag>
  {lead && <p class="mt-4 text-lg leading-relaxed text-ink-muted">{lead}</p>}
  <slot />
</div>
