---
/**
 * Columnas de promedios (0 a 5) por grupo: "les creen" frente a "no les creen" a los titulares
 * falsos. Réplica del hallazgo de desinformación e IA del visor.
 */
import { CLS, SERIE_FILL, ZONA, fmt, fmtN } from '../../lib/visor/comun';
import type { GraficaVisor } from '../../lib/visor/tipos';

type Props = Omit<Extract<GraficaVisor, { tipo: 'columnas-grupos' }>, 'tipo'> & {
  /** Ancho de dibujo (px): la gráfica se dibuja a este ancho y se muestra 1:1, sin ampliarse. */
  ancho?: number;
};

const { C, aria, ancho: anchoDibujo = 320 } = Astro.props;
const I = C.items;
const Gs = [
  { k: 'creen', et: 'Les creen', det: 'más de 3' },
  { k: 'no_creen', et: 'No les creen', det: '3 o menos' },
] as const;
// Una serie por afirmación: 1 = azul claro, 2 = azul medio (como cat-1 y cat-4 del visor).
const COL = [SERIE_FILL[0], SERIE_FILL[3]];
const W = anchoDibujo;
const H = 290;
const m = { t: 26, b: 48, l: 24 };
const slot = (W - m.l) / Gs.length;
const ancho = Math.min(slot * (I.length > 1 ? 0.32 : 0.42), 72);
const hueco = 8;
const alto = H - m.t - m.b;
const y = (v: number) => m.t + (1 - v / 5) * alto;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria} class="block h-auto w-full overflow-visible">
  {[0, 1, 2, 3, 4, 5].map((v) => (
    <>
      <line x1={m.l} x2={W} y1={y(v)} y2={y(v)} class="stroke-border" />
      <text x={m.l - 6} y={y(v) + 4} text-anchor="end" class={CLS.tic}>{v}</text>
    </>
  ))}
  {Gs.map((g, i) => {
    const cx = m.l + slot * (i + 0.5);
    return (
      <>
        {I.map((it, n) => {
          const G = it.grupos[g.k];
          const x0 = cx - (I.length * ancho + (I.length - 1) * hueco) / 2 + n * (ancho + hueco);
          const yv = y(G.media);
          const tip = `${g.et} a los titulares falsos · ${fmtN(G.n)} personas\n«${it.corto}»\nPromedio: ${fmt(G.media, 2)}`;
          return (
            <>
              <path d={`M${x0},${y(0)}V${yv + 4}a4,4 0 0 1 4,-4H${x0 + ancho - 4}a4,4 0 0 1 4,4V${y(0)}Z`} class={COL[n]} />
              <text x={x0 + ancho / 2} y={yv - 7} text-anchor="middle" class:list={[COL[n], 'text-[12px] font-extrabold']}>
                {fmt(G.media, 2)}
              </text>
              <rect x={x0} y={m.t} width={ancho} height={alto} fill="transparent" tabindex="0" data-tip={tip} aria-label={`${g.et}, ${it.corto}`} class={ZONA} />
            </>
          );
        })}
        <text x={cx} y={H - m.b + 20} text-anchor="middle" class={CLS.et}>{g.et}</text>
        <text x={cx} y={H - m.b + 37} text-anchor="middle" class={CLS.fecha}>credibilidad {g.det}</text>
      </>
    );
  })}
</svg>
