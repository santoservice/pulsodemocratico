---
/**
 * Credibilidad promedio de titulares verdaderos y falsos por franja de edad (escala 1–5),
 * con la distancia entre ambos. Réplica del hallazgo "¿Distinguen los jóvenes…?" del visor.
 */
import { CLS, HALO, SERIE_FILL, SERIE_TEXT, ZONA, fmt, fmtN } from '../../lib/visor/comun';
import type { GraficaVisor } from '../../lib/visor/tipos';
import MarcaSerie from './MarcaSerie.astro';

type Props = Omit<Extract<GraficaVisor, { tipo: 'credibilidad' }>, 'tipo'> & {
  /** Ancho de dibujo (px): la gráfica se dibuja a este ancho y se muestra 1:1, sin ampliarse. */
  ancho?: number;
};

const { C, aria, ancho = 320 } = Astro.props;
const T = C.tramos;
// Forma (i): verdaderos círculo, falsos cuadrado. Color (c), como la maqueta: cat-3 y cat-2.
const S = [
  { k: 'verdaderos', i: 0, c: 2 },
  { k: 'falsos', i: 1, c: 1 },
] as const;
const W = ancho;
const m = { l: 12, r: 12 };
const fila = 62;
const top = 22;
const H = top + T.length * fila + 34;
const x = (v: number) => m.l + ((v - 1) / 4) * (W - m.l - m.r);
const ya = top + T.length * fila + 6;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria} class="block h-auto w-full overflow-visible">
  <line x1={x(3)} x2={x(3)} y1={top - 6} y2={top + T.length * fila - 8} stroke-dasharray="2 3" class="stroke-ink-muted" />
  <text x={x(3)} y={top - 10} text-anchor="middle" class={CLS.tic}>Ni cierta ni falsa</text>
  {T.map((t, i) => {
    const y = top + i * fila;
    const yc = y + 34;
    const tip = `${t.nombre} · ${fmtN(t.n)} personas\nTitulares verdaderos: ${fmt(t.verdaderos, 2)}\nTitulares falsos: ${fmt(t.falsos, 2)}\nDistancia entre ambos: ${fmt(t.distingue, 2)}`;
    return (
      <>
        {/* `columna`: se salta el rx de 6 px que global.css aplica a las barras, y queda el de aquí. */}
        {i === 0 && <rect x="0" y={y - 2} width={W} height={fila - 6} rx="14" class="columna fill-chart-accent/10" />}
        <text x={m.l} y={y + 13} class={CLS.fila}>{t.nombre}</text>
        <text x={W - m.r} y={y + 13} text-anchor="end" class:list={['fill-ink-muted', CLS.cambio]}>
          distancia: {fmt(t.distingue, 2)}
        </text>
        <line x1={x(t.falsos)} x2={x(t.verdaderos)} y1={yc} y2={yc} stroke-width="3" stroke-linecap="round" opacity=".45" class="stroke-ink-muted" />
        {S.map((s) => {
          const v = t[s.k];
          const izq = s.k === 'falsos';
          return (
            <g class={SERIE_TEXT[s.c]}>
              <MarcaSerie i={s.i} x={x(v)} y={yc} r={7} />
              <text
                x={x(v) + (izq ? -12 : 12)}
                y={yc + 4}
                text-anchor={izq ? 'end' : 'start'}
                class:list={[SERIE_FILL[s.c], 'text-[12px] font-extrabold']}
                style={HALO}
              >
                {fmt(v, 2)}
              </text>
            </g>
          );
        })}
        <rect x="0" y={y} width={W} height={fila - 8} fill="transparent" tabindex="0" data-tip={tip} aria-label={t.nombre} class={ZONA} />
      </>
    );
  })}
  {[1, 2, 3, 4, 5].map((v) => (
    <text x={x(v)} y={ya} text-anchor="middle" class={CLS.tic}>{v}</text>
  ))}
  <text x="0" y={ya + 18} class={CLS.tic}>← Falsa</text>
  <text x={W} y={ya + 18} text-anchor="end" class={CLS.tic}>Verdadera →</text>
</svg>
