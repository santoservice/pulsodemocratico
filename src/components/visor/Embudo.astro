---
/**
 * Embudo "de cada 100 personas": una barra centrada por escalón, con su texto encima.
 * Réplica del embudo de IA del visor. El texto va en HTML (se acomoda solo en varias líneas)
 * y la barra es un bloque con el ancho del porcentaje; no hace falta SVG.
 */
import type { FilaEmbudo } from '../../lib/visor/principales';

export interface Props {
  filas: FilaEmbudo[];
  aria: string;
}

const { filas, aria } = Astro.props;
---

<div role="img" aria-label={aria} class="flex flex-col gap-2">
  {filas.map((f) => (
    <div class="flex flex-col items-center gap-1">
      <p class="text-center text-[12.5px] leading-tight font-bold text-ink-muted">{f.texto}</p>
      <div
        class:list={[
          'flex h-[26px] min-w-[34px] items-center justify-center rounded text-[15px] font-extrabold tabular-nums',
          f.base ? 'bg-chart-no text-ink' : 'cursor-pointer bg-chart-accent text-navy',
        ]}
        style={`width:${f.pct}%`}
        data-tip={f.tip}
      >
        {Math.round(f.pct)}
      </div>
    </div>
  ))}
</div>
