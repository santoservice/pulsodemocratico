---
/**
 * Líneas por ronda en el tiempo (eje x = fechas reales), con la franja de cada ronda, las
 * vueltas electorales y una serie por grupo (color y forma de punto propios). Réplica de
 * `lineasPorRonda` del visor: en modo simple, el valor al final de cada línea; con `detalle`,
 * el valor de cada ronda y el cambio entre rondas (pensado para dos series).
 */
import { CLS, SERIE_FILL, SERIE_TEXT, ZONA, fechaCorta, fmt, meta, rangoCorto } from '../../lib/visor/comun';
import type { GraficaVisor } from '../../lib/visor/tipos';
import MarcaSerie from './MarcaSerie.astro';

type Props = Omit<Extract<GraficaVisor, { tipo: 'lineas' }>, 'tipo'> & {
  /** Versión apaisada (más baja). */
  ancha?: boolean;
  /** Ancho de dibujo (px): la gráfica se dibuja a este ancho y se muestra 1:1, sin ampliarse. */
  ancho?: number;
};

const {
  rondas,
  series,
  max,
  aria,
  min = 0,
  paso = 10,
  detalle = false,
  dec = 0,
  unidad = ' %',
  signo = false,
  polos,
  ancha = false,
  ancho = 320,
} = Astro.props;
const W = ancho;
const H = ancha ? 215 : 300;
// l: 36 (el visor usa 26): el rótulo «50 %» cabe sin salirse del SVG (se corta en las descargas).
const m = { t: 44, r: 38, b: 44, l: 36 };
const dia = (t: string) => new Date(`${t}T12:00:00`).getTime();
const t0 = dia('2026-05-02');
const t1 = dia('2026-07-05');
const x = (t: number) => m.l + ((t - t0) / (t1 - t0)) * (W - m.l - m.r);
const y = (v: number) => m.t + (1 - (v - min) / (max - min)) * (H - m.t - m.b);
const medio = (r: (typeof rondas)[number]) => (dia(r.inicio) + dia(r.fin)) / 2;
const X = rondas.map((r) => x(medio(r)));
const ultima = rondas.length - 1;
const redondea = (v: number) => Math.round(v * 10 ** dec) / 10 ** dec;
const valor = (v: number, d = dec) =>
  `${signo && v > 0 ? '+' : v < 0 ? '−' : ''}${fmt(Math.abs(v), d)}${unidad}`;
const cambio = (d: number) =>
  `${d > 0 ? '+' : d < 0 ? '−' : '±'}${fmt(Math.abs(d), dec)}${unidad === ' %' ? ' pts' : ''}`;
const ticks: number[] = [];
for (let v = min; v <= max; v += paso) ticks.push(v);

// Modo simple: valores al final de cada línea, separados para que no se encimen.
const fin = series.map((s, i) => ({ i, y: y(s.valores[ultima]!) })).sort((a, b) => a.y - b.y);
for (let k = 1; k < fin.length; k++) fin[k]!.y = Math.max(fin[k]!.y, fin[k - 1]!.y + 14);

// Modo detalle: la serie de arriba se rotula por encima; la de abajo, por debajo.
const suma = (s: (typeof series)[number]) => s.valores.reduce((a, v) => a + v, 0);
const arriba = series.map((s) => suma(s) >= Math.max(...series.map(suma)));

const tip = (j: number) =>
  `${rondas[j]!.label} · ${rondas[j]!.fechas}\n${series.map((s) => `${s.corto}: ${valor(s.valores[j]!, dec + 1)}`).join('\n')}`;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria} class="block h-auto w-full overflow-visible">
  {rondas.map((r, j) => {
    const a = x(dia(r.inicio));
    const b = x(dia(r.fin));
    return (
      <>
        <rect x={a} y={m.t} width={b - a} height={H - m.t - m.b} rx="14" class="columna fill-chart-accent/10" />
        <text x={X[j]} y={H - m.b + 18} text-anchor="middle" class={CLS.et}>{r.label}</text>
        <text x={X[j]} y={H - m.b + 33} text-anchor="middle" class="fill-ink-muted text-[11px]">{rangoCorto(r.fechas)}</text>
      </>
    );
  })}
  {ticks.map((v) => (
    <>
      <line
        x1={m.l}
        x2={W - m.r}
        y1={y(v)}
        y2={y(v)}
        class:list={[v === 0 && min < 0 ? 'stroke-ink-muted' : 'stroke-border']}
      />
      <text x={m.l - 6} y={y(v) + 4} text-anchor="end" class={CLS.tic}>
        {signo && v > 0 ? '+' : v < 0 ? '−' : ''}{Math.abs(v)}{v === max && unidad === ' %' ? ' %' : ''}
      </text>
    </>
  ))}
  {polos && (
    <>
      <text x={m.l + 4} y={y(max) - 6} class="fill-ink-muted text-[12px] font-bold">↑ {polos[0]}</text>
      <text x={m.l + 4} y={y(min) - 6} class="fill-ink-muted text-[12px] font-bold">↓ {polos[1]}</text>
    </>
  )}
  {meta.elecciones.map((e) => {
    const ex = x(dia(e.fecha));
    return (
      <>
        <line x1={ex} x2={ex} y1={m.t - 10} y2={H - m.b} stroke-dasharray="4 4" class="stroke-chart-eleccion stroke-[1.5]" />
        <text x={ex} y={m.t - 26} text-anchor="middle" class="fill-chart-eleccion text-[11px] font-extrabold">{e.label}</text>
        <text x={ex} y={m.t - 13} text-anchor="middle" class="fill-ink-muted text-[11px]">{fechaCorta(e.fecha)}</text>
      </>
    );
  })}
  {series.map((s, i) => (
    <g class={SERIE_TEXT[i]}>
      <path
        d={`M${s.valores.map((v, j) => `${X[j]},${y(v)}`).join('L')}`}
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      {s.valores.map((v, j) => (
        <MarcaSerie i={i} x={X[j]!} y={y(v)} r={5} />
      ))}
    </g>
  ))}
  {!detalle &&
    fin.map((f) => (
      <text
        x={X[ultima]! + 10}
        y={f.y + 4}
        class:list={[SERIE_FILL[f.i], CLS.fin]}
        style="paint-order:stroke;stroke:var(--color-surface);stroke-width:4px"
      >
        {valor(redondea(series[f.i]!.valores[ultima]!))}
      </text>
    ))}
  {detalle &&
    series.map((s, i) => {
      const dy = arriba[i] ? -12 : 20;
      const P = s.valores.map(redondea);
      const total = redondea(P[ultima]! - P[0]!);
      return (
        <g style="paint-order:stroke;stroke:var(--color-surface);stroke-width:4px">
          {P.map((v, j) => (
            <text x={X[j]} y={y(s.valores[j]!) + dy} text-anchor="middle" class:list={[SERIE_FILL[i], CLS.fin]}>
              {valor(v)}
            </text>
          ))}
          {P.slice(1).map((v, k) => {
            const j = k + 1;
            const my = (y(s.valores[j - 1]!) + y(s.valores[j]!)) / 2;
            return (
              <text x={(X[j - 1]! + X[j]!) / 2} y={my + (arriba[i] ? -9 : 17)} text-anchor="middle" class:list={[SERIE_FILL[i], CLS.cambio]}>
                {cambio(redondea(v - P[j - 1]!))}
              </text>
            );
          })}
          <text x={X[ultima]! + 12} y={y(s.valores[ultima]!) + 4} class:list={[SERIE_FILL[i], CLS.fin]}>
            {total > 0 ? '▲ +' : total < 0 ? '▼ −' : '= '}{fmt(Math.abs(total), dec)}
          </text>
        </g>
      );
    })}
  {rondas.map((r, j) => (
    <rect
      x={x(dia(r.inicio)) - 6}
      y={m.t}
      width={x(dia(r.fin)) - x(dia(r.inicio)) + 12}
      height={H - m.t - m.b}
      fill="transparent"
      tabindex="0"
      data-tip={tip(j)}
      aria-label={tip(j).replaceAll('\n', '. ')}
      class={ZONA}
    />
  ))}
</svg>
