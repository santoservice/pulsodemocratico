---
/**
 * Punto de una serie del visor: círculo, cuadrado, triángulo o rombo según el índice, para
 * que las series se distingan también sin color. Usa `currentColor` (lo pone el contenedor).
 */
export interface Props {
  /** Índice de la serie (0–3). */
  i: number;
  x: number;
  y: number;
  r: number;
  /** Sin borde (para la leyenda). */
  plano?: boolean;
}

const { i, x, y, r, plano = false } = Astro.props;
const forma = ['circulo', 'cuadrado', 'triangulo', 'rombo'][i % 4];
const estilo = plano ? undefined : 'stroke:var(--color-surface);stroke-width:1.5';
---

{forma === 'circulo' && <circle cx={x} cy={y} r={r} fill="currentColor" style={estilo} />}
{forma === 'cuadrado' && (
  <rect x={x - r * 0.9} y={y - r * 0.9} width={r * 1.8} height={r * 1.8} rx="1.5" fill="currentColor" style={estilo} />
)}
{forma === 'triangulo' && (
  <path d={`M${x},${y - r * 1.15}L${x + r * 1.1},${y + r * 0.8}L${x - r * 1.1},${y + r * 0.8}Z`} fill="currentColor" style={estilo} />
)}
{forma === 'rombo' && (
  <path d={`M${x},${y - r * 1.2}L${x + r * 1.1},${y}L${x},${y + r * 1.2}L${x - r * 1.1},${y}Z`} fill="currentColor" style={estilo} />
)}
