---
/**
 * Promedio de una escala en el tiempo, con su intervalo de confianza, las vueltas electorales
 * y los cambios entre rondas ("▲ sube 0,48"). Réplica de `tarjetaWaps` del visor (índices
 * WAPS hacia votantes y líderes, frecuencia de noticias falsas).
 */
import { CLS, HALO, ZONA, fmt, fmtN, meta } from '../../lib/visor/comun';
import type { GraficaVisor } from '../../lib/visor/tipos';

type Props = Omit<Extract<GraficaVisor, { tipo: 'media-rondas' }>, 'tipo'> & {
  /** Ancho de dibujo (px): la gráfica se dibuja a este ancho y se muestra 1:1, sin ampliarse. */
  ancho?: number;
};

const { G, polos, min, max, alto, aria, ancho = 320 } = Astro.props;
const R = G.rondas;
const W = ancho;
const H = 350;
const m = { t: 70, r: 10, b: 50, l: 24 };
const dia = (t: string) => new Date(`${t}T12:00:00`).getTime();
const medio = (r: (typeof R)[number]) => (dia(r.inicio) + dia(r.fin)) / 2;
const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const rango = (a: string, b: string) => {
  const [, ma, da] = a.split('-').map(Number) as [number, number, number];
  const [, mb, db] = b.split('-').map(Number) as [number, number, number];
  return ma === mb ? `${da}–${db} ${MESES[ma - 1]}` : `${da} ${MESES[ma - 1]}–${db} ${MESES[mb - 1]}`;
};
const t0 = dia('2026-04-30');
const t1 = dia('2026-07-09');
const x = (t: number) => m.l + ((t - t0) / (t1 - t0)) * (W - m.l - m.r);
const y = (v: number) => m.t + (1 - (v - min) / (max - min)) * (H - m.t - m.b);
const P = R.map((r) => [x(medio(r)), y(r.media)] as const);
const ticks: number[] = [];
for (let v = min; v <= max; v++) ticks.push(v);
// El cambio es la resta de los dos promedios que muestra el gráfico (redondeados a dos decimales).
const r2 = (v: number) => Math.round(v * 100) / 100;
const cambios = R.slice(1).map((r, i) => {
  const dif = r2(r.media) - r2(R[i]!.media);
  const txt = `${dif > 0 ? '▲ sube' : '▼ baja'} ${fmt(Math.abs(dif), 2)}`;
  return { txt, w: txt.length * 6.8 + 14, cx: (P[i]![0] + P[i + 1]![0]) / 2, cy: (P[i]![1] + P[i + 1]![1]) / 2 + 34 };
});
const tip = (r: (typeof R)[number]) =>
  `${r.label} · ${r.contexto.toLowerCase()}\n${r.fechas}\nPromedio: ${fmt(r.media, 2)} de ${max}\nIntervalo de confianza al 95 %: ${fmt(r.ic_lo, 2)} a ${fmt(r.ic_hi, 2)}\n${fmt(r.pct_alto, 0)} % ${alto}\nLas mismas ${fmtN(r.n)} personas en las tres rondas`;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria} class="block h-auto w-full overflow-visible">
  {R.map((r) => {
    const a = x(dia(r.inicio));
    const b = x(dia(r.fin));
    const c = x(medio(r));
    return (
      <>
        <rect x={a} y={m.t} width={b - a} height={H - m.t - m.b} rx="6" class="fill-chart-accent/10" />
        <text x={c} y={H - m.b + 22} text-anchor="middle" class={CLS.et}>{r.label}</text>
        <text x={c} y={H - m.b + 39} text-anchor="middle" class={CLS.fecha}>{rango(r.inicio, r.fin)}</text>
      </>
    );
  })}
  {ticks.map((v) => (
    <>
      <line x1={m.l} x2={W - m.r} y1={y(v)} y2={y(v)} class="stroke-border" />
      <text x={m.l - 8} y={y(v) + 4} text-anchor="end" class={CLS.tic}>{v}</text>
    </>
  ))}
  <text x={m.l} y={y(max) - 8} class="fill-ink-muted text-[12px] font-bold" style={HALO}>{polos[0]}</text>
  <text x={m.l} y={y(min) - 8} class="fill-ink-muted text-[12px] font-bold" style={HALO}>{polos[1]}</text>
  {meta.elecciones.map((e) => {
    const ex = x(dia(e.fecha));
    return (
      <>
        <line x1={ex} x2={ex} y1={m.t - 26} y2={H - m.b} stroke-dasharray="4 4" class="stroke-chart-eleccion stroke-[1.5]" />
        <text x={ex} y={m.t - 50} text-anchor="middle" class="fill-chart-eleccion text-[12px] font-extrabold">{e.label}</text>
        <text x={ex} y={m.t - 34} text-anchor="middle" class={CLS.fecha}>
          {+e.fecha.slice(8)} {MESES[+e.fecha.slice(5, 7) - 1]}
        </text>
      </>
    );
  })}
  <path
    d={`M${P.map((p) => p.join(',')).join('L')}`}
    fill="none"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="stroke-chart-accent"
  />
  {cambios.map((c) => (
    <>
      <rect x={c.cx - c.w / 2} y={c.cy - 13} width={c.w} height="22" rx="11" class="fill-surface-muted" />
      <text x={c.cx} y={c.cy + 2.5} text-anchor="middle" class="fill-ink text-[12px] font-extrabold">{c.txt}</text>
    </>
  ))}
  {R.map((r, i) => {
    const [px, py] = P[i]!;
    return (
      <>
        <line x1={px} x2={px} y1={y(r.ic_lo)} y2={y(r.ic_hi)} stroke-width="2" stroke-linecap="round" opacity=".45" class="stroke-chart-accent" />
        <circle cx={px} cy={py} r="9" class="fill-chart-accent" style="stroke:var(--color-surface);stroke-width:3" />
        <text x={px} y={y(r.ic_hi) - 10} text-anchor="middle" class="fill-ink text-[19px] font-extrabold" style={HALO}>
          {fmt(r.media, 2)}
        </text>
        <circle cx={px} cy={py} r="24" fill="transparent" tabindex="0" data-tip={tip(r)} aria-label={`${r.label}: ${fmt(r.media)} de ${max}`} class={ZONA} />
      </>
    );
  })}
</svg>
