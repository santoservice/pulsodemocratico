---
/**
 * Gráfico de pendiente entre la 1.ª y la 3.ª ronda, una línea por grupo de edad, con el cambio
 * de cada grupo. Réplica del hallazgo "populismo por edad" del visor.
 */
import { CLS, SERIE_FILL, SERIE_TEXT, ZONA, cambioPts, fmt, fmtN, fmtSigno, pTexto, rangoCorto } from '../../lib/visor/comun';
import { GRUPOS_EDAD } from '../../lib/visor/principales';
import type { GraficaVisor } from '../../lib/visor/tipos';
import MarcaSerie from './MarcaSerie.astro';

type Props = Omit<Extract<GraficaVisor, { tipo: 'pendiente' }>, 'tipo'>;

const { C, aria } = Astro.props;
const R = C.rondas;
const W = 320;
const H = 290;
const m = { t: 48, b: 14 };
const MAX = 60;
const xa = 62;
const xb = W - 116;
const y = (v: number) => m.t + (1 - v / MAX) * (H - m.t - m.b);
const series = GRUPOS_EDAD.map((g) => ({ corto: g.et, ...C.grupos[g.k] }));
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria} class="block h-auto w-full overflow-visible">
  {[0, 20, 40, 60].map((v) => (
    <>
      <line x1={xa - 34} x2={xb + 10} y1={y(v)} y2={y(v)} class="stroke-border" />
      <text x="0" y={y(v) + 4} class={CLS.tic}>{v}{v === MAX ? ' %' : ''}</text>
    </>
  ))}
  {[xa, xb].map((x, k) => (
    <>
      <line x1={x} x2={x} y1={m.t - 6} y2={y(0)} stroke-width="2" class="stroke-border" />
      <text x={x} y="16" text-anchor="middle" class={CLS.et}>{R[k]!.label}</text>
      <text x={x} y="31" text-anchor="middle" class="fill-ink-muted text-[11px]">{rangoCorto(R[k]!.fechas)}</text>
    </>
  ))}
  {series.map((s, i) => {
    const [a, b] = s.pct.map(Math.round) as [number, number];
    const txt = cambioPts(b - a, s.cambio.p);
    const tip = `${s.corto} · ${fmtN(s.n)} personas\n${R[0]!.label}: ${fmt(s.pct[0]!)} %\n${R[1]!.label}: ${fmt(s.pct[1]!)} %\nCambio: ${fmtSigno(s.cambio.dif_pp)} puntos (${pTexto(s.cambio.p)})`;
    return (
      <g class={SERIE_TEXT[i]}>
        <line x1={xa} x2={xb} y1={y(s.pct[0]!)} y2={y(s.pct[1]!)} stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <MarcaSerie i={i} x={xa} y={y(s.pct[0]!)} r={6} />
        <MarcaSerie i={i} x={xb} y={y(s.pct[1]!)} r={6} />
        <text x={xa - 10} y={y(s.pct[0]!) + 4} text-anchor="end" class:list={[SERIE_FILL[i], CLS.fin]}>{a} %</text>
        <text x={xb + 10} y={y(s.pct[1]!) + 4} class:list={[SERIE_FILL[i], CLS.fin]}>
          {b} %<tspan dx="5" class={CLS.cambio}>{txt}</tspan>
        </text>
        <line
          x1={xa}
          x2={xb}
          y1={y(s.pct[0]!)}
          y2={y(s.pct[1]!)}
          stroke="transparent"
          stroke-width="18"
          tabindex="0"
          data-tip={tip}
          aria-label={s.corto}
          class={ZONA}
        />
      </g>
    );
  })}
</svg>
