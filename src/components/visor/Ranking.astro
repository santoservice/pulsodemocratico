---
/**
 * Barras horizontales ordenadas, la primera resaltada (fuentes para verificar, redes sociales).
 * Réplica del visor: sobre cada barra el nombre y, opcionalmente, un dato pequeño.
 */
import { CLS, ZONA, fmt } from '../../lib/visor/comun';
import type { GraficaVisor } from '../../lib/visor/tipos';

type Props = Omit<Extract<GraficaVisor, { tipo: 'ranking' }>, 'tipo'> & {
  /** Ancho de dibujo (px): la gráfica se dibuja a este ancho y se muestra 1:1, sin ampliarse. */
  ancho?: number;
};

const { filas, max, aria, ancho = 320 } = Astro.props;
const W = ancho;
const fila = 42;
const alto = 16;
const et = 18;
const m = { r: 64 };
const H = filas.length * fila + 4;
const MAX = max ?? Math.max(...filas.map((f) => f.pct));
const x = (v: number) => (v / MAX) * (W - m.r);
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria} class="block h-auto w-full overflow-visible">
  {filas.map((f, i) => {
    const y = i * fila;
    return (
      <>
        <!-- Nombres sin negrilla; el % va sin contorno, solo con su color. -->
        <text x="0" y={y + 13} class="fill-ink text-[12.5px]">
          {f.nombre}{f.sub && <tspan dx="6" class={CLS.fecha}>{f.sub}</tspan>}
        </text>
        <rect x="0" y={y + et} width={W - m.r} height={alto} rx="4" class="fill-chart-track" />
        <rect x="0" y={y + et} width={x(f.pct)} height={alto} rx="4" class={i === 0 ? 'fill-chart-accent' : 'fill-serie-4'} />
        <text
          x={x(f.pct) + 8}
          y={y + et + alto / 2 + 4.5}
          class:list={['font-extrabold', i === 0 ? 'fill-ink text-[15px]' : 'fill-ink-muted text-[13px]']}
        >
          {fmt(f.pct)} %
        </text>
        <rect x="0" y={y} width={W} height={fila - 4} fill="transparent" tabindex="0" data-tip={f.tip} aria-label={f.nombre} class={ZONA} />
      </>
    );
  })}
</svg>
