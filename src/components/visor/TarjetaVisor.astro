---
/**
 * Tarjeta de un hallazgo del visor: pregunta, leyenda y gráfica (sin chip de tema).
 * En el mosaico (`compacta`, desde lg) va como la maqueta: tema en texto y a su lado «Ver más»,
 * que abre el detalle. "Ver detalle" abre el detalle a pantalla completa (QuestionModal + DetalleVisor) con la
 * tabla de datos, "¿Cómo se midió?" y las descargas; el ícono descarga solo la gráfica.
 */
import { Icon } from 'astro-icon/components';
import type { HallazgoVisor } from '../../lib/visor/principales';
import GraficaVisor from './GraficaVisor.astro';

export interface Props {
  hallazgo: HallazgoVisor;
  /** Nivel del título (h3 en listas bajo un h2). */
  as?: 'h2' | 'h3' | 'h4';
  class?: string;
  /**
   * Mosaico de escritorio (Principales hallazgos): desde lg, tema en texto, título y márgenes más
   * chicos, solo «Ver más» junto al tema (abre el detalle) y la gráfica de 320 encogida a la tarjeta.
   * `apaisada`: líneas más bajas (tarjeta de dos columnas del mosaico).
   * `anchoLg`: ancho (px) de la gráfica en esta tarjeta desde lg; ahí se dibuja a ese ancho para
   * llenarla 1:1 (GraficaVisor). Debajo de lg se usa la versión de 320.
   */
  compacta?: boolean;
  anchoLg?: number;
  apaisada?: boolean;
  /**
   * Tarjetas por tema (/resultados): misma fila superior que el mosaico (tema y «Ver más») en
   * todos los anchos, sin los botones de abajo, pero con los tamaños de texto normales.
   */
  encabezado?: boolean;
}

const {
  hallazgo: h,
  as: Titulo = 'h3',
  class: className,
  compacta = false,
  anchoLg,
  apaisada = false,
  encabezado = false,
} = Astro.props;
const idGrafica = `tarjeta-${h.id}-grafica`;
// En el mosaico el tema comparte fila con «Ver más»: «Inteligencia artificial» no cabe.
const temaCorto = h.etiqueta === 'Inteligencia artificial' ? 'IA' : h.etiqueta;
---

<article
  aria-labelledby={`tarjeta-${h.id}-t`}
  class:list={[
    'relative flex h-full min-w-0 flex-col rounded-2xl border border-border bg-surface dark:border-transparent dark:bg-tarjeta-visor',
    compacta ? 'p-4' : 'p-5',
    className,
  ]}
>
  {(compacta || encabezado) && (
    <div class:list={['mb-1.5 flex items-center justify-between gap-2', encabezado && 'justify-end']}>
      {!encabezado && <p class="text-[12px] text-ink">{temaCorto}</p>}
      <button
        type="button"
        data-tarjeta={`visor-${h.id}`}
        aria-haspopup="dialog"
        class="inline-flex shrink-0 items-center gap-1 rounded-full bg-[#5e8be0] px-2.5 py-0.5 text-[11px] font-semibold text-(--color-tarjeta-visor) transition-colors hover:bg-white focus-visible:ring-2 focus-visible:ring-focus focus-visible:outline-none"
      >
        Ver más<span class="sr-only">: {h.titulo}</span>
        <Icon name="lucide:arrow-right" class="h-3 w-3" aria-hidden="true" />
      </button>
    </div>
  )}
  <Titulo
    id={`tarjeta-${h.id}-t`}
    class:list={[
      'text-xl leading-tight font-extrabold text-brand',
      !(encabezado || compacta) && 'md:min-h-[3.75rem]',
      (encabezado || compacta) && 'mt-3',
      compacta && 'lg:text-[14px] lg:leading-snug',
    ]}
  >
    {h.titulo}
  </Titulo>
  <div
    id={idGrafica}
    class:list={[
      // El fondo de la gráfica llega hasta los botones y la gráfica va centrada en él, para que
      // las tarjetas de una misma fila no se vean descuadradas.
      'flex flex-1 flex-col justify-center dark:rounded-2xl dark:bg-grafica-visor dark:p-3',
      compacta ? 'mt-2.5' : 'mt-3.5',
      compacta && 'lg:justify-start',
      // Mosaico, como la maqueta: sin la nota de la leyenda y la gráfica más chica (zoom y alto
      // máximo) para que todo quepa en una pantalla.
      compacta &&
        'lg:flex-1 lg:[zoom:0.85] lg:[&_.grafica-visor>div:first-child_small]:hidden lg:[&_svg[role=img]]:max-h-[12rem]',
    ]} data-descarga={`${h.id}-grafica`} data-titulo={h.titulo} data-tema={h.etiqueta}>
    {anchoLg ? (
      <>
        <div class="lg:hidden"><GraficaVisor hallazgo={h} uid={`t-${h.id}`} /></div>
        {/* flex-col y flex-1 desde lg: la gráfica puede crecer al alto de la tarjeta (ver `llenar` en resultados/index.astro). */}
        <div class="max-lg:hidden lg:flex lg:flex-1 lg:flex-col"><GraficaVisor hallazgo={h} uid={`ta-${h.id}`} ancho={anchoLg} apaisada={apaisada} /></div>
      </>
    ) : (
      <GraficaVisor hallazgo={h} uid={`t-${h.id}`} apaisada={apaisada} />
    )}
  </div>
  <div class:list={['mt-auto flex items-center justify-between gap-3 pt-5', (compacta || encabezado) && 'hidden']}>
    <button
      type="button"
      data-tarjeta={`visor-${h.id}`}
      aria-haspopup="dialog"
      class="inline-flex min-h-10 items-center gap-1.5 rounded-full border border-white bg-white px-4 py-2 text-sm font-semibold text-negro transition-colors hover:border-cream hover:bg-cream"
    >
      Ver detalle<span class="sr-only">: {h.titulo}</span>
      <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
    </button>
    <button
      type="button"
      data-descargar
      data-objetivo={idGrafica}
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border-strong text-ink transition-colors hover:border-cream hover:bg-cream hover:text-navy disabled:opacity-60"
    >
      <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
      <span class="sr-only">Descargar la gráfica «{h.titulo}» como imagen</span>
    </button>
  </div>
</article>
