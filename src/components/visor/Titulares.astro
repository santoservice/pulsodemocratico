---
/**
 * Titulares falsos y verdaderos: barra del promedio de cada tipo y barras finas por titular sobre
 * la escala de 1 a 5, saliendo de `origen` (3 = divergentes desde el punto medio). Réplica de
 * `tarjetaTitulares` del visor (credibilidad y probabilidad de compartir).
 */
import { HALO, SERIE_FILL, ZONA, fmt, fmtN } from '../../lib/visor/comun';
import type { GraficaVisor } from '../../lib/visor/tipos';

type Props = Omit<Extract<GraficaVisor, { tipo: 'titulares' }>, 'tipo'> & {
  /** Ancho de dibujo (px): la gráfica se dibuja a este ancho y se muestra 1:1, sin ampliarse. */
  ancho?: number;
};

const { C, origen, medio, polos, medida, alto, bajo, aria, ancho = 320 } = Astro.props;
// Falsos: serie 2; verdaderos: serie 3 (como la maqueta: cat-2 y cat-3).
const S = [
  { k: 'falsos', et: 'Titulares falsos', col: SERIE_FILL[1]! },
  { k: 'verdaderos', et: 'Titulares verdaderos', col: SERIE_FILL[2]! },
] as const;
const W = ancho;
const m = { l: 12, r: 12 };
const cab = 50;
const fila = 38;
const top = 24;
const sep = 14;
const H = top + S.length * (cab + 4 * fila) + sep + 34;
const x = (v: number) => m.l + ((v - 1) / 4) * (W - m.l - m.r);
const fin = top + S.length * (cab + 4 * fila) + sep;
const barra = (v: number) => ({ x: Math.min(x(v), x(origen)), w: Math.abs(x(v) - x(origen)) });
const lado = (v: number) => ({ dx: v < origen ? -6 : 6, anchor: v < origen ? 'end' : 'start' });
let y = top;
const bloques = S.map((s, g) => {
  if (g) y += sep;
  const tp = C.tipos[s.k];
  const y0 = y;
  y += cab;
  const filas = tp.titulares.map((t) => {
    const yt = y;
    y += fila;
    return { t, y: yt };
  });
  return { s, tp, y: y0, filas };
});
const ya = fin + 12;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria} class="block h-auto w-full overflow-visible">
  <line x1={x(3)} x2={x(3)} y1={top - 6} y2={fin} stroke-dasharray="2 3" class="stroke-ink-muted" />
  <text x={x(3)} y={top - 10} text-anchor="middle" class="fill-ink-muted text-[12px]">{medio}</text>
  {bloques.map(({ s, tp, y: y0, filas }) => {
    const bm = barra(tp.media);
    const lm = lado(tp.media);
    return (
      <>
        <rect x="0" y={y0} width={W} height={cab - 6} rx="14" class="columna fill-chart-accent/10" />
        <text x={m.l} y={y0 + 16} class:list={[s.col, 'text-[12.5px] font-bold']}>{s.et} · promedio</text>
        <rect x={bm.x} y={y0 + 24} width={bm.w} height="14" rx="4.7" class={s.col} />
        <text x={x(tp.media) + lm.dx} y={y0 + 31} dominant-baseline="central" text-anchor={lm.anchor} class:list={[s.col, 'text-[12px] font-extrabold']}>
          {fmt(tp.media, 2)}
        </text>
        <rect x="0" y={y0} width={W} height={cab - 6} fill="transparent" tabindex="0" data-tip={`${s.et} · ${fmtN(C.n)} personas\n${medida}: ${fmt(tp.media, 2)}`} aria-label={s.et} class={ZONA} />
        {filas.map(({ t, y: yt }) => {
          const b = barra(t.media);
          const l = lado(t.media);
          return (
            <>
              <text x={m.l} y={yt + 12} class="fill-ink-muted text-[12px]" style={HALO}>{t.corto}</text>
              <rect x={b.x} y={yt + 18} width={b.w} height="9" rx="3" opacity=".55" class={s.col} />
              <text x={x(t.media) + l.dx} y={yt + 22.5} dominant-baseline="central" text-anchor={l.anchor} class:list={[s.col, 'text-[12px]']}>
                {fmt(t.media, 2)}
              </text>
              <rect
                x="0"
                y={yt}
                width={W}
                height={fila - 2}
                fill="transparent"
                tabindex="0"
                data-tip={`«${t.texto}»\n${medida}: ${fmt(t.media, 2)}\n${alto}: ${fmt(t.pct_alto)} %\n${bajo}: ${fmt(t.pct_bajo)} %`}
                aria-label={t.corto}
                class={ZONA}
              />
            </>
          );
        })}
      </>
    );
  })}
  {[1, 2, 3, 4, 5].map((v) => (
    <text x={x(v)} y={ya} text-anchor="middle" class="fill-ink-muted text-[12px]">{v}</text>
  ))}
  <text x="0" y={ya + 18} class="fill-ink-muted text-[12px]">{polos[0]}</text>
  <text x={W} y={ya + 18} text-anchor="end" class="fill-ink-muted text-[12px]">{polos[1]}</text>
</svg>
