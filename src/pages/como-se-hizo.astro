---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import LinkButton from '../components/ui/LinkButton.astro';
import { cnep } from '../data/sitio';
import { PANEL_COMPLETO, fichaTecnica, rondas } from '../data/ficha-tecnica';
import { entero, titulo } from '../lib/format';
import { datasetJsonLd } from '../lib/seo';
import { getIndicadores } from '../lib/tablero';

const intro =
  'Seguimos a un mismo grupo de colombianos en tres momentos de la campaña presidencial de 2026 para entender cómo se informan, qué piensan y cómo cambian sus opiniones.';

const dataset = datasetJsonLd(
  { variables: getIndicadores().map((i) => i.titulo), path: '/como-se-hizo' },
  Astro.site,
);
---

<BaseLayout
  title={titulo('¿Cómo se hizo la encuesta?')}
  description="Ficha técnica y metodología de la encuesta panel CNEP Colombia 2026: tres rondas en línea con las mismas personas durante la campaña presidencial."
  jsonLd={dataset}
>
  <div class="container-page py-10 md:py-14">
    <SectionHeader title="¿Cómo se hizo la encuesta?" lead={intro} />

    <!-- Ficha técnica -->
    <section aria-labelledby="ficha-titulo" class="mt-12 bg-surface-muted p-5 md:p-8">
      <h2 id="ficha-titulo" class="text-2xl font-bold text-brand md:text-3xl">
        {titulo('Ficha técnica')}
      </h2>
      <p class="mt-2 text-ink-muted">Los datos clave del estudio.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {fichaTecnica.map((item) => (
          <li class="flex gap-4 border border-border bg-surface p-4">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center bg-surface-sunken text-accent"
              aria-hidden="true"
            >
              <Icon name={`lucide:${item.icono}`} class="h-5 w-5" />
            </span>
            <div>
              <h3 class="font-semibold text-brand">{item.titulo}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-muted">{item.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Panel -->
    <section aria-labelledby="panel-titulo" class="mt-16">
      <h2 id="panel-titulo" class="text-2xl font-bold text-brand md:text-3xl">
        {titulo('Así funciona el panel')}
      </h2>
      <p class="mt-2 text-ink-muted">
        Consultamos a las mismas personas antes, durante y después de las dos vueltas
        presidenciales.
      </p>
      <ol class="mt-8 flex flex-col items-stretch gap-2 md:flex-row md:items-center md:gap-3">
        {rondas.map((r, i) => (
          <>
            <li class="flex flex-1 items-start gap-4 border border-border bg-surface p-4 md:p-5">
              <span
                class="flex h-14 w-14 shrink-0 items-center justify-center bg-surface-sunken text-accent"
                aria-hidden="true"
              >
                <Icon name="lucide:clipboard-check" class="h-6 w-6" />
              </span>
              <div>
                <h3 class="text-lg font-bold text-brand">Ronda {r.n}</h3>
                <p class="text-sm text-ink">{r.nota}</p>
                <p class="mt-1 text-sm text-ink-muted">Fecha de aplicación: {r.fechas}</p>
                <p class="mt-1 text-sm font-semibold text-ink">
                  {entero(r.personas)} participantes · {entero(r.preguntas)} preguntas
                </p>
              </div>
            </li>
            {i < rondas.length - 1 && (
              <li aria-hidden="true" class="flex justify-center text-accent">
                <Icon name="lucide:arrow-down" class="h-6 w-6 md:hidden" />
                <Icon name="lucide:arrow-right" class="hidden h-6 w-6 md:block" />
              </li>
            )}
          </>
        ))}
      </ol>
      <div class="mt-8 max-w-3xl space-y-3 leading-relaxed text-ink-muted">
        <p class="border-l-4 border-accent bg-surface-highlight px-4 py-3 text-ink">
          <strong class="font-semibold">
            {entero(PANEL_COMPLETO)} personas respondieron las tres rondas;
          </strong>
          las demás participaron en una o dos.
        </p>
        <p>
          En las encuestas tipo panel es normal que algunas personas dejen de participar entre una
          ronda y otra, por falta de tiempo, porque no ven la invitación o porque deciden no
          continuar. Por eso el número de participantes baja de una ronda a la siguiente.
        </p>
        <p>
          El número de preguntas también varía: cada ronda combina un núcleo común, que permite
          comparar los cambios, con preguntas propias de cada momento de la campaña.
        </p>
      </div>
    </section>

    <!-- Qué puede y qué no puede decir (propuesta de diseño) -->
    <section aria-labelledby="alcance-titulo" class="mt-16 border border-border p-5 md:p-8">
      <h2 id="alcance-titulo" class="text-2xl font-bold text-brand md:text-3xl">
        {titulo('Qué puede y qué no puede decir esta encuesta')}
      </h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="bg-surface-muted p-5">
          <h3 class="flex items-center gap-2 font-bold text-brand">
            <Icon name="lucide:check" class="h-5 w-5" aria-hidden="true" /> Sí sirve para
          </h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-muted">
            <li>Comparar grupos (por edad, sexo, estudios o estrato).</li>
            <li>Ver si la gente cambió de opinión entre rondas.</li>
          </ul>
        </div>
        <div class="bg-surface-muted p-5">
          <h3 class="flex items-center gap-2 font-bold text-brand">
            <Icon name="lucide:x" class="h-5 w-5" aria-hidden="true" /> No sirve para
          </h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-muted">
            <li>Decir qué porcentaje del país piensa cada cosa.</li>
            <li>Calcular un margen de error.</li>
          </ul>
        </div>
      </div>
      <p class="mt-4 text-sm text-ink-muted">
        La muestra no es probabilística: los resultados describen a las personas encuestadas.
      </p>
    </section>

    <!-- Cierre -->
    <section aria-labelledby="cta-titulo" class="mt-16 bg-surface-sunken p-6 text-center md:p-10">
      <h2 id="cta-titulo" class="sr-only">
        {titulo('Datos completos de la encuesta')}
      </h2>
      <p class="mx-auto max-w-2xl text-lg text-ink">
        Si quieres conocer los datos de toda la encuesta, consúltalos en la página oficial del
        Comparative National Elections Project (CNEP).
      </p>
      <LinkButton href={cnep.url} external variant="primary" class="mt-6">
        Página web de CNEP
      </LinkButton>
    </section>
  </div>
</BaseLayout>
