---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import LinkButton from '../components/ui/LinkButton.astro';
import { cnep } from '../data/sitio';
import LineaPanel from '../components/ui/LineaPanel.astro';
import RematePanel from '../components/ui/RematePanel.astro';
import { fichaTecnica } from '../data/ficha-tecnica';
import { titulo } from '../lib/format';
import { datasetJsonLd } from '../lib/seo';
import { getIndicadores } from '../lib/tablero';

const intro =
  'Seguimos a un mismo grupo de colombianos en tres momentos de la campaña presidencial de 2026 para entender cómo se informan, qué piensan y cómo cambian sus opiniones.';

const dataset = datasetJsonLd(
  { variables: getIndicadores().map((i) => i.titulo), path: '/como-se-hizo' },
  Astro.site,
);
---

<BaseLayout
  title={titulo('¿Cómo se hizo la encuesta?')}
  description="Ficha técnica y metodología de la encuesta panel CNEP Colombia 2026: tres rondas en línea con las mismas personas durante la campaña presidencial."
  jsonLd={dataset}
>
  <div class="container-page py-10 md:py-14">
    <SectionHeader title="¿Cómo se hizo la encuesta?" lead={intro} />

    <!-- Ficha técnica -->
    <section aria-labelledby="ficha-titulo" class="mt-12 rounded-2xl bg-surface-muted p-5 md:p-8">
      <h2 id="ficha-titulo" class="text-2xl font-bold text-brand md:text-3xl">
        {titulo('Ficha técnica')}
      </h2>
      <p class="mt-2 text-ink-muted">Los datos clave del estudio.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {fichaTecnica.map((item, i) => (
          <li class="relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface p-5 md:p-6">
            {/* Ícono grande y tenue de fondo, en azul, cortado por una esquina (alterna abajo/arriba).
                La opacidad va en el ícono entero: con color translúcido los trazos que se cruzan
                se ven más claros. */}
            <Icon
              name={item.icono}
              aria-hidden="true"
              class:list={[
                'pointer-events-none absolute text-accent opacity-20',
                item.id === 'cobertura'
                  ? '-right-8 -bottom-14 h-56 w-44'
                  : i % 2 === 0 || item.id === 'trabajo-de-campo'
                    ? '-right-8 -bottom-8 h-36 w-36'
                    : '-top-8 -right-8 h-36 w-36',
              ]}
            />
            <h3 class="relative text-lg font-bold text-brand">{item.titulo}</h3>
            <p class="relative mt-2 leading-relaxed text-ink-muted">{item.texto}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Panel -->
    <section aria-labelledby="panel-titulo" class="mt-16">
      <h2 id="panel-titulo" class="text-2xl font-bold text-brand md:text-3xl">
        {titulo('Así funciona el panel')}
      </h2>
      <p class="mt-2 text-ink-muted">
        Consultamos a las mismas personas antes, durante y después de las{' '}
        <strong class="font-bold text-ink">dos vueltas presidenciales</strong>.
      </p>
      <LineaPanel />
      <div class="mt-12">
        <RematePanel />
      </div>
      <div class="mt-8 max-w-3xl space-y-3 leading-relaxed text-ink-muted">
        <p>
          En las encuestas tipo panel es normal que algunas personas dejen de participar entre una
          ronda y otra, por falta de tiempo, porque no ven la invitación o porque deciden no
          continuar. Por eso el número de participantes baja de una ronda a la siguiente.
        </p>
        <p>
          El número de preguntas también varía: cada ronda combina un núcleo común, que permite
          comparar los cambios, con preguntas propias de cada momento de la campaña.
        </p>
      </div>
    </section>

    <!-- Consideraciones: alcance de la encuesta -->
    <section aria-labelledby="alcance-titulo" class="mt-16 rounded-2xl border border-border p-5 md:p-8">
      <h2 id="alcance-titulo" class="text-2xl font-bold text-brand md:text-3xl">
        {titulo('Consideraciones')}
      </h2>
      <p class="mt-2 text-ink-muted">Antes de leer los resultados, ten en cuenta lo siguiente.</p>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl bg-surface-muted p-5">
          <h3 class="font-bold text-brand">Esta encuesta es útil para</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-muted">
            <li>Comparar grupos de personas por edad, sexo, nivel educativo o estrato.</li>
            <li>Seguir cómo cambiaron las opiniones de una ronda a otra.</li>
          </ul>
        </div>
        <div class="rounded-xl bg-surface-muted p-5">
          <h3 class="font-bold text-brand">No es la herramienta indicada para</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-ink-muted">
            <li>Afirmar qué porcentaje del país piensa de cierta manera.</li>
            <li>Calcular un margen de error.</li>
          </ul>
        </div>
      </div>
      <p class="mt-4 text-sm text-ink-muted">
        La muestra no es probabilística, así que los resultados describen a las personas
        encuestadas y no a toda la población.
      </p>
    </section>

    <!-- Cierre -->
    <!--
      Franja azul en degradado (como la maqueta): texto y botón en azul 281. En escritorio, texto
      a la izquierda y botón a la derecha; si no caben, el botón baja y todo queda centrado.
    -->
    <section
      aria-labelledby="cta-titulo"
      class="mt-16 flex flex-col items-center gap-6 rounded-3xl bg-linear-to-r from-[#5f8cf2] to-[#8db3fa] p-6 text-center text-navy md:p-10 lg:flex-row lg:justify-between lg:gap-10 lg:text-left"
    >
      <h2 id="cta-titulo" class="sr-only">
        {titulo('Datos completos de la encuesta')}
      </h2>
      <p class="max-w-2xl text-lg leading-snug font-semibold md:text-xl">
        Si quieres conocer los datos de toda la encuesta, consúltalos en la página oficial del
        Comparative National Elections Project (CNEP).
      </p>
      <LinkButton href={cnep.url} external variant="navy" class="shrink-0">
        Página web de CNEP
      </LinkButton>
    </section>
  </div>
</BaseLayout>
