---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import StatsRow from '../components/ui/StatsRow.astro';
import TopicCard from '../components/ui/TopicCard.astro';
import { sitio } from '../data/sitio';
import { temas, temaHref } from '../data/temas';

// PROPUESTA (PLAN.md §4.1): "Datos que sorprenden".
// TODO Fase 3: usar indicadores `destacado: true` de tablero.json.
const sorpresas = [
  { valor: 'XX %', frase: 'Frase de una línea con el dato destacado.', tema: temas[0] },
  { valor: 'X,X', frase: 'Frase de una línea con el dato destacado.', tema: temas[2] },
  { valor: 'XX de 100', frase: 'Frase de una línea con el dato destacado.', tema: temas[3] },
];
---

<BaseLayout title={sitio.nombre}>
  <!-- Hero -->
  <section aria-labelledby="titulo-principal" class="border-b border-border">
    <div class="container-page pt-6 md:pt-10">
      <!-- TODO (cliente): Foto 1, contexto / campaña / Colombia 2026 -->
      <Placeholder
        class="aspect-[16/9] w-full md:aspect-[21/7]"
        label="Imagen (contexto / campaña / Colombia 2026)"
        note="Foto 1"
      />
    </div>
    <div class="container-page py-10 md:py-16">
      <div class="max-w-3xl md:pl-10">
        <h1
          id="titulo-principal"
          class="font-display text-5xl leading-none font-bold tracking-tight md:text-7xl"
        >
          {sitio.nombre}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted md:text-xl">
          Lo que piensa la ciudadanía colombiana: resultados de la encuesta nacional CNEP, aplicada
          durante las elecciones de 2026.
        </p>
      </div>
    </div>
  </section>

  <!-- Quiz -->
  <section aria-labelledby="quiz-titulo" class="border-b border-border bg-surface-muted">
    <div class="container-page grid gap-8 py-12 md:grid-cols-[1fr_2fr] md:py-16">
      <div class="md:pl-10">
        <h2 id="quiz-titulo" class="text-3xl leading-tight font-bold">
          ¿Dónde te ubicas frente al resto del país?
        </h2>
        <p class="mt-4 leading-relaxed text-ink-muted">
          Responde 4 preguntas de la encuesta y compara tus respuestas con el promedio de las
          personas encuestadas.
        </p>
        <p class="mt-4 text-sm text-ink-muted">Toma 2 minutos. Tus respuestas no se guardan.</p>
      </div>

      {/*
        PLACEHOLDER DEL QUIZ — Fase 4 lo reemplaza por la isla React:
          <Quiz client:visible {...quiz} />   (src/components/islands/Quiz.tsx, datos en src/data/quiz.ts)
        Paso 1: 4 preguntas, una por pantalla, barra de progreso y escala 0–10.
        Paso 2: posición del usuario frente al promedio de las personas encuestadas.
      */}
      <div
        class="grid gap-4 border border-dashed border-border-strong bg-surface p-4 sm:grid-cols-2 md:p-6"
        data-quiz-placeholder
      >
        <div class="flex flex-col gap-3">
          <p class="text-xs text-ink-muted">Paso 1 · Preguntas</p>
          <div class="flex gap-1" aria-hidden="true">
            <span class="h-1 flex-1 bg-ink"></span>
            <span class="h-1 flex-1 bg-ink"></span>
            <span class="h-1 flex-1 bg-surface-sunken"></span>
            <span class="h-1 flex-1 bg-surface-sunken"></span>
          </div>
          <Placeholder class="aspect-[4/3] w-full" label="Quiz: pregunta + escala 0–10" size="sm" />
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-xs text-ink-muted">Paso 2 · Resultado</p>
          <div class="h-1" aria-hidden="true"></div>
          <Placeholder
            class="aspect-[4/3] w-full"
            label="Tu resultado frente al promedio de las personas encuestadas"
            size="sm"
          />
        </div>
        <p class="text-sm text-ink-muted sm:col-span-2">
          El cuestionario interactivo estará disponible próximamente.
        </p>
      </div>
    </div>
  </section>

  <!-- Cifras -->
  <section aria-labelledby="cifras-titulo" class="border-b border-border">
    <div class="container-page py-10">
      <h2 id="cifras-titulo" class="sr-only">
        La encuesta en cifras
      </h2>
      <StatsRow />
    </div>
  </section>

  <!-- PROPUESTA: Datos que sorprenden (no está en la maqueta; PLAN.md §4.1) -->
  <section aria-labelledby="sorpresas-titulo" class="border-b border-border">
    <div class="container-page py-12">
      <div class="flex flex-wrap items-baseline gap-3">
        <h2 id="sorpresas-titulo" class="text-2xl font-bold md:text-3xl">
          Datos que sorprenden
        </h2>
        <span class="border border-dashed border-border-strong px-2 py-0.5 text-xs text-ink-muted">
          Propuesta
        </span>
      </div>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {sorpresas.map((s) => (
          <li class="flex flex-col border border-border bg-surface-muted p-5">
            <p class="text-5xl font-bold tracking-tight">{s.valor}</p>
            <p class="mt-3 flex-1 text-ink-muted">{s.frase}</p>
            <a
              href={temaHref(s.tema.slug)}
              class="mt-4 text-sm font-semibold underline underline-offset-4"
            >
              Ver {s.tema.titulo}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Temas -->
  <section aria-labelledby="temas-titulo" class="bg-surface-muted">
    <div class="container-page py-12 md:py-16">
      <h2 id="temas-titulo" class="text-3xl font-bold">
        Explora los temas principales
      </h2>
      <p class="mt-2 text-ink-muted">
        Seis conversaciones clave para entender la percepción política.
      </p>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {temas.map((t) => (
          <li>
            <TopicCard titulo={t.titulo} pregunta={t.pregunta} href={temaHref(t.slug)} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
