---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import imagenInicio from '../assets/Inicio.png';
import ExploraTemas from '../components/ui/ExploraTemas.astro';
import EscenaQuiz from '../components/ui/EscenaQuiz.astro';
import { cifrasEncuesta, sitio } from '../data/sitio';
import { getTemaByDataKey, temaHref } from '../data/temas';
import { getDestacados, getIndicador, getStats, tarjetaIndicador } from '../lib/tablero';
import { resumenTarjeta, titularTarjeta } from '../lib/textos';
import { entero, titulo } from '../lib/format';

// Hero: "Pulso" en azul 281 y "Democrático" en Grana 187C.
const [nombre1, ...resto] = sitio.nombre.split(' ');
const nombre2 = resto.join(' ');
const cifras = cifrasEncuesta(getStats(), entero);

// PROPUESTA (PLAN.md §4.1): "Datos que sorprenden" = 3 indicadores `destacado: true`.
// Selección editorial (temas distintos, cifras fáciles de leer); si alguno deja de ser
// destacado en el JSON, se completa con los primeros destacados.
const SORPRESAS = ['desinf_frec', 'outdislike', 'rs_tk'];
const elegidos = [
  ...SORPRESAS.map((k) => getIndicador(k)).filter((i) => i?.destacado),
  ...getDestacados(),
]
  .filter((i, k, xs) => i && xs.findIndex((x) => x?.key === i.key) === k)
  .slice(0, 3);
const sorpresas = elegidos.map((ind) => {
  const t = tarjetaIndicador(ind!);
  const tema = getTemaByDataKey(t.tema)!;
  return { titular: titularTarjeta(t), frase: resumenTarjeta(t), tema };
});
---

<BaseLayout title={sitio.nombre}>
  <!-- Hero -->
  <section aria-labelledby="titulo-principal" class="overflow-x-clip border-b border-border">
    <div class="container-page grid items-center gap-8 py-10 md:py-14 lg:grid-cols-[1fr_1.15fr] lg:gap-6 lg:py-12">
      <div>
        <h1
          id="titulo-principal"
          class="font-display text-[3.25rem] leading-[0.95] font-extrabold tracking-tight sm:text-6xl lg:text-7xl"
        >
          <span class="block text-brand">{nombre1}</span>
          <span class="block text-grana">{nombre2}</span>
        </h1>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-ink">{sitio.descripcion}</p>

        <!-- Cifras -->
        <h2 id="cifras-titulo" class="sr-only">
          La encuesta en cifras
        </h2>
        <ul
          aria-labelledby="cifras-titulo"
          class="mt-8 grid max-w-md grid-cols-2 overflow-hidden rounded-xl bg-brand text-white shadow-lg shadow-brand/20 sm:grid-cols-4"
        >
          {cifras.map((c, k) => (
            <li
              class:list={[
                'flex flex-col items-center gap-1 px-3 py-5 text-center',
                k % 2 === 1 && 'border-l border-white/15',
                k >= 2 && 'border-t border-white/15 sm:border-t-0',
                k === 2 && 'sm:border-l',
              ]}
            >
              <span class="flex items-center gap-2">
                {c.icon && <Icon name={c.icon} class="h-5 w-5 text-gold" aria-hidden="true" />}
                <span class="text-2xl font-bold tabular-nums">{c.value}</span>
              </span>
              <span class="text-xs leading-snug text-surface-sunken">{c.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Ilustración del hero: en escritorio se sale del contenedor hacia la derecha. -->
      <Image
        src={imagenInicio}
        alt="Collage sobre el mapa de Colombia: la bandera, una mujer joven, un campesino con sombrero, la estatua de Bolívar y el Capitolio."
        widths={[480, 720, 960, 1080]}
        sizes="(min-width: 1024px) 640px, (min-width: 640px) 28rem, 90vw"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full max-lg:max-w-md max-lg:justify-self-center lg:-mr-8 lg:w-[calc(100%+2rem)] xl:-mr-20 xl:w-[calc(100%+5rem)] xl:max-w-none"
      />
    </div>
  </section>

  <!-- Quiz -->
  <EscenaQuiz />

  <!-- PROPUESTA: Datos que sorprenden (no está en la maqueta; PLAN.md §4.1) -->
  <section aria-labelledby="sorpresas-titulo" class="border-b border-border">
    <div class="container-page py-12">
      <div class="flex flex-wrap items-baseline gap-3">
        <h2 id="sorpresas-titulo" class="text-2xl font-bold text-brand md:text-3xl">
          {titulo('Datos que sorprenden')}
        </h2>
        <span class="border border-dashed border-border-strong px-2 py-0.5 text-xs text-ink-muted">
          Propuesta
        </span>
      </div>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {sorpresas.map((s) => (
          <li class="flex flex-col border-t-4 border-accent bg-surface-highlight p-5">
            <p class="flex flex-wrap items-baseline gap-x-2 leading-none">
              <span class="text-5xl font-bold tracking-tight text-brand tabular-nums">
                {s.titular.valor}
              </span>
              {s.titular.sufijo && (
                <span class="text-lg font-semibold text-ink-muted">{s.titular.sufijo}</span>
              )}
            </p>
            <p class="mt-3 flex-1 leading-relaxed text-ink">{s.frase}</p>
            <a
              href={temaHref(s.tema.slug)}
              class="mt-4 text-sm font-semibold text-accent underline underline-offset-4"
            >
              Ver {s.tema.titulo}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Temas -->
  <ExploraTemas />
</BaseLayout>
