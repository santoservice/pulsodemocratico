---
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import TopicTabs from '../../components/ui/TopicTabs.astro';
import StatsRow from '../../components/ui/StatsRow.astro';
import QuestionModal from '../../components/results/QuestionModal.astro';
import TarjetaVisor from '../../components/visor/TarjetaVisor.astro';
import DetalleVisor from '../../components/visor/DetalleVisor.astro';
import { temas, temaHref, type Tema } from '../../data/temas';
import { breadcrumbJsonLd } from '../../lib/seo';
import { ruta } from '../../lib/rutas';
import { entero, titulo } from '../../lib/format';
import { meta } from '../../lib/visor/comun';
import { hallazgosTema } from '../../lib/visor/temas';

export const getStaticPaths = (() =>
  temas.map((tema) => ({ params: { tema: tema.slug }, props: { tema } }))) satisfies GetStaticPaths;

interface Props {
  tema: Tema;
}

const { tema } = Astro.props;
const breadcrumb = breadcrumbJsonLd(
  [
    { name: 'Inicio', path: '/' },
    { name: 'Resultados', path: '/resultados' },
    { name: tema.titulo, path: temaHref(tema.slug) },
  ],
  Astro.site,
);

// Hallazgos del visor de los investigadores: el principal del tema y luego los del tema.
const hallazgos = hallazgosTema(tema.slug);
---

<BaseLayout title={tema.titulo} description={tema.descripcion} jsonLd={breadcrumb}>
  <div class="container-page py-10 md:py-14">
    <nav aria-label="Ruta de navegación" class="mb-6 text-sm text-ink-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href={ruta('/resultados')} class="underline-offset-4 hover:underline">
            Resultados
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <span aria-current="page" class="text-ink">
            {tema.titulo}
          </span>
        </li>
      </ol>
    </nav>

    <SectionHeader title={tema.titulo} lead={tema.intro} />

    <div class="mt-8">
      <TopicTabs active={tema.slug} />
    </div>

    <section aria-labelledby="cifras-titulo" class="mt-8">
      <h2 id="cifras-titulo" class="sr-only">
        La encuesta en cifras
      </h2>
      <StatsRow variant="boxed" />
    </section>

    <section aria-labelledby="hallazgos-titulo" class="mt-12">
      <h2 id="hallazgos-titulo" class="text-2xl font-bold text-brand md:text-3xl">
        {titulo(`Hallazgos sobre ${tema.titulo}`)}
      </h2>
      <p class="mt-2 max-w-3xl text-ink-muted">
        Cada tarjeta responde una pregunta con una gráfica. En «Ver detalle» están los datos, cómo
        se midió y las descargas.
      </p>
      {tema.nota && <p class="mt-2 max-w-3xl font-semibold text-ink">{tema.nota}</p>}

      <details class="mt-4 max-w-3xl rounded-xl border border-border bg-surface-muted p-4 text-sm">
        <summary class="flex items-center gap-2 font-semibold">
          <Icon name="lucide:info" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Cómo leer estos datos
        </summary>
        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-ink-muted">
          <li>
            La muestra no es probabilística: los resultados describen a las personas encuestadas, no
            a toda la población. Los datos no están ponderados.
          </li>
          <li>
            Las mismas personas respondieron en tres rondas, entre mayo y julio de 2026 ({entero(meta.n_total)}
            en la 1.ª ronda). Cuando una gráfica compara rondas, usa solo a quienes respondieron en
            todas ellas.
          </li>
          <li>
            «▲ sube» o «▼ baja» indican un cambio estadísticamente significativo; «= se mantiene», un
            cambio que no lo es.
          </li>
          <li>Pasa el mouse (o el foco del teclado) sobre una gráfica para ver el dato exacto.</li>
        </ul>
        <a
          href={ruta('/como-se-hizo')}
          class="mt-3 inline-block font-semibold underline underline-offset-4"
        >
          ¿Cómo se hizo la encuesta?
        </a>
      </details>

      <ul aria-labelledby="hallazgos-titulo" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {hallazgos.map((h) => (
          <li class="min-w-0">
            <TarjetaVisor hallazgo={h} />
          </li>
        ))}
      </ul>
    </section>
  </div>
  <QuestionModal>
    {hallazgos.map((h) => <DetalleVisor hallazgo={h} />)}
  </QuestionModal>
</BaseLayout>
