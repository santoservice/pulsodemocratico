---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import HallazgosMosaico from '../../components/results/HallazgosMosaico.astro';
import { temas, temaHref } from '../../data/temas';
import { getIndicadores } from '../../lib/tablero';
import { datasetJsonLd } from '../../lib/seo';
import { titulo } from '../../lib/format';

const lead =
  'Explora los hallazgos sobre las percepciones, opiniones y actitudes de los colombianos durante la campaña presidencial de 2026.';

// Primero los datos más llamativos de todos los temas; al bajar, la entrada a cada tema.
const dataset = datasetJsonLd(
  { variables: getIndicadores().map((i) => i.titulo), path: '/resultados' },
  Astro.site,
);
---

<BaseLayout
  title={titulo('Resultados de la encuesta')}
  description="Principales hallazgos de la encuesta panel CNEP Colombia 2026: polarización, populismo, desinformación, inteligencia artificial, consumo mediático y jóvenes."
  jsonLd={dataset}
>
  <div class="container-page py-10 md:py-14">
    <SectionHeader title="Resultados de la encuesta" lead={lead} />

    <section aria-labelledby="hallazgos-titulo" class="mt-10">
      <h2 id="hallazgos-titulo" class="text-2xl font-bold text-brand md:text-3xl">
        {titulo('Principales hallazgos')}
      </h2>
      <p class="mt-2 text-ink-muted">Los datos que más llaman la atención, de todos los temas.</p>
      <div class="mt-6">
        <HallazgosMosaico />
      </div>
    </section>

    <section aria-labelledby="temas-titulo" class="mt-16">
      <h2 id="temas-titulo" class="text-2xl font-bold text-brand md:text-3xl">
        {titulo('Resultados por tema')}
      </h2>
      <p class="mt-2 text-ink-muted">Entra a cada tema para ver todas sus preguntas.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {temas.map((t) => (
          <li>
            <a
              href={temaHref(t.slug)}
              class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-5 transition-colors hover:border-accent hover:bg-surface-muted md:p-6"
            >
              <span
                class="flex h-11 w-11 items-center justify-center rounded-xl bg-surface-sunken text-accent"
                aria-hidden="true"
              >
                <Icon name={t.icono} class="h-6 w-6" />
              </span>
              <span class="mt-4 text-lg font-bold text-brand">{titulo(t.titulo)}</span>
              <span class="mt-1 flex-1 leading-snug text-ink-muted">{t.pregunta}</span>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-ink">
                Ver resultados
                <Icon
                  name="lucide:arrow-right"
                  class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
