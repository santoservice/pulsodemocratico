---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import QuestionModal from '../../components/results/QuestionModal.astro';
import TarjetaVisor from '../../components/visor/TarjetaVisor.astro';
import DetalleVisor from '../../components/visor/DetalleVisor.astro';
import ResultadosTemas from '../../components/results/ResultadosTemas.astro';
import { principales } from '../../lib/visor/principales';
import { otrosHallazgosTema } from '../../lib/visor/temas';
import { temas } from '../../data/temas';
import { getIndicadores } from '../../lib/tablero';
import { datasetJsonLd } from '../../lib/seo';
import { entero, titulo } from '../../lib/format';
import { meta } from '../../lib/visor/comun';

// Textos del documento de especificaciones del cliente.
const lead = 'Una mirada global a los resultados de la encuesta.';

const comoLeer = [
  'La muestra no es probabilística: los resultados describen a las personas encuestadas, no a toda la población. Los datos no están ponderados.',
  `Las mismas personas respondieron en tres rondas, entre mayo y julio de 2026 (${entero(meta.n_total)} en la 1.ª ronda). Cuando una gráfica compara rondas, usa solo a quienes respondieron en todas ellas.`,
  '«▲ sube» o «▼ baja» indican un cambio estadísticamente significativo; «= se mantiene», un cambio que no lo es.',
  'Pasa el mouse (o el foco del teclado) sobre una gráfica para ver el dato exacto.',
];

// Orden y lugar de cada hallazgo en el mosaico de escritorio (como la maqueta).
const ordenMosaico = [
  'comportamiento-juvenil',
  'polarizacion',
  'desinformacion',
  'populismo',
  'inteligencia-artificial',
  'consumo-mediatico',
];
const mosaico = ordenMosaico.map((t) => principales.find((h) => h.tema === t)!);
const lugar: Record<string, string> = {
  'comportamiento-juvenil': 'lg:row-span-2',
  'consumo-mediatico': 'lg:col-span-2',
};

// Primero el hallazgo principal de cada tema; al bajar, los demás hallazgos tema por tema.
const dataset = datasetJsonLd(
  { variables: getIndicadores().map((i) => i.titulo), path: '/resultados' },
  Astro.site,
);
---

<BaseLayout
  title={titulo('Resultados de la encuesta')}
  description="Principales hallazgos de la encuesta panel CNEP Colombia 2026: polarización, populismo, desinformación, inteligencia artificial, consumo mediático y comportamiento juvenil."
  jsonLd={dataset}
>
  <div class="container-page pt-2 pb-10 md:pt-4 md:pb-14">
    <section aria-labelledby="hallazgos-titulo">
      <!-- Encabezado centrado como la maqueta; «Cómo leer estos datos» despliega una tarjeta con la lista debajo. -->
      <div class="mx-auto max-w-3xl text-center">
        <h1
          id="hallazgos-titulo"
          class="font-display text-4xl leading-tight font-bold tracking-tight text-brand sm:text-5xl md:text-6xl"
        >
          {titulo('Principales hallazgos')}
        </h1>
        <p class="mt-1 text-ink-muted md:text-lg">
          {lead}{' '}
          <button
            type="button"
            id="como-leer-boton"
            aria-expanded="false"
            aria-controls="como-leer"
            class="ml-1 inline-flex items-center gap-1.5 align-middle text-sm font-semibold text-ink underline-offset-4 transition-colors hover:text-cream hover:underline"
          >
            <Icon name="lucide:circle-help" class="h-4 w-4 shrink-0" aria-hidden="true" />
            Cómo leer estos datos
            <Icon name="lucide:chevron-down" class="flecha h-4 w-4 shrink-0 transition-transform" aria-hidden="true" />
          </button>
        </p>
      </div>
      <div id="como-leer" class="como-leer grid" hidden>
        <div class="min-h-0 overflow-hidden">
          <!-- Misma tarjeta que los hallazgos (TarjetaVisor). -->
          <div class="mt-6 rounded-2xl border border-border bg-surface p-5 md:p-6 dark:border-transparent dark:bg-tarjeta-visor">
            <ul class="list-disc space-y-2 pl-5 text-sm leading-relaxed text-ink marker:text-ink-muted md:text-base">
              {comoLeer.map((texto) => <li>{texto}</li>)}
            </ul>
          </div>
        </div>
      </div>
      <!-- Hallazgos del visor (src/lib/visor/principales.ts). En escritorio caben en una pantalla,
           como la maqueta: Jóvenes ocupa dos filas a la izquierda y Consumo dos columnas abajo. -->
      <ul aria-labelledby="hallazgos-titulo" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {mosaico.map((h) => (
          <li class:list={['min-w-0', lugar[h.tema]]}>
            <TarjetaVisor hallazgo={h} as="h2" compacta ancha={h.tema === 'consumo-mediatico'} />
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="temas-titulo" class="mt-20 md:mt-28">
      <SectionHeader
        as="h2"
        grande
        id="temas-titulo"
        eyebrow="Colombia 2026"
        title="Resultados de la encuesta"
        class="mx-auto text-center"
      >
        <p class="mt-4 text-lg leading-relaxed text-ink-muted">
          Aquí presentamos, por temática,{' '}
          <strong class="font-semibold text-ink">los resultados más relevantes</strong> sobre las
          percepciones, opiniones y actitudes de los colombianos durante la campaña presidencial de
          2026.
        </p>
        <span class="mx-auto mt-6 block h-1 w-24 rounded-full bg-cream" aria-hidden="true"></span>
      </SectionHeader>
      <ResultadosTemas />
    </section>
  </div>
  <QuestionModal>
    {[...principales, ...temas.flatMap((t) => otrosHallazgosTema(t.slug))].map((h) => (
      <DetalleVisor hallazgo={h} />
    ))}
  </QuestionModal>
</BaseLayout>

<style>
  /* Se abre desde alto 0 (sale "de la nada"). */
  .como-leer {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .como-leer[data-abierto] {
    grid-template-rows: 1fr;
  }
  :global(#como-leer-boton[aria-expanded='true'] .flecha) {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .como-leer {
      transition: none;
    }
  }
</style>

<script>
  const boton = document.getElementById('como-leer-boton');
  const panel = document.getElementById('como-leer');
  boton?.addEventListener('click', () => {
    if (!panel) return;
    const abrir = boton.getAttribute('aria-expanded') !== 'true';
    boton.setAttribute('aria-expanded', String(abrir));
    if (abrir) {
      panel.hidden = false;
      void panel.offsetHeight; // fija el alto 0 antes de animar
      panel.setAttribute('data-abierto', '');
    } else {
      panel.removeAttribute('data-abierto');
      // Se oculta al terminar la animación (300 ms), si nadie lo volvió a abrir.
      setTimeout(() => {
        if (boton.getAttribute('aria-expanded') !== 'true') panel.hidden = true;
      }, 300);
    }
  });
</script>
