---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import QuestionModal from '../../components/results/QuestionModal.astro';
import TarjetaVisor from '../../components/visor/TarjetaVisor.astro';
import DetalleVisor from '../../components/visor/DetalleVisor.astro';
import ResultadosTemas from '../../components/results/ResultadosTemas.astro';
import Aparecer from '../../components/ui/Aparecer.astro';
import { principales } from '../../lib/visor/principales';
import { otrosHallazgosTema } from '../../lib/visor/temas';
import { temas } from '../../data/temas';
import { getIndicadores } from '../../lib/tablero';
import { datasetJsonLd } from '../../lib/seo';
import { titulo } from '../../lib/format';

// Textos del documento de especificaciones del cliente.
const lead = 'Una mirada global a los resultados de la encuesta.';

// Orden de los hallazgos en la cuadrícula (como la maqueta).
const ordenMosaico = [
  'comportamiento-juvenil',
  'polarizacion',
  'desinformacion',
  'populismo',
  'inteligencia-artificial',
  'consumo-mediatico',
];
const mosaico = ordenMosaico.map((t) => principales.find((h) => h.tema === t)!);
// Lugar en el mosaico de escritorio (4 columnas): Jóvenes ocupa dos filas; Consumo, dos columnas.
const lugar: Record<string, string> = {
  'comportamiento-juvenil': 'lg:row-span-2',
  'consumo-mediatico': 'lg:col-span-2',
};
// Gráficas más altas, un poco más chicas en el mosaico para que todo quepa en una pantalla.
const zoom: Record<string, string> = {
  'inteligencia-artificial': 'lg:[&>div[id]]:[zoom:0.75]',
};
// Jóvenes (columna más ancha, dos filas) se dibuja al ancho de su tarjeta (anchoLg 376 px: 1280 de
// mosaico → 376 de tarjeta − 56 de relleno ÷ zoom 0,85). Además llena el alto de su tarjeta
// (desde lg): la gráfica crece y su lista de filas reparte el espacio sobrante entre ellas.
const llenar = [
  'lg:[&>div[id]_.grafica-visor]:flex',
  'lg:[&>div[id]_.grafica-visor]:flex-1',
  'lg:[&>div[id]_.grafica-visor]:flex-col',
  'lg:[&>div[id]_.grafica-visor>[role=img]]:flex-1',
  'lg:[&>div[id]_.grafica-visor>[role=img]]:justify-between',
].join(' ');
// Columnas y figuras: versión baja dibujada al ancho de la tarjeta desde lg (≈233 px de tarjeta a
// 1440 ÷ zoom 0,85 del mosaico ≈ 274), para que no queden cuadradas y el texto se lea mejor.
const bajas = ['polarizacion', 'desinformacion', 'populismo'];
// Al abrir la página las tarjetas del mosaico llegan de distintos lados, giradas y borrosas, y se
// acomodan (Aparecer, como los logos de «Una iniciativa de»): desplazamiento y giro de cada una.
const desde: Record<string, string> = {
  'comportamiento-juvenil': '--ox:-180px;--oy:60px;--or:-5deg',
  polarizacion: '--ox:-60px;--oy:-140px;--or:4deg',
  desinformacion: '--ox:40px;--oy:-160px;--or:-3deg',
  populismo: '--ox:180px;--oy:-40px;--or:6deg',
  'inteligencia-artificial': '--ox:-40px;--oy:160px;--or:-4deg',
  'consumo-mediatico': '--ox:160px;--oy:120px;--or:3deg',
};

// Primero el hallazgo principal de cada tema; al bajar, los demás hallazgos tema por tema.
const dataset = datasetJsonLd(
  { variables: getIndicadores().map((i) => i.titulo), path: '/resultados' },
  Astro.site,
);
---

<BaseLayout
  title={titulo('Resultados de la encuesta')}
  description="Principales hallazgos de la encuesta panel CNEP Colombia 2026: polarización, populismo, desinformación, inteligencia artificial, consumo mediático y comportamiento juvenil."
  jsonLd={dataset}
>
  <div class="container-page pt-2 pb-10 md:px-0! md:pt-4 md:pb-14">
    <section aria-labelledby="hallazgos-titulo">
      <!-- Encabezado centrado como la maqueta. -->
      <div class="mx-auto max-w-3xl text-center">
        <h1
          id="hallazgos-titulo"
          class="font-display text-3xl leading-tight font-bold tracking-tight text-brand sm:text-4xl md:text-5xl"
        >
          {titulo('Principales hallazgos')}
        </h1>
        <p class="mt-1 text-[20px] font-medium text-white">{lead}</p>
      </div>
      <!-- Más ancho que el contenedor en escritorio (hasta 80rem, 2rem de margen a cada lado). -->
      <div class="lg:mx-[calc(50%-min(40rem,50vw-2rem))]">
      <!--
        Hallazgos del visor (src/lib/visor/principales.ts). En escritorio, mosaico de la maqueta en
        una sola pantalla: 4 columnas (Jóvenes, en dos filas, más ancha) y Consumo en dos columnas;
        las gráficas se encogen a la tarjeta y la tarjeta entera abre el detalle. Baja a 2 y 1 columnas.
      -->
      <ul
        aria-labelledby="hallazgos-titulo"
        class="aparece-hijos mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]"
      >
        {mosaico.map((h) => (
          <li class:list={['min-w-0', lugar[h.tema]]} data-disperso style={desde[h.tema]}>
            {/* Consumo (dos columnas): líneas apaisadas dibujadas a su ancho desde lg (≈535 px de
                tarjeta a 1280 ÷ zoom 0,85 del mosaico ≈ 629), sin el alto máximo del mosaico. */}
            {h.tema === 'consumo-mediatico' ? (
              <TarjetaVisor
                hallazgo={h}
                as="h2"
                compacta
                apaisada
                anchoLg={629}
                class="lg:[&>div[id]_svg[role=img]]:max-h-none"
              />
            ) : bajas.includes(h.tema) ? (
              <TarjetaVisor
                hallazgo={h}
                as="h2"
                compacta
                apaisada
                anchoLg={274}
                class="lg:[&>div[id]_svg[role=img]]:max-h-none"
              />
            ) : h.tema === 'comportamiento-juvenil' ? (
              <TarjetaVisor hallazgo={h} as="h2" compacta anchoLg={376} class={llenar} />
            ) : (
              <TarjetaVisor hallazgo={h} as="h2" compacta class={zoom[h.tema]} />
            )}
          </li>
        ))}
      </ul>
      </div>
    </section>

    <section aria-labelledby="temas-titulo" class="mt-20 md:mt-28">
      <!--
        Intro (escritorio), como «Explora los temas» del inicio: el título queda solo y fijo en el
        centro de la pantalla, entra grande y borroso, se aclara rápido y se achica más despacio;
        mientras, las pestañas de temas suben hasta pegarse a él y siguen hasta quedar bajo el header.
      -->
      <div class="intro-temas" data-intro-temas>
      <div class="intro-temas-titulo" data-intro-titulo>
      <SectionHeader
        as="h2"
        grande
        id="temas-titulo"
        eyebrow="Colombia 2026"
        title={'Resultados\nde la encuesta'}
        class="mx-auto max-w-5xl! text-left md:text-center"
      >
        <p class="mt-4 text-base leading-relaxed font-medium text-white md:text-[20px]">
          Aquí presentamos, por temática,{' '}
          <strong class="font-semibold text-white">los resultados más relevantes</strong> sobre las
          percepciones, opiniones y actitudes de los colombianos durante la campaña presidencial de
          2026.
        </p>
        <span class="mt-6 block h-1 w-24 rounded-full bg-cream max-md:mx-0 md:mx-auto" aria-hidden="true"></span>
      </SectionHeader>
      </div>
      </div>
      <ResultadosTemas />
    </section>
  </div>
  <QuestionModal>
    {[...principales, ...temas.flatMap((t) => otrosHallazgosTema(t.slug))].map((h) => (
      <DetalleVisor hallazgo={h} />
    ))}
  </QuestionModal>
  <Aparecer />
</BaseLayout>

<style>
  /*
   * Intro: --b = borroso (1 → 0), --e = escala extra (0,5 → 0), --top = top fijo que centra el
   * título en la pantalla. Arriba, aire para que no se vea la cuadrícula anterior; abajo, el
   * recorrido en que el título queda fijo (las pestañas suben hasta pegarse a él).
   */
  .intro-temas[data-activa] {
    padding-top: 35vh;
  }
  /* Como contenido (no padding) para que el sticky lo recorra. */
  .intro-temas[data-activa]::after {
    content: '';
    display: block;
    height: 100vh;
  }
  .intro-temas[data-activa] .intro-temas-titulo {
    position: sticky;
    top: var(--top, 30vh);
    scale: calc(1 + var(--e, 0));
    filter: blur(calc(var(--b, 0) * 12px));
    opacity: calc(1 - 0.85 * var(--b, 0));
    will-change: scale, filter;
  }
</style>

<script>
  // ---- Intro de «Resultados de la encuesta» (escritorio, sin movimiento reducido) ----
  {
    const ESCALA_EXTRA = 0.5;
    const HEADER = 69;
    const intro = document.querySelector<HTMLElement>('[data-intro-temas]');
    const bloque = intro?.querySelector<HTMLElement>('[data-intro-titulo]');
    const escritorio = window.matchMedia('(min-width: 64rem)');
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (intro && bloque) {
      const clamp = (v: number) => Math.min(1, Math.max(0, v));
      const suave = (v: number) => v * v * (3 - 2 * v);
      let fijo = 0; // top fijo del título (centrado bajo el header)
      let pendiente = false;

      const medir = () => {
        fijo = Math.round((HEADER + window.innerHeight - bloque.offsetHeight) / 2);
        intro.style.setProperty('--top', `${fijo}px`);
      };

      const pintar = () => {
        pendiente = false;
        const vh = window.innerHeight;
        const cs = getComputedStyle(intro);
        const r = intro.getBoundingClientRect();
        // Top del título si no estuviera fijo (sin escala) y recorrido fijo (alto del ::after).
        const n = r.top + parseFloat(cs.paddingTop);
        const recorrido = parseFloat(getComputedStyle(intro, '::after').height) || 0;
        const entrada = vh * 0.95 - fijo; // desde que asoma abajo hasta que se fija
        const avance = vh * 0.95 - n; // 0 al asomar · entrada al fijarse · + recorrido al soltarse
        // Desenfoque: se va del todo justo al llegar al centro de la pantalla.
        const b = 1 - clamp(avance / entrada);
        // Tamaño: lento, llega a su tamaño justo cuando las pestañas se le pegan.
        const e = ESCALA_EXTRA * (1 - suave(clamp(avance / (entrada + recorrido))));
        intro.style.setProperty('--b', String(b));
        intro.style.setProperty('--e', String(e));
      };
      const programar = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(pintar);
      };

      let activa = false;
      const configurar = () => {
        const debe = escritorio.matches && !reducido.matches;
        if (debe !== activa) {
          activa = debe;
          intro.toggleAttribute('data-activa', activa);
          if (activa) window.addEventListener('scroll', programar, { passive: true });
          else window.removeEventListener('scroll', programar);
        }
        if (!activa) {
          for (const k of ['--b', '--e', '--top']) intro.style.removeProperty(k);
          return;
        }
        medir();
        pintar();
      };
      configurar();
      window.addEventListener('resize', configurar);
      reducido.addEventListener('change', configurar);
    }
  }
</script>
