---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import QuestionModal from '../../components/results/QuestionModal.astro';
import TarjetaVisor from '../../components/visor/TarjetaVisor.astro';
import DetalleVisor from '../../components/visor/DetalleVisor.astro';
import ResultadosTemas from '../../components/results/ResultadosTemas.astro';
import { principales } from '../../lib/visor/principales';
import { otrosHallazgosTema } from '../../lib/visor/temas';
import { temas } from '../../data/temas';
import { getIndicadores } from '../../lib/tablero';
import { datasetJsonLd } from '../../lib/seo';
import { entero, titulo } from '../../lib/format';
import { meta } from '../../lib/visor/comun';
import { ruta } from '../../lib/rutas';

// Textos del documento de especificaciones del cliente.
const lead = 'Una mirada global a los resultados de la encuesta.';

// Primero el hallazgo principal de cada tema; al bajar, los demás hallazgos tema por tema.
const dataset = datasetJsonLd(
  { variables: getIndicadores().map((i) => i.titulo), path: '/resultados' },
  Astro.site,
);
---

<BaseLayout
  title={titulo('Resultados de la encuesta')}
  description="Principales hallazgos de la encuesta panel CNEP Colombia 2026: polarización, populismo, desinformación, inteligencia artificial, consumo mediático y comportamiento juvenil."
  jsonLd={dataset}
>
  <div class="container-page py-10 md:py-14">
    <section aria-labelledby="hallazgos-titulo">
      <SectionHeader
        id="hallazgos-titulo"
        title="Principales hallazgos"
        lead={lead}
      />
      <details class="mt-6 max-w-3xl rounded-xl border border-border bg-surface-muted p-4 text-sm">
        <summary class="flex items-center gap-2 font-semibold">
          <Icon name="lucide:info" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Cómo leer estos datos
        </summary>
        <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-ink-muted">
          <li>
            La muestra no es probabilística: los resultados describen a las personas encuestadas, no
            a toda la población. Los datos no están ponderados.
          </li>
          <li>
            Las mismas personas respondieron en tres rondas, entre mayo y julio de 2026 ({entero(meta.n_total)}
            en la 1.ª ronda). Cuando una gráfica compara rondas, usa solo a quienes respondieron en
            todas ellas.
          </li>
          <li>
            «▲ sube» o «▼ baja» indican un cambio estadísticamente significativo; «= se mantiene», un
            cambio que no lo es.
          </li>
          <li>Pasa el mouse (o el foco del teclado) sobre una gráfica para ver el dato exacto.</li>
        </ul>
        <a
          href={ruta('/como-se-hizo')}
          class="mt-3 inline-block font-semibold underline underline-offset-4"
        >
          ¿Cómo se hizo la encuesta?
        </a>
      </details>
      <!-- Hallazgos del visor de los investigadores (src/lib/visor/principales.ts). -->
      <ul aria-labelledby="hallazgos-titulo" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {principales.map((h) => (
          <li class="min-w-0">
            <TarjetaVisor hallazgo={h} as="h2" />
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="temas-titulo" class="mt-20 md:mt-28">
      <SectionHeader
        as="h2"
        grande
        id="temas-titulo"
        eyebrow="Colombia 2026"
        title="Resultados de la encuesta"
        class="mx-auto text-center"
      >
        <p class="mt-4 text-lg leading-relaxed text-ink-muted">
          Aquí presentamos, por temática,{' '}
          <strong class="font-semibold text-ink">los resultados más relevantes</strong> sobre las
          percepciones, opiniones y actitudes de los colombianos durante la campaña presidencial de
          2026.
        </p>
        <span class="mx-auto mt-6 block h-1 w-24 rounded-full bg-cream" aria-hidden="true"></span>
      </SectionHeader>
      <ResultadosTemas />
    </section>
  </div>
  <QuestionModal>
    {[...principales, ...temas.flatMap((t) => otrosHallazgosTema(t.slug))].map((h) => (
      <DetalleVisor hallazgo={h} />
    ))}
  </QuestionModal>
</BaseLayout>
