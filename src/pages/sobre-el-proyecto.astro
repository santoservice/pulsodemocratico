---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import { instituciones } from '../data/sitio';

// TODO (cliente): textos de "Sobre el proyecto" (bajada, ¿Qué es?, ¿Por qué es importante?)
// y equipo (nombre, rol, foto). Las barras grises son esqueletos de texto.
const razones = [
  { icono: 'lucide:users', label: 'Razón 1 (pendiente)' },
  { icono: 'lucide:chart-column', label: 'Razón 2 (pendiente)' },
];
const equipo = Array.from({ length: 7 }, (_, i) => ({ nombre: `Integrante ${i + 1}` }));
---

<BaseLayout
  title="Sobre el proyecto"
  description="Pulso Democrático presenta los resultados de la encuesta panel CNEP Colombia 2026, una iniciativa de universidades de Colombia, Estados Unidos y España."
>
  <div class="container-page py-10 md:py-14">
    <SectionHeader title="Sobre el proyecto">
      <div class="mt-5 space-y-3" aria-hidden="true">
        <span class="block h-4 w-full max-w-xl bg-surface-sunken"></span>
        <span class="block h-4 w-4/5 max-w-md bg-surface-sunken"></span>
      </div>
      <p class="sr-only">Texto de presentación pendiente.</p>
    </SectionHeader>

    <section aria-labelledby="que-es" class="mt-16 grid gap-8 md:grid-cols-2 md:gap-12">
      <div>
        <h2 id="que-es" class="text-2xl font-bold md:text-3xl">
          ¿Qué es?
        </h2>
        <div class="mt-6 space-y-3" aria-hidden="true">
          <span class="block h-4 w-full bg-surface-sunken"></span>
          <span class="block h-4 w-11/12 bg-surface-sunken"></span>
          <span class="block h-4 w-5/6 bg-surface-sunken"></span>
          <span class="block h-4 w-3/5 bg-surface-sunken"></span>
        </div>
        <p class="sr-only">Texto pendiente.</p>
      </div>
      <div class="md:border-l md:border-border-strong md:pl-12">
        <h3 class="text-xs font-medium tracking-[0.25em] text-ink-muted uppercase">
          Una iniciativa de
        </h3>
        <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {instituciones.map((i) => (
            <li class="flex flex-col gap-2">
              <Placeholder class="aspect-[6/5] w-full" />
              <span class="text-xs text-ink-muted">{i.nombre}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="importancia" class="mt-16">
      <h2 id="importancia" class="text-2xl font-bold md:text-3xl">
        ¿Por qué es importante?
      </h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-2">
        {razones.map((r) => (
          <li class="flex items-center gap-6 border border-border bg-surface-muted p-6 md:p-8">
            <span
              class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-surface-sunken"
              aria-hidden="true"
            >
              <Icon name={r.icono} class="h-9 w-9" />
            </span>
            <div class="flex-1 space-y-3">
              <span class="block h-4 w-3/5 bg-skeleton" aria-hidden="true" />
              <span class="block h-3 w-full bg-surface-sunken" aria-hidden="true" />
              <span class="block h-3 w-4/5 bg-surface-sunken" aria-hidden="true" />
              <span class="sr-only">{r.label}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="equipo" class="mt-16">
      <h2 id="equipo" class="text-2xl font-bold md:text-3xl">
        Equipo de trabajo
      </h2>
      <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {equipo.map((p) => (
          <li class="flex items-center gap-5 border border-border bg-surface-muted p-5">
            <span class="h-20 w-20 shrink-0 rounded-full bg-surface-sunken" aria-hidden="true" />
            <div class="flex-1 space-y-2.5">
              <span class="block h-4 w-4/5 bg-skeleton" aria-hidden="true" />
              <span class="block h-3 w-3/5 bg-surface-sunken" aria-hidden="true" />
              <span class="block h-3 w-2/5 bg-surface-sunken" aria-hidden="true" />
              <span class="sr-only">{p.nombre} (foto, nombre y rol pendientes)</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
